{
  "name": "temka-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @temka/fx dev",
    "dev:fx": "pnpm --filter @temka/fx dev",
    "build": "pnpm --filter @temka/fx build",
    "build:fx": "pnpm --filter @temka/fx build",
    "typecheck": "pnpm -r typecheck",
    "check:release": "pnpm --filter @temka/fx check:release"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
