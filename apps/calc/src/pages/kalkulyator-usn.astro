---
import BaseLayout from '../layouts/BaseLayout.astro';
import UnifiedCalculator from '../components/UnifiedCalculator';

const title = 'Калькулятор налога ИП на УСН «Доходы 6%» 2026: взносы и вычеты онлайн';
const description = 'Точный онлайн-калькулятор налога ИП на УСН «Доходы 6%» для России: расчёт фиксированных страховых взносов (53 658 ₽), 1% свыше 300 000 ₽ и законное уменьшение налога до 100%.';

const faqs = [
  {
    q: 'Как ИП на УСН 6% уменьшает налог на страховые взносы?',
    a: 'Согласно п. 3.1 ст. 346.21 НК РФ, индивидуальные предприниматели без наёмных работников вправе уменьшить исчисленный налог УСН на всю сумму подлежащих уплате страховых взносов за себя (фиксированные 53 658 ₽ + 1% с дохода свыше 300 000 ₽). Налог можно уменьшить вплоть до 0 рублей!',
  },
  {
    q: 'В чём разница для ИП с сотрудниками и без сотрудников?',
    a: 'ИП без сотрудников может уменьшить налог УСН на 100% уплаченных за себя взносов. ИП с сотрудниками может уменьшить налог максимум на 50%, но учитывает взносы как за себя, так и за работников.',
  },
  {
    q: 'Какой лимит дохода действует на УСН в 2026 году?',
    a: 'Базовый лимит доходов для применения УСН составляет 450 млн рублей с учётом коэффициента-дефлятора, а лимит остаточной стоимости основных средств — 200 млн рублей.',
  },
];

const schemaJson = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Калькулятор налога ИП на УСН «Доходы 6%»',
      description,
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'All',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'RUB' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: { '@type': 'Answer', text: faq.a },
      })),
    },
  ],
};
---

<BaseLayout title={title} description={description} schemaJson={schemaJson}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 md:py-12">
    <!-- Хлебные крошки -->
    <nav class="flex text-xs text-slate-500 mb-6 gap-2 print:hidden">
      <a href="/" class="hover:text-emerald-600 transition-colors">Главная</a>
      <span>/</span>
      <span class="text-slate-800 font-semibold">Калькулятор ИП на УСН</span>
    </nav>

    <!-- Заголовок страницы -->
    <div class="mb-8">
      <h1 class="text-3xl md:text-4xl font-black text-slate-900 tracking-tight">
        Калькулятор налога ИП на УСН «Доходы 6%» (2026)
      </h1>
      <p class="text-slate-600 mt-2 text-base md:text-lg">
        Рассчитайте сумму налога УСН, фиксированные взносы за себя, дополнительный взнос 1% свыше 300 000 ₽ и законный вычет, снижающий налог до нуля.
      </p>
    </div>

    <!-- Интерактивный калькулятор -->
    <div class="mb-14">
      <UnifiedCalculator client:load initialTab="usn" />
    </div>

    <!-- FAQ -->
    <section class="mb-12">
      <h2 class="text-xl md:text-2xl font-bold text-slate-900 mb-6">
        Частые вопросы о налогах ИП на УСН
      </h2>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group bg-white rounded-xl border border-slate-200/80 p-5 open:ring-2 open:ring-emerald-500/20 transition-all">
            <summary class="font-semibold text-slate-900 cursor-pointer list-none flex items-center justify-between">
              <span>{faq.q}</span>
              <span class="text-emerald-600 font-bold group-open:rotate-180 transition-transform">↓</span>
            </summary>
            <p class="mt-3 text-sm text-slate-600 leading-relaxed border-t border-slate-100 pt-3">
              {faq.a}
            </p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
