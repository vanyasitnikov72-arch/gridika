---
import BaseLayout from '../layouts/BaseLayout.astro';
import UnifiedCalculator from '../components/UnifiedCalculator';

const title = 'Калькулятор: Ипотека или аренда квартиры — что выгоднее в 2026 году?';
const description = 'Точный финансовый расчёт и сравнение: покупка жилья в ипотеку или аренда аналогичной квартиры с инвестированием первоначального взноса в депозит и активы.';

const faqs = [
  {
    q: 'Что выгоднее в долгосрочной перспективе: ипотека или аренда?',
    a: 'Результат зависит от трёх главных факторов: ставки по ипотеке, доходности альтернативных инвестиций (депозиты, облигации) и темпа роста цен на недвижимость. При высоких ставках по ипотеке (выше 18-20%) аренда с инвестированием первоначального взноса на депозитах часто даёт больший капитал, чем покупка в кредит. При льготных ставках (6%) или быстром росте цен на недвижимость покупка оказывается выгоднее.',
  },
  {
    q: 'Почему арендатор может оказаться богаче владельца ипотеки?',
    a: 'Потому что арендатор не отдаёт первоначальный взнос банку (например, 2-3 млн рублей) и ежемесячную разницу между ипотечным платежом и арендой. Эти средства, работая под сложный процент на банковских вкладах или фондовом рынке, могут приносить доход, превышающий рост стоимости квартиры.',
  },
  {
    q: 'Учитывает ли калькулятор инфляцию стоимости аренды и рост цен на жильё?',
    a: 'Да. Модель рассчитывает ежегодную индексацию арендной платы и ежегодный прирост рыночной стоимости квартиры на заданном горизонте расчёта (от 5 до 20 лет).',
  },
];

const schemaJson = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Калькулятор: Ипотека или аренда',
      description,
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'All',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'RUB' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: { '@type': 'Answer', text: faq.a },
      })),
    },
  ],
};
---

<BaseLayout title={title} description={description} schemaJson={schemaJson}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 md:py-12">
    <!-- Хлебные крошки -->
    <nav class="flex text-xs text-slate-500 mb-6 gap-2 print:hidden">
      <a href="/" class="hover:text-emerald-600 transition-colors">Главная</a>
      <span>/</span>
      <span class="text-slate-800 font-semibold">Ипотека или аренда</span>
    </nav>

    <!-- Заголовок страницы -->
    <div class="mb-8">
      <h1 class="text-3xl md:text-4xl font-black text-slate-900 tracking-tight">
        Калькулятор: Ипотека или аренда жилья
      </h1>
      <p class="text-slate-600 mt-2 text-base md:text-lg">
        Математическое сравнение двух жизненных сценариев на горизонте от 5 до 20 лет: покупка в собственность против аренды с капитализацией сбережений.
      </p>
    </div>

    <!-- Интерактивный калькулятор -->
    <div class="mb-14">
      <UnifiedCalculator client:load initialTab="mortgage" />
    </div>

    <!-- FAQ -->
    <section class="mb-12">
      <h2 class="text-xl md:text-2xl font-bold text-slate-900 mb-6">
        Частые вопросы о выборе между ипотекой и арендой
      </h2>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group bg-white rounded-xl border border-slate-200/80 p-5 open:ring-2 open:ring-amber-500/20 transition-all">
            <summary class="font-semibold text-slate-900 cursor-pointer list-none flex items-center justify-between">
              <span>{faq.q}</span>
              <span class="text-amber-600 font-bold group-open:rotate-180 transition-transform">↓</span>
            </summary>
            <p class="mt-3 text-sm text-slate-600 leading-relaxed border-t border-slate-100 pt-3">
              {faq.a}
            </p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
