---
import BaseLayout from '../layouts/BaseLayout.astro';
import SalaryCalculator from '../components/SalaryCalculator';

const title = 'Калькулятор зарплаты на руки 2026: прогрессивный НДФЛ, вычеты и оклад';
const description = 'Точный онлайн-калькулятор зарплаты на руки (Net) из оклада (Gross) и наоборот с учётом 5-ступенчатой шкалы НДФЛ 2025–2026 (13–22%, закон № 176-ФЗ), вычетов на детей и взносов.';

const faqs = [
  {
    q: 'Как работает новая 5-ступенчатая шкала НДФЛ с 2025–2026 года?',
    a: 'Федеральным законом № 176-ФЗ введены 5 ступеней НДФЛ: до 2,4 млн ₽ в год — 13%, от 2,4 до 5 млн ₽ — 15%, от 5 до 20 млн ₽ — 18%, от 20 до 50 млн ₽ — 20%, свыше 50 млн ₽ — 22%. Повышенная ставка применяется не ко всей сумме, а только к превышению соответствующего порога.',
  },
  {
    q: 'В чём разница между Gross (оклад) и Net (на руки)?',
    a: 'Gross — сумма, прописанная в трудовом договоре до удержания подоходного налога. Net — чистая сумма, перечисляемая на карту сотрудника после вычета НДФЛ. Работодатель выступает налоговым агентом и удерживает НДФЛ автоматически.',
  },
  {
    q: 'Какие действуют размеры вычетов на детей?',
    a: 'С 2025 года лимит совокупного дохода для детских вычетов увеличен с 350 000 ₽ до 450 000 ₽. Размеры вычетов: на 1-го ребёнка — 1 400 ₽, на 2-го — 2 800 ₽ (было 1 400 ₽), на 3-го и каждого последующего — 6 000 ₽ (было 3 000 ₽). Вычет на ребёнка-инвалида — 12 000 ₽.',
  },
  {
    q: 'Почему выплата на руки может уменьшиться к осени или зиме?',
    a: 'Если ваш ежемесячный оклад превышает 200 000 ₽, то в течение года сумма дохода накопительным итогом превысит 2,4 млн ₽. Начиная с месяца превышения, сумма сверх порога начинает облагаться по ставке 15% вместо 13%, поэтому чистая выплата на руки в эти месяцы уменьшается.',
  },
  {
    q: 'Сколько страховых взносов платит работодатель сверх оклада?',
    a: 'Стандартный тариф взносов в Социальный фонд РФ (ОПС, ОМС, ВНиМ) составляет 30% до предельной базы и 15,1% сверх неё, плюс от 0,2% от несчастных случаев на производстве. Для субъектов малого и среднего предпринимательства (МСП) действует льгота: 15% с суммы, превышающей МРОТ.',
  },
];

const schemaJson = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Калькулятор зарплаты на руки и НДФЛ 2026',
      description,
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'All',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'RUB',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Главная',
          item: 'https://calc.temka.local/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Зарплата на руки (НДФЛ)',
          item: 'https://calc.temka.local/zarplata-na-ruki',
        },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.a,
        },
      })),
    },
  ],
};
---

<BaseLayout title={title} description={description} schemaJson={schemaJson}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 md:py-12">
    <!-- Хлебные крошки -->
    <nav class="flex text-xs text-slate-500 mb-6 gap-2 print:hidden">
      <a href="/" class="hover:text-emerald-600 transition-colors">Главная</a>
      <span>/</span>
      <span class="text-slate-800 font-semibold">Калькулятор зарплаты на руки</span>
    </nav>

    <!-- Заголовок страницы -->
    <div class="mb-8">
      <h1 class="text-3xl md:text-4xl font-black text-slate-900 tracking-tight">
        Калькулятор зарплаты на руки (НДФЛ 2026)
      </h1>
      <p class="text-slate-600 mt-2 text-base md:text-lg">
        Рассчитайте сумму «чистыми» на карту, величину удержанного налога с учётом новой 5-ступенчатой прогрессивной шкалы НДФЛ и реальные затраты работодателя.
      </p>
    </div>

    <!-- Интерактивный калькулятор -->
    <div class="mb-14">
      <SalaryCalculator client:load />
    </div>

    <!-- Блок: Как мы считаем (формулы и закон) -->
    <section class="bg-white rounded-2xl p-6 md:p-8 border border-slate-200/80 shadow-sm mb-12">
      <h2 class="text-xl md:text-2xl font-bold text-slate-900 mb-4 flex items-center gap-2">
        <span class="text-emerald-600 font-black">#</span>
        Как рассчитывается зарплата в 2026 году
      </h2>
      <div class="prose prose-slate max-w-none text-sm text-slate-600 leading-relaxed space-y-4">
        <p>
          С 1 января 2025 года в России действует налоговая реформа (Федеральный закон от 12.07.2024 № 176-ФЗ), установившая многоступенчатую дифференцированную шкалу ставок НДФЛ для трудовых доходов:
        </p>

        <div class="overflow-x-auto my-4 rounded-xl border border-slate-200">
          <table class="w-full text-left text-xs md:text-sm">
            <thead class="bg-slate-100 text-slate-700 font-semibold">
              <tr>
                <th class="p-3">Годовой доход (руб.)</th>
                <th class="p-3">Эквивалент в месяц</th>
                <th class="p-3">Ставка НДФЛ</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-slate-700">
              <tr>
                <td class="p-3 font-semibold">До 2 400 000 ₽</td>
                <td class="p-3">до 200 000 ₽/мес.</td>
                <td class="p-3 font-bold text-emerald-700">13%</td>
              </tr>
              <tr>
                <td class="p-3 font-semibold">От 2 400 001 до 5 000 000 ₽</td>
                <td class="p-3">200 000 — 416 667 ₽/мес.</td>
                <td class="p-3 font-bold text-teal-700">15% с суммы превышения</td>
              </tr>
              <tr>
                <td class="p-3 font-semibold">От 5 000 001 до 20 000 000 ₽</td>
                <td class="p-3">416 667 — 1 666 667 ₽/мес.</td>
                <td class="p-3 font-bold text-indigo-700">18% с суммы превышения</td>
              </tr>
              <tr>
                <td class="p-3 font-semibold">От 20 000 001 до 50 000 000 ₽</td>
                <td class="p-3">1 666 667 — 4 166 667 ₽/мес.</td>
                <td class="p-3 font-bold text-amber-700">20% с суммы превышения</td>
              </tr>
              <tr>
                <td class="p-3 font-semibold">Свыше 50 000 000 ₽</td>
                <td class="p-3">более 4 166 667 ₽/мес.</td>
                <td class="p-3 font-bold text-rose-700">22% с суммы превышения</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h3 class="text-base font-bold text-slate-800 pt-2">Важный принцип накопительного итога:</h3>
        <p>
          НДФЛ исчисляется нарастающим итогом с 1 января текущего года (ст. 226 НК РФ). Если сумма заработка сотрудника за первые месяцы года не превышает 2,4 млн ₽, с неё удерживается 13%. Как только в каком-либо месяце суммарный доход превышает 2,4 млн ₽, с суммы превышения начинает удерживаться налог 15%.
        </p>

        <h3 class="text-base font-bold text-slate-800 pt-2">Детские вычеты (ст. 218 НК РФ):</h3>
        <p>
          Налоговый вычет уменьшает налогооблагаемую базу (оклад до расчёта налога). Право на вычет сохраняется до месяца, в котором суммарный доход с начала года превысит <span class="font-bold text-slate-900">450 000 рублей</span> (ранее лимит составлял 350 000 рублей).
        </p>
      </div>
    </section>

    <!-- Блок: FAQ (часто задаваемые вопросы) -->
    <section class="mb-12">
      <h2 class="text-xl md:text-2xl font-bold text-slate-900 mb-6">
        Частые вопросы о расчёте зарплаты и НДФЛ
      </h2>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group bg-white rounded-xl border border-slate-200/80 p-5 open:ring-2 open:ring-emerald-500/20 transition-all">
            <summary class="font-semibold text-slate-900 cursor-pointer list-none flex items-center justify-between">
              <span>{faq.q}</span>
              <span class="text-emerald-600 font-bold group-open:rotate-180 transition-transform">
                ↓
              </span>
            </summary>
            <p class="mt-3 text-sm text-slate-600 leading-relaxed border-t border-slate-100 pt-3">
              {faq.a}
            </p>
          </details>
        ))}
      </div>
    </section>

    <!-- Плашка нормативной базы -->
    <div class="p-4 rounded-xl bg-slate-100 border border-slate-200 text-xs text-slate-500 flex flex-wrap items-center justify-between gap-2">
      <span>Нормативная база: ст. 218, 224, 226, 425 Налогового кодекса РФ, 176-ФЗ</span>
      <span>Данные проверены: ноябрь 2026</span>
    </div>
  </div>
</BaseLayout>
