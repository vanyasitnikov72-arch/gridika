---
import BaseLayout from '../layouts/BaseLayout.astro';
import UnifiedCalculator from '../components/UnifiedCalculator';

const title = 'Единый финансовый онлайн-калькулятор РФ 2026: Зарплата, Налоги, Кредиты, Ипотека';
const description = 'Универсальный онлайн-калькулятор для России: расчёт зарплаты на руки по прогрессивной шкале НДФЛ 2025–2026 (176-ФЗ), налог самозанятых (НПД), досрочное погашение кредита и сравнение ипотеки с арендой.';
---

<BaseLayout title={title} description={description}>
  <!-- Главный баннер -->
  <section class="py-10 md:py-14 bg-gradient-to-b from-emerald-50/70 via-slate-50 to-transparent border-b border-slate-200/60">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center">
      <span class="inline-block px-3 py-1 bg-emerald-100 text-emerald-800 text-xs font-bold rounded-full mb-3">
        Все расчёты в одном окне • Актуально на 2026 г.
      </span>
      <h1 class="text-3xl md:text-5xl font-black text-slate-900 tracking-tight max-w-3xl mx-auto">
        Единый финансовый калькулятор
      </h1>
      <p class="text-slate-600 mt-3 text-base md:text-lg max-w-2xl mx-auto">
        Точные расчёты налогов, зарплат, кредитов и недвижимости. Переключайтесь между инструментами в один клик.
      </p>
    </div>
  </section>

  <!-- Интерактивный единый калькулятор -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 -mt-6 md:-mt-8 mb-16">
    <UnifiedCalculator client:load initialTab="salary" />
  </section>

  <!-- Блок преимуществ -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-8 border-t border-slate-200/60 mb-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 text-center md:text-left">
      <div class="p-4 rounded-xl bg-white border border-slate-200/70">
        <div class="text-2xl mb-2">⚡</div>
        <h3 class="font-bold text-slate-900 text-sm mb-1">Мгновенный расчёт</h3>
        <p class="text-xs text-slate-500">Работает локально прямо в браузере без задержек сети.</p>
      </div>

      <div class="p-4 rounded-xl bg-white border border-slate-200/70">
        <div class="text-2xl mb-2">🔒</div>
        <h3 class="font-bold text-slate-900 text-sm mb-1">100% приватно</h3>
        <p class="text-xs text-slate-500">Суммы ваших доходов и кредитов не отправляются на сервер.</p>
      </div>

      <div class="p-4 rounded-xl bg-white border border-slate-200/70">
        <div class="text-2xl mb-2">📜</div>
        <h3 class="font-bold text-slate-900 text-sm mb-1">По законам 2026</h3>
        <p class="text-xs text-slate-500">5 ступеней НДФЛ по 176-ФЗ, актуальные лимиты и вычеты.</p>
      </div>

      <div class="p-4 rounded-xl bg-white border border-slate-200/70">
        <div class="text-2xl mb-2">🖨️</div>
        <h3 class="font-bold text-slate-900 text-sm mb-1">Печать и ссылки</h3>
        <p class="text-xs text-slate-500">Сохраняйте результат в PDF или делитесь готовой ссылкой.</p>
      </div>
    </div>
  </section>
</BaseLayout>
