---
import BaseLayout from '../layouts/BaseLayout.astro';
import UnifiedCalculator from '../components/UnifiedCalculator';

const title = 'Калькулятор сравнения: Штат vs Самозанятость vs ИП — где выгоднее?';
const description = 'Сравнение налогов и чистой выплаты на руки для трёх форм занятости: трудовой договор по ТК РФ (НДФЛ + взносы 30%), самозанятость (НПД 6%) и ИП на УСН 6%.';

const faqs = [
  {
    q: 'Что выгоднее для специалиста с доходом 150 000 – 200 000 ₽?',
    a: 'Если смотреть только на размер чистых денег на руки — выгоднее Самозанятость (НПД 6%), так как заказчик не платит 30% страховых взносов и может выплатить исполнителю большую сумму. Однако трудовой договор даёт 28 дней оплачиваемого отпуска, оплату больничных, защиту от увольнения и пенсионный стаж.',
  },
  {
    q: 'Когда нужно переходить с самозанятости на ИП?',
    a: 'Когда ваш доход приближается к 2 400 000 ₽ в год (или превышает 200 000 ₽ в месяц). На самозанятости свыше этого порога работать нельзя. На ИП на УСН «Доходы 6%» лимит составляет 450 млн ₽ в год.',
  },
];

const schemaJson = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Калькулятор сравнения режимов работы',
      description,
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'All',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'RUB' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: { '@type': 'Answer', text: faq.a },
      })),
    },
  ],
};
---

<BaseLayout title={title} description={description} schemaJson={schemaJson}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 md:py-12">
    <!-- Хлебные крошки -->
    <nav class="flex text-xs text-slate-500 mb-6 gap-2 print:hidden">
      <a href="/" class="hover:text-emerald-600 transition-colors">Главная</a>
      <span>/</span>
      <span class="text-slate-800 font-semibold">Сравнение режимов работы</span>
    </nav>

    <!-- Заголовок страницы -->
    <div class="mb-8">
      <h1 class="text-3xl md:text-4xl font-black text-slate-900 tracking-tight">
        Сравнение: Штат vs Самозанятость vs ИП (2026)
      </h1>
      <p class="text-slate-600 mt-2 text-base md:text-lg">
        Узнайте, сколько вы теряете на налогах и страховых взносах в каждом из трёх вариантов и где остаётся больше чистых денег.
      </p>
    </div>

    <!-- Интерактивный калькулятор -->
    <div class="mb-14">
      <UnifiedCalculator client:load initialTab="compare" />
    </div>

    <!-- FAQ -->
    <section class="mb-12">
      <h2 class="text-xl md:text-2xl font-bold text-slate-900 mb-6">
        Частые вопросы о выборе налогового режима
      </h2>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group bg-white rounded-xl border border-slate-200/80 p-5 open:ring-2 open:ring-emerald-500/20 transition-all">
            <summary class="font-semibold text-slate-900 cursor-pointer list-none flex items-center justify-between">
              <span>{faq.q}</span>
              <span class="text-emerald-600 font-bold group-open:rotate-180 transition-transform">↓</span>
            </summary>
            <p class="mt-3 text-sm text-slate-600 leading-relaxed border-t border-slate-100 pt-3">
              {faq.a}
            </p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
