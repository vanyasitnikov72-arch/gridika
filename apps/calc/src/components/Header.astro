---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/zarplata-na-ruki', label: 'Зарплата и НДФЛ' },
  { href: '/nalog-samozanyatogo', label: 'Самозанятые (НПД)' },
  { href: '/dosrochnoe-pogashenie-kredita', label: 'Кредиты с досрочкой' },
  { href: '/ipoteka-ili-arenda', label: 'Ипотека или аренда' },
];
---

<header class="bg-white border-b border-slate-200 sticky top-0 z-30 print:hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 text-emerald-700 hover:text-emerald-800 transition-colors">
      <div class="w-9 h-9 rounded-xl bg-emerald-600 text-white flex items-center justify-center font-black text-xl shadow-md shadow-emerald-600/30">
        %
      </div>
      <div>
        <span class="font-black text-lg tracking-tight text-slate-900 block leading-tight">Калькуляторы</span>
        <span class="text-[10px] uppercase font-bold tracking-wider text-emerald-700 block -mt-0.5">Точный расчёт РФ</span>
      </div>
    </a>

    <nav class="hidden md:flex items-center gap-1">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href;
        return (
          <a
            href={link.href}
            class={`px-3 py-1.5 rounded-lg text-sm font-medium transition-colors flex items-center gap-1.5 ${
              isActive
                ? 'bg-emerald-50 text-emerald-700 font-semibold'
                : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100'
            }`}
          >
            <span>{link.label}</span>
            {link.badge && (
              <span class="px-1.5 py-0.5 text-[10px] bg-slate-100 text-slate-500 rounded font-normal">
                {link.badge}
              </span>
            )}
          </a>
        );
      })}
    </nav>
  </div>
</header>
