<script>
  import { createMorphLogo } from '../brand/morphLogo';

  function initBrandLogo() {
    const brandHost = document.getElementById('legal-brand');
    const brandName = document.getElementById('legal-brand-name');
    if (brandHost && brandName) {
      const build = () => createMorphLogo(brandHost, brandName, { logoCenter: { x: 24, y: 24 }, logoSize: 40 }).snap(0);
      document.fonts ? document.fonts.load('900 30px Nunito').then(build, build) : build();
    }
  }

  function initLegalTabs() {
    const container = document.getElementById('legal-container');
    if (!container) return;

    const pill = document.getElementById('legal-pill');
    const btnOffer = document.getElementById('tab-btn-offer');
    const btnPrivacy = document.getElementById('tab-btn-privacy');
    const docOffer = document.getElementById('doc-offer');
    const docPrivacy = document.getElementById('doc-privacy');

    if (!pill || !btnOffer || !btnPrivacy || !docOffer || !docPrivacy) return;

    const elPill = pill;
    const elBtnOffer = btnOffer;
    const elBtnPrivacy = btnPrivacy;
    const elDocOffer = docOffer;
    const elDocPrivacy = docPrivacy;

    function activateTab(tab: 'offer' | 'privacy', updateHistory = true) {
      if (tab === 'offer') {
        elPill.classList.remove('translate-x-[calc(100%+6px)]');
        elPill.classList.add('translate-x-0');

        elBtnOffer.classList.add('text-[#132A22]');
        elBtnOffer.classList.remove('text-[#78716c]');
        elBtnPrivacy.classList.remove('text-[#132A22]');
        elBtnPrivacy.classList.add('text-[#78716c]');

        // Smooth cross-fade transition
        elDocPrivacy.classList.remove('opacity-100', 'translate-y-0');
        elDocPrivacy.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => {
          elDocPrivacy.classList.add('hidden');
          elDocPrivacy.classList.remove('block');

          elDocOffer.classList.remove('hidden');
          elDocOffer.classList.add('block');
          requestAnimationFrame(() => {
            elDocOffer.classList.remove('opacity-0', 'translate-y-2');
            elDocOffer.classList.add('opacity-100', 'translate-y-0');
          });
        }, 150);

        document.title = 'Публичная оферта — Gridika';
        if (updateHistory) {
          window.history.pushState({ tab: 'offer' }, '', '/offer');
        }
      } else {
        elPill.classList.remove('translate-x-0');
        elPill.classList.add('translate-x-[calc(100%+6px)]');

        elBtnPrivacy.classList.add('text-[#132A22]');
        elBtnPrivacy.classList.remove('text-[#78716c]');
        elBtnOffer.classList.remove('text-[#132A22]');
        elBtnOffer.classList.add('text-[#78716c]');

        // Smooth cross-fade transition
        elDocOffer.classList.remove('opacity-100', 'translate-y-0');
        elDocOffer.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => {
          elDocOffer.classList.add('hidden');
          elDocOffer.classList.remove('block');

          elDocPrivacy.classList.remove('hidden');
          elDocPrivacy.classList.add('block');
          requestAnimationFrame(() => {
            elDocPrivacy.classList.remove('opacity-0', 'translate-y-2');
            elDocPrivacy.classList.add('opacity-100', 'translate-y-0');
          });
        }, 150);

        document.title = 'Политика конфиденциальности — Gridika';
        if (updateHistory) {
          window.history.pushState({ tab: 'privacy' }, '', '/privacy');
        }
      }
    }

    btnOffer.addEventListener('click', (e) => {
      e.preventDefault();
      activateTab('offer');
    });

    btnPrivacy.addEventListener('click', (e) => {
      e.preventDefault();
      activateTab('privacy');
    });

    window.addEventListener('popstate', () => {
      const path = window.location.pathname;
      if (path.includes('privacy')) {
        activateTab('privacy', false);
      } else {
        activateTab('offer', false);
      }
    });
  }

  // Run on page load
  initBrandLogo();
  initLegalTabs();
</script>
