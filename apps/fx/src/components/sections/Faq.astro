---
import SectionHead from './SectionHead.astro';

const faq = [
  {
    q: 'Работает ли на телефоне?',
    a: 'Да. Сцена подстраивается под ширину блока и экран телефона, а вне экрана засыпает и не тратит батарею.',
  },
  {
    q: 'QR-код точно сканируется?',
    a: 'Да. Сверху сцена — обычный QR с выровненным контрастом, детали в этот момент убираются. Перед выдачей кода студия проверяет, что он читается.',
  },
  {
    q: 'Можно поменять ссылку или текст после покупки?',
    a: 'Да, но не в самом коде: QR и надписи в нём уже собраны из кубиков, ручная правка их сломает. Откройте студию, вставьте ключ из письма, поменяйте что нужно и замените старый код на сайте новым. Ключ не сгорает — пересобирать код для своего сайта можно сколько угодно раз.',
  },
  {
    q: 'Можно ли свои цвета?',
    a: 'Сейчас у каждой формы три готовых режима — цвета в них подобраны так, чтобы QR гарантированно сканировался. Новые цвета добавляем по мере развития.',
  },
  {
    q: 'Не замедлит ли это сайт?',
    a: 'Сам код небольшой, библиотека three.js загружается с публичного CDN (около 150 КБ в сжатом виде). Анимация работает, только пока блок на экране.',
  },
  {
    q: 'Работает только на Тильде?',
    a: 'Нет. Код — обычный HTML и JavaScript: подходит WordPress, Webflow, Wix, Битрикс и любой сайт, куда можно вставить HTML-код. Для каждой платформы в окне с кодом есть короткая инструкция.',
  },
  {
    q: 'Какой нужен тариф Тильды?',
    a: 'Нужен блок T123 «HTML-код» — он есть на платных тарифах Tilda (Personal и Business).',
  },
  {
    q: 'Как купить и получить код?',
    a: 'В студии эффект можно собрать и посмотреть бесплатно. Для сайта покупается ключ — разово, навсегда для одного сайта. Регистрация не нужна: сразу после оплаты вы получаете готовый код (скопировать или скачать файлом), а ключ и ссылку на код — на почту. Ключ можно вставлять снова — если обновили страницу или поменяли ссылку, код соберётся заново.',
  },
  {
    q: 'Можно ли поставить один код на несколько сайтов?',
    a: 'Код привязан к сайту, для которого куплен ключ. Скопированный на другой сайт, он покажет пометку Gridika. Для нескольких сайтов нужны отдельные ключи — студиям сделаем пакет.',
  },
  {
    q: 'Что входит в один ключ?',
    a: 'Ключ работает навсегда на одном сайте. Визитка — на одного человека, 3D-логотип — на один знак, морф «до / после» — на одну пару фото: всё остальное (цвета, тексты, режимы) меняется бесплатно, а для коллеги, другого логотипа или новой пары нужен свой ключ — командам и студиям сделаем пакеты со скидкой. 3D QR, подарок и таймер — без ограничений на сайте: любые ссылки, промокоды и даты. Ключ «Все эффекты» — всё без ограничений для одного сайта.',
  },
];
---

<section id="faq" class="pt-16 pb-6 max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 scroll-mt-24">
  <SectionHead label="Вопросы" title="Частые вопросы" />

  <div id="faq-list" class="flex flex-col gap-3 min-h-[880px] sm:min-h-[990px]">
    {faq.map((item) => (
      <details class="vx-faq soft-3d-card !rounded-[1.5rem] px-6 transition-shadow duration-300">
        <summary class="flex items-center justify-between gap-4 py-4 cursor-pointer list-none select-none">
          <span class="text-[15px] font-extrabold text-[#132A22]">{item.q}</span>
          <span class="faq-icon w-7 h-7 shrink-0 rounded-full bg-[var(--vx-soft)] text-[#132A22] flex items-center justify-center text-lg font-black transition-transform duration-300 pointer-events-none select-none">+</span>
        </summary>
        <div class="faq-anim-grid grid grid-rows-[0fr] opacity-0 transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]">
          <div class="overflow-hidden min-h-0">
            <p class="pb-5 pt-0.5 text-[14px] text-[#6b645c] font-semibold leading-relaxed">
              {item.a}
            </p>
          </div>
        </div>
      </details>
    ))}
  </div>

  <style is:global>
    .vx-faq summary::-webkit-details-marker { display: none; }
    .vx-faq summary { outline: none; }

    /* Fluid CSS Grid transition with zero jitter / twitching */
    .vx-faq.is-open .faq-anim-grid {
      grid-template-rows: 1fr;
      opacity: 1;
    }

    .vx-faq.is-open .faq-icon {
      transform: rotate(45deg);
    }

    .vx-faq.is-open {
      box-shadow: 
        0 16px 36px -8px rgba(85, 70, 50, 0.12),
        0 4px 12px -2px rgba(85, 70, 50, 0.04),
        inset 0 1px 1px 0 rgba(255, 255, 255, 1);
    }
  </style>
</section>

<script>
  function initFaqAccordion() {
    const container = document.querySelector<HTMLElement>('#faq-list');
    const detailsEls = document.querySelectorAll<HTMLDetailsElement>('details.vx-faq');
    if (!detailsEls.length) return;

    const closingTimeouts = new WeakMap<HTMLDetailsElement, number>();

    // Dynamic height reservation so the bottom of the page (FinalCta & Footer)
    // never jumps or shifts when expanding/collapsing FAQ items.
    function updateMinHeight() {
      if (!container) return;
      let totalClosedHeight = 0;
      let maxAnswerHeight = 0;

      detailsEls.forEach((el) => {
        const summary = el.querySelector<HTMLElement>('summary');
        const p = el.querySelector<HTMLElement>('.faq-anim-grid p');
        if (summary) {
          totalClosedHeight += summary.offsetHeight;
        }
        if (p) {
          const h = Math.max(p.scrollHeight, p.offsetHeight);
          if (h > maxAnswerHeight) {
            maxAnswerHeight = h;
          }
        }
      });

      const gap = 12; // gap-3 = 12px
      const totalGaps = (detailsEls.length - 1) * gap;
      const targetMinHeight = totalClosedHeight + totalGaps + maxAnswerHeight + 28;
      container.style.minHeight = `${targetMinHeight}px`;
    }

    updateMinHeight();
    window.addEventListener('resize', updateMinHeight);
    if ('fonts' in document) {
      document.fonts.ready.then(updateMinHeight);
    }
    setTimeout(updateMinHeight, 200);

    function openDetails(el: HTMLDetailsElement) {
      const timeout = closingTimeouts.get(el);
      if (timeout) {
        clearTimeout(timeout);
        closingTimeouts.delete(el);
      }

      el.open = true;
      requestAnimationFrame(() => {
        el.classList.add('is-open');
      });
    }

    function closeDetails(el: HTMLDetailsElement) {
      if (!el.open) return;
      el.classList.remove('is-open');

      const timeout = window.setTimeout(() => {
        el.open = false;
        closingTimeouts.delete(el);
      }, 300); // Matches transition duration 300ms

      closingTimeouts.set(el, timeout);
    }

    detailsEls.forEach((el) => {
      const summary = el.querySelector('summary');
      if (!summary) return;

      summary.addEventListener('click', (e) => {
        e.preventDefault();
        const isOpen = el.classList.contains('is-open');

        if (isOpen) {
          closeDetails(el);
        } else {
          // Close other open details smoothly
          detailsEls.forEach((other) => {
            if (other !== el && other.open) {
              closeDetails(other);
            }
          });
          openDetails(el);
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFaqAccordion);
  } else {
    initFaqAccordion();
  }
</script>
