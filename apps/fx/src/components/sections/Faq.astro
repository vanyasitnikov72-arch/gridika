---
import SectionHead from './SectionHead.astro';

const faq = [
  {
    q: 'Почему нет регистрации и личного кабинета?',
    a: 'Мы намеренно отказались от паролей, анкет и сбора данных — это ваше прямое удобство: вы не тратите время на регистрации, а сразу забираете готовый код после оплаты. Ссылка на заказ приходит на почту и не сгорает: по ней код каждого эффекта можно скопировать снова в любой момент.',
  },
  {
    q: 'Работает ли на телефоне?',
    a: 'Да. 3D-сцена адаптируется под любой экран смартфона или планшета, поддерживает сенсорное управление (вращение пальцем), а вне экрана автоматически засыпает и не расходует батарею.',
  },
  {
    q: 'QR-код точно сканируется?',
    a: 'Да, гарантированно. При повороте камеры сверху сцена превращается в плоский чёткий QR-код с выверенным контрастом, а лишние 3D-детали скрываются. Перед выдачей кода студия автоматически проверяет его считываемость сканером.',
  },
  {
    q: 'Не замедлит ли это загрузку сайта?',
    a: 'Нет. Сам код компактный, библиотека Three.js загружается с быстрого CDN (около 150 КБ в сжатом виде), а анимация запускается только в тот момент, когда посетитель доскроллил до блока.',
  },
  {
    q: 'Можно ли поменять ссылку или текст после покупки?',
    a: 'Да. Заголовки, подписи, текст и ссылки кнопок лежат в коде обычным текстом — их можно поправить прямо там. А то, что собрано из кубиков (QR, промокод на подарке, логотип, фото), меняется в студии: откройте эффект по ссылке из письма кнопкой «Изменить в студии», поменяйте и оформите новый код — он вставляется на место старого.',
  },
  {
    q: 'На каких платформах работает и какой нужен тариф?',
    a: 'Подходит любая CMS и конструктор: Tilda, WordPress, Webflow, Wix, Битрикс или самописный HTML-сайт. В Tilda для вставки используется стандартный блок T123 «HTML-код» (доступен на тарифах Personal и Business). Для каждой платформы в окне кода есть короткая инструкция.',
  },
  {
    q: 'Можно ли заказать сразу несколько эффектов?',
    a: 'Да. Настройте каждый эффект в студии и нажмите «В заказ» — в одном заказе может быть сразу несколько, и чем их больше, тем дешевле каждый. После оплаты вы получите код каждого эффекта отдельно: каждый вставляется своим HTML-блоком.',
  },
];
---

<section id="faq" class="pt-16 pb-6 max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 scroll-mt-24">
  <SectionHead label="Вопросы" title="Частые вопросы" />

  <div id="faq-list" class="flex flex-col gap-3 min-h-[620px] sm:min-h-[700px]">
    {faq.map((item) => (
      <details class="vx-faq soft-3d-card !rounded-[1.5rem] px-6 transition-shadow duration-300">
        <summary class="flex items-center justify-between gap-4 py-4 cursor-pointer list-none select-none">
          <span class="text-[15px] font-extrabold text-[#132A22]">{item.q}</span>
          <span class="faq-icon w-7 h-7 shrink-0 rounded-full bg-[var(--vx-soft)] text-[#132A22] flex items-center justify-center text-lg font-black transition-transform duration-300 pointer-events-none select-none">+</span>
        </summary>
        <div class="faq-anim-grid grid grid-rows-[0fr] opacity-0 transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]">
          <div class="overflow-hidden min-h-0">
            <p class="pb-5 pt-0.5 text-[14px] text-[#6b645c] font-semibold leading-relaxed">
              {item.a}
            </p>
          </div>
        </div>
      </details>
    ))}
  </div>

  <style is:global>
    .vx-faq summary::-webkit-details-marker { display: none; }
    .vx-faq summary { outline: none; }

    /* Fluid CSS Grid transition with zero jitter / twitching */
    .vx-faq.is-open .faq-anim-grid {
      grid-template-rows: 1fr;
      opacity: 1;
    }

    .vx-faq.is-open .faq-icon {
      transform: rotate(45deg);
    }

    .vx-faq.is-open {
      box-shadow: 
        0 16px 36px -8px rgba(85, 70, 50, 0.12),
        0 4px 12px -2px rgba(85, 70, 50, 0.04),
        inset 0 1px 1px 0 rgba(255, 255, 255, 1);
    }
  </style>
</section>

<script>
  function initFaqAccordion() {
    const container = document.querySelector<HTMLElement>('#faq-list');
    const detailsEls = document.querySelectorAll<HTMLDetailsElement>('details.vx-faq');
    if (!detailsEls.length) return;

    const closingTimeouts = new WeakMap<HTMLDetailsElement, number>();

    // Dynamic height reservation so the bottom of the page (FinalCta & Footer)
    // never jumps or shifts when expanding/collapsing FAQ items.
    function updateMinHeight() {
      if (!container) return;
      let totalClosedHeight = 0;
      let maxAnswerHeight = 0;

      detailsEls.forEach((el) => {
        const summary = el.querySelector<HTMLElement>('summary');
        const p = el.querySelector<HTMLElement>('.faq-anim-grid p');
        if (summary) {
          totalClosedHeight += summary.offsetHeight;
        }
        if (p) {
          const h = Math.max(p.scrollHeight, p.offsetHeight);
          if (h > maxAnswerHeight) {
            maxAnswerHeight = h;
          }
        }
      });

      const gap = 12; // gap-3 = 12px
      const totalGaps = (detailsEls.length - 1) * gap;
      const targetMinHeight = totalClosedHeight + totalGaps + maxAnswerHeight + 28;
      container.style.minHeight = `${targetMinHeight}px`;
    }

    updateMinHeight();
    window.addEventListener('resize', updateMinHeight);
    if ('fonts' in document) {
      document.fonts.ready.then(updateMinHeight);
    }
    setTimeout(updateMinHeight, 200);

    function openDetails(el: HTMLDetailsElement) {
      const timeout = closingTimeouts.get(el);
      if (timeout) {
        clearTimeout(timeout);
        closingTimeouts.delete(el);
      }

      el.open = true;
      requestAnimationFrame(() => {
        el.classList.add('is-open');
      });
    }

    function closeDetails(el: HTMLDetailsElement) {
      if (!el.open) return;
      el.classList.remove('is-open');

      const timeout = window.setTimeout(() => {
        el.open = false;
        closingTimeouts.delete(el);
      }, 300); // Matches transition duration 300ms

      closingTimeouts.set(el, timeout);
    }

    detailsEls.forEach((el) => {
      const summary = el.querySelector('summary');
      if (!summary) return;

      summary.addEventListener('click', (e) => {
        e.preventDefault();
        const isOpen = el.classList.contains('is-open');

        if (isOpen) {
          closeDetails(el);
        } else {
          // Close other open details smoothly
          detailsEls.forEach((other) => {
            if (other !== el && other.open) {
              closeDetails(other);
            }
          });
          openDetails(el);
        }
      });
    });

    // Close on outside click anywhere on the page
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;
      if (target.closest('.vx-faq')) return;

      detailsEls.forEach((el) => {
        if (el.open) {
          closeDetails(el);
        }
      });
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        detailsEls.forEach((el) => {
          if (el.open) closeDetails(el);
        });
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFaqAccordion);
  } else {
    initFaqAccordion();
  }
</script>
