---
import SectionHead from './SectionHead.astro';
import { ProductPreview } from '../ProductPreview';

/** Mock landing pages showing where a 3D QR block sits on a real site. */
const sites = [
  {
    url: 'zerno-coffee.ru',
    brand: 'Зерно',
    kind: 'Кофейня',
    title: 'Меню — в один скан',
    text: 'Наведите камеру на дерево у кассы и откройте меню с сезонными напитками.',
    cta: 'Открыть меню',
    variant: 'tree' as const,
    bg: 'linear-gradient(160deg,#fbf3e6,#f1e1c8)',
    ink: '#3b2516',
    sub: '#7a5a3f',
    btn: '#3b2516',
    btnInk: '#fbf3e6',
    stage: 'rgba(255,255,255,0.55)',
  },
  {
    url: 'nord.studio',
    brand: 'NORD',
    kind: 'Архитектурное бюро',
    title: 'Портфолио в кармане',
    text: 'QR на визитке собирается в город из наших проектов и ведёт в портфолио.',
    cta: 'Смотреть проекты',
    variant: 'city' as const,
    bg: 'linear-gradient(160deg,#1b2233,#10141f)',
    ink: '#eef1f7',
    sub: '#9aa6bf',
    btn: '#f2c14e',
    btnInk: '#10141f',
    stage: 'rgba(255,255,255,0.06)',
  },
  {
    url: 'fest-krepost.ru',
    brand: 'Крепость',
    kind: 'Фестиваль',
    title: 'Билеты по QR',
    text: 'Замок собирается из кубиков, а сверху — QR на покупку билета.',
    cta: 'Купить билет',
    variant: 'castle' as const,
    bg: 'linear-gradient(160deg,#fde9f0,#f6d3e0)',
    ink: '#4a1230',
    sub: '#8f4a6a',
    btn: '#d0507f',
    btnInk: '#fff4f8',
    stage: 'rgba(255,255,255,0.5)',
  },
];
---

<section id="examples" class="py-16 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 scroll-mt-24">
  <SectionHead
    label="Примеры"
    title="Как это выглядит"
    accent="на настоящем сайте"
    lead="Эффект встаёт обычным блоком между другими блоками страницы — на Тильде или любом другом сайте. Ниже — макеты трёх лендингов."
  />

  <div class="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6">
    {sites.map((s, i) => (
      <figure class={`group rounded-[1.75rem] overflow-hidden bg-white border border-[#e5dfd2] shadow-[0_24px_48px_-24px_rgba(85,70,50,0.25)] transition-transform duration-500 hover:-translate-y-1.5 ${i === 1 ? 'md:translate-y-6 md:hover:translate-y-4' : ''}`}>
        {/* browser chrome */}
        <div class="flex items-center gap-2 px-4 h-9 bg-[#f6f3ee] border-b border-[#ebe5da]">
          <span class="w-2.5 h-2.5 rounded-full bg-[#e8a39b]"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-[#ecd08f]"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-[#a9d8a0]"></span>
          <span class="ml-2 flex-1 h-5 rounded-full bg-white border border-[#ebe5da] text-[10px] font-mono text-[#a8a29e] flex items-center px-2.5 truncate">{s.url}</span>
        </div>

        {/* page */}
        <div class="p-5 sm:p-6 h-[23rem] flex flex-col" style={`background:${s.bg}`}>
          <div class="flex items-center justify-between text-[11px] font-black uppercase tracking-[0.18em]" style={`color:${s.ink}`}>
            <span>{s.brand}</span>
            <span class="flex gap-3 font-bold normal-case tracking-normal opacity-60" style={`color:${s.sub}`}>
              <span>О нас</span><span>Контакты</span>
            </span>
          </div>

          <div class="mt-5 text-[10px] font-bold uppercase tracking-wider" style={`color:${s.sub}`}>{s.kind}</div>
          <div class="mt-1 text-[1.6rem] font-black leading-[1.05] tracking-tight" style={`color:${s.ink}`}>{s.title}</div>
          <p class="mt-2 text-[12px] font-semibold leading-snug max-w-[17rem]" style={`color:${s.sub}`}>{s.text}</p>

          {/* the Gridika block */}
          <div class="relative mt-auto rounded-2xl h-40 flex items-center justify-center" style={`background:${s.stage}`}>
            <ProductPreview id="qr-morph" variant={s.variant} className="h-32 w-auto drop-shadow-[0_14px_18px_rgba(0,0,0,0.18)]" />
          </div>
          <span class="mt-3 self-start px-3.5 py-1.5 rounded-full text-[11px] font-extrabold" style={`background:${s.btn};color:${s.btnInk}`}>{s.cta}</span>
        </div>
      </figure>
    ))}
  </div>
</section>
