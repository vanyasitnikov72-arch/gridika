---
/** Shared section heading: accent pill, title (second line in the product colour), lead. */
interface Props {
  label: string;
  title: string;
  accent?: string;
  lead?: string;
}
const { label, title, accent, lead } = Astro.props;
---

<div class="text-center max-w-2xl mx-auto mb-10 sm:mb-12">
  <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-[11px] font-black uppercase tracking-[0.14em] bg-[var(--vx-soft)] text-[#132A22]">
    <span class="w-1.5 h-1.5 rounded-full bg-[var(--vx-accent)]"></span>
    {label}
  </span>
  <h2 class="mt-3 text-3xl sm:text-4xl lg:text-[2.75rem] font-black text-[#132A22] tracking-tight leading-[1.08]">
    {title}
    {accent && (
      <>
        <br class="hidden sm:inline" />
        <span class="text-[var(--vx-accent)]"> {accent}</span>
      </>
    )}
  </h2>
  {lead && <p class="mt-3 text-[#6b645c] text-sm sm:text-[15px] font-semibold leading-relaxed">{lead}</p>}
</div>
