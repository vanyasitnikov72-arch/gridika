---
import { ProductPreview } from '../ProductPreview';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const LINKS = [
  {
    href: '/3d-qr-code/',
    id: 'qr-morph',
    title: '3D QR-код',
    tagline: 'QR-код, превращающийся в живую 3D-сцену',
    badge: 'Топ продаж',
  },
  {
    href: '/promo-gift/',
    id: 'gift-box',
    title: 'Подарок с промокодом',
    tagline: 'Воксельная коробка с открытием и скидкой',
    badge: 'Конверсия',
  },
  {
    href: '/3d-card/',
    id: 'qr-card',
    title: '3D-визитка с QR',
    tagline: 'Карточка эксперта с быстрым сохранением контакта',
    badge: 'Контакты',
  },
  {
    href: '/voxels/',
    id: 'voxel-logo',
    title: 'Воксели и 3D-логотипы',
    tagline: 'Объёмный логотип и морфинг «до / после»',
    badge: 'Брендинг',
  },
  {
    href: '/tilda/',
    id: 'tilda',
    title: 'Интеграция с Tilda',
    tagline: 'Гайд по установке в блоки T123 и Zero Block',
    badge: 'CMS Гайд',
  },
];

const filteredLinks = LINKS.filter((item) => item.href !== currentPath && item.href.replace(/\/$/, '') !== currentPath.replace(/\/$/, ''));
---

<section class="py-16 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-[#ebe4d8]">
  <div class="text-center max-w-2xl mx-auto mb-10">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#DFF8EB] text-[#0f5c3c] text-[11px] font-extrabold mb-2.5">
      <span>Линейка продуктов</span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-black text-[#132A22] tracking-tight">
      Другие интерактивные 3D-виджеты
    </h2>
    <p class="mt-2 text-sm text-[#6b645c] font-semibold">
      Все эффекты работают на одном быстром движке WebGL и вставляются в 1 клик.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
    {filteredLinks.map((item) => (
      <a
        href={item.href}
        class="soft-3d-card p-4 sm:p-5 flex flex-col justify-between group hover:-translate-y-1 transition-all duration-300"
      >
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded-full bg-[#f6f3ee] text-[#132A22] border border-[#e5dfd2]">
              {item.badge}
            </span>
            <span class="text-[var(--vx-accent)] text-sm font-black group-hover:translate-x-1 transition-transform">
              →
            </span>
          </div>
          <div class="h-28 rounded-2xl bg-gradient-to-br from-[#fbf9f5] to-[var(--vx-soft)] border border-[#ece6da] flex items-center justify-center p-2 mb-4 overflow-hidden">
            {item.id === 'tilda' ? (
              <div class="w-12 h-12 rounded-xl bg-black text-white font-black text-lg flex items-center justify-center shadow-md">
                T
              </div>
            ) : (
              <ProductPreview id={item.id as any} className="h-20 w-auto" float={false} />
            )}
          </div>
          <h3 class="text-base font-black text-[#132A22] group-hover:text-[var(--vx-accent)] transition-colors">
            {item.title}
          </h3>
          <p class="mt-1 text-xs text-[#6b645c] font-medium leading-relaxed">
            {item.tagline}
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-[#ece6da] flex items-center justify-between text-[11px] font-bold text-[#8a8378]">
          <span>Подробнее</span>
          <span class="text-[var(--vx-accent)] font-extrabold">Смотреть демо</span>
        </div>
      </a>
    ))}
  </div>
</section>
