---

<div class="sticky top-4 z-50 w-full px-4 sm:px-6 lg:px-8 pointer-events-none">
  <header class="max-w-5xl mx-auto rounded-2xl bg-[#1a1932]/90 backdrop-blur-md border border-white/10 px-4 sm:px-6 h-14 flex items-center justify-between pointer-events-auto transition-all shadow-[0_12px_36px_rgba(0,0,0,0.3)]">
    {/* Logo */}
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-indigo-500 to-purple-500 flex items-center justify-center text-white shadow-md shadow-indigo-500/30 group-hover:scale-105 transition-transform">
        <svg class="w-4 h-4 fill-current text-white" viewBox="0 0 24 24">
          <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
        </svg>
      </div>
      <div class="flex items-center gap-2">
        <span class="font-extrabold text-white tracking-tight text-sm sm:text-base">
          Temka FX
        </span>
        <span class="hidden sm:inline-flex px-2 py-0.5 rounded-full text-[10px] font-bold bg-indigo-500/20 text-indigo-300 border border-indigo-400/20">
          3D Bento
        </span>
      </div>
    </a>

    {/* Navigation links */}
    <nav class="hidden md:flex items-center gap-7 text-xs sm:text-sm font-semibold text-slate-300">
      <a href="#showcase" class="hover:text-white transition-colors">Эффект</a>
      <a href="#bento-features" class="hover:text-white transition-colors">Возможности</a>
      <a href="#how-it-works" class="hover:text-white transition-colors">Тильда</a>
      <a href="#catalog" class="hover:text-white transition-colors flex items-center gap-1.5">
        Каталог
        <span class="text-[9px] font-bold px-1.5 py-0.5 rounded-full bg-white/10 text-slate-300">Скоро</span>
      </a>
    </nav>

    {/* Right Action Button */}
    <div class="flex items-center gap-3">
      <a
        href="#showcase"
        class="px-4 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs shadow-md shadow-indigo-600/30 transition-all active:scale-95 flex items-center gap-1.5"
      >
        <span>Создать</span>
        <span class="text-xs">→</span>
      </a>
    </div>
  </header>
</div>
