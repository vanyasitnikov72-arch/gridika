---
---

<div class="sticky top-3 z-50 w-full px-4 sm:px-6 lg:px-8 pointer-events-none">
  <header class="max-w-5xl mx-auto soft-3d-dock px-5 sm:px-6 h-14 flex items-center justify-between pointer-events-auto transition-all">
    {/* Logo */}
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-8 h-8 rounded-full bg-[#19C37D] flex items-center justify-center text-[#132A22] shadow-md shadow-emerald-700/20 group-hover:scale-105 transition-transform">
        <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
          <path d="M12 2L2 19h20L12 2z" />
        </svg>
      </div>
      <div class="flex items-center gap-2">
        <span class="font-extrabold text-[#132A22] tracking-tight text-sm sm:text-base">
          Temka FX
        </span>
        <span class="hidden sm:inline-flex px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-[#DFF8EB] text-[#132A22]">
          Soft 3D
        </span>
      </div>
    </a>

    {/* Navigation links */}
    <nav class="hidden md:flex items-center gap-8 text-xs sm:text-sm font-bold text-[#57534e]">
      <a href="#showcase" class="hover:text-[#132A22] transition-colors">Эффект</a>
      <a href="#bento-features" class="hover:text-[#132A22] transition-colors">Возможности</a>
      <a href="#how-it-works" class="hover:text-[#132A22] transition-colors">Установка в Tilda</a>
      <a href="#catalog" class="hover:text-[#132A22] transition-colors flex items-center gap-1.5">
        Каталог
        <span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-[#DFF8EB] text-[#132A22]">Скоро</span>
      </a>
    </nav>

    {/* Right Action Button */}
    <div class="flex items-center gap-3">
      <a
        href="#showcase"
        class="px-4 py-1.5 rounded-full bg-[#132A22] hover:bg-[#19C37D] text-[#F0EBE9] hover:text-[#132A22] font-bold text-xs shadow-md transition-all active:scale-95 flex items-center gap-1.5"
      >
        <span>Создать</span>
        <span class="text-xs">→</span>
      </a>
    </div>
  </header>
</div>
