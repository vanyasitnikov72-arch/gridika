---
---

<div class="sticky top-4 z-50 w-full px-4 sm:px-6 lg:px-8 pointer-events-none">
  <header class="max-w-5xl mx-auto rounded-2xl liquid-glass px-4 sm:px-6 h-14 flex items-center justify-between pointer-events-auto transition-all shadow-[0_8px_30px_rgb(0,0,0,0.04)]">
    {/* Logo */}
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-8 h-8 rounded-xl bg-zinc-950 flex items-center justify-center text-white shadow-sm group-hover:scale-105 transition-transform">
        <svg class="w-4 h-4 fill-current text-white" viewBox="0 0 24 24">
          <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
        </svg>
      </div>
      <div class="flex items-center gap-2">
        <span class="font-bold text-zinc-950 tracking-tight text-sm sm:text-base">
          Temka FX
        </span>
        <span class="hidden sm:inline-flex px-2 py-0.5 rounded-full text-[10px] font-semibold bg-zinc-100 text-zinc-700 border border-zinc-200/80">
          Витрина 3D
        </span>
      </div>
    </a>

    {/* Navigation links */}
    <nav class="hidden md:flex items-center gap-7 text-xs sm:text-sm font-medium text-zinc-600">
      <a href="#showcase" class="hover:text-zinc-950 transition-colors">Живой эффект</a>
      <a href="#bento-features" class="hover:text-zinc-950 transition-colors">Возможности</a>
      <a href="#how-it-works" class="hover:text-zinc-950 transition-colors">Установка в Тильду</a>
      <a href="#catalog" class="hover:text-zinc-950 transition-colors flex items-center gap-1.5">
        Каталог
        <span class="text-[9px] font-semibold px-1.5 py-0.5 rounded-full bg-zinc-100 text-zinc-500 border border-zinc-200">Скоро</span>
      </a>
    </nav>

    {/* Right Action Button */}
    <div class="flex items-center gap-3">
      <a
        href="#showcase"
        class="px-3.5 py-1.5 rounded-xl bg-zinc-950 hover:bg-zinc-800 text-white font-medium text-xs shadow-sm hover:shadow transition-all active:scale-95 flex items-center gap-1.5"
      >
        <span>Создать эффект</span>
        <span class="text-xs">→</span>
      </a>
    </div>
  </header>
</div>
