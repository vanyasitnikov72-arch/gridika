---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { QrConfigurator } from '../components/QrConfigurator';
import InstallSteps from '../components/sections/InstallSteps.astro';
import WidgetCrossLinks from '../components/sections/WidgetCrossLinks.astro';

const pageTitle = "Воксели и 3D-логотипы для сайта — генератор интерактивных 3D-знаков | Gridika";
const pageDesc = "Интерактивный 3D-логотип из кубиков и морфинг «до / после» для первого экрана сайта. Рассыпается при наведении, собирается при загрузке. Установка на Tilda без кода.";
const canonicalUrl = "https://gridika.ru/voxels/";

const faqItems = [
  {
    q: "Какие форматы логотипов поддерживаются генератором?",
    a: "Поддерживаются файлы PNG, SVG, JPG и WebP размером до 5 МБ. Алгоритм автоматически определяет и очищает фон, а затем раскладывает геометрию на сетку цветных вокселей нужной глубины.",
  },
  {
    q: "Как 3D-логотип взаимодействует с пользователем?",
    a: "При загрузке страницы кубики слетаются из пространства и собирают объёмный знак. При наведении курсора логотип эффектно рассыпается и моментально собирается обратно, создавая интерактивный отклик.",
  },
  {
    q: "Прозрачный ли фон у 3D-сцены?",
    a: "Да, для режимов «Глянец» и «Матовый» фон по умолчанию прозрачный (alpha-channel). Вы можете расположить 3D-логотип поверх любого существующего фона или градиента первого экрана.",
  },
  {
    q: "Как вставить воксельный 3D-виджет в Tilda или Zero Block?",
    a: "Вставьте готовый код в блок T123 или элемент HTML внутри Zero Block. Скрипт предельно оптимизирован (вес около 20 КБ) и стабильно держит 60 FPS даже на мобильных устройствах.",
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Главная',
        item: 'https://gridika.ru/',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Воксели и 3D-логотипы',
        item: canonicalUrl,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Интерактивный 3D-логотип из вокселей Gridika',
    description: pageDesc,
    image: 'https://gridika.ru/web-app-manifest-512x512.png',
    offers: {
      '@type': 'Offer',
      price: '990',
      priceCurrency: 'RUB',
      availability: 'https://schema.org/InStock',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a,
      },
    })),
  },
];
---

<Layout
  title={pageTitle}
  description={pageDesc}
  canonicalUrl={canonicalUrl}
  structuredData={structuredData}
>
  <Navbar />

  <main class="flex-1 pb-20 relative overflow-hidden">
    {/* HERO HEADER */}
    <section class="pt-6 pb-6 sm:pt-8 md:pt-10 md:pb-8 max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#FFF0E6] text-[#b34700] text-[12px] font-extrabold mb-3 shadow-xs">
        <span>Интерактивный 3D-эффект #04</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-[#132A22] tracking-tight leading-[1.1]">
        3D-логотипы и воксели для первого экрана
      </h1>
      <p class="mt-3.5 text-base sm:text-lg text-[#6b645c] font-semibold max-w-2xl mx-auto leading-relaxed">
        Превратите логотип компании в живой трёхмерный объект из кубиков. Рассыпается при наведении, плавно покачивается и работает на прозрачном фоне без нагрузки на процессор.
      </p>
    </section>

    {/* INTERACTIVE STUDIO */}
    <section id="studio" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-12 scroll-mt-24">
      <QrConfigurator client:load initialProduct="voxel-logo" />
    </section>

    {/* INSTALLATION STEPS */}
    <InstallSteps />

    {/* FAQ SECTION */}
    <section class="py-14 max-w-4xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-8">
        <h2 class="text-2xl sm:text-3xl font-black text-[#132A22]">
          Частые вопросы о воксельных эффектах
        </h2>
      </div>
      <div class="space-y-3.5">
        {faqItems.map((item) => (
          <details class="group bg-white rounded-2xl border border-[#ece6da] p-5 shadow-xs transition-all [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between font-extrabold text-[#132A22] text-base cursor-pointer list-none">
              <span>{item.q}</span>
              <span class="w-7 h-7 rounded-full bg-[#f6f3ee] flex items-center justify-center text-sm group-open:rotate-180 transition-transform">
                ↓
              </span>
            </summary>
            <p class="mt-3 text-sm text-[#6b645c] font-semibold leading-relaxed">
              {item.a}
            </p>
          </details>
        ))}
      </div>
    </section>

    {/* CROSS LINKS */}
    <WidgetCrossLinks currentPath={canonicalUrl} />
  </main>

  <Footer />
</Layout>
