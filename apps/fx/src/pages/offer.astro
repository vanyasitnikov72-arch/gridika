---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import LegalDocs from '../components/LegalDocs.astro';

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Главная',
      item: 'https://gridika.ru/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Публичная оферта',
      item: 'https://gridika.ru/offer',
    },
  ],
};
---

<Layout 
  title="Публичная оферта — Gridika" 
  description="Публичная оферта и лицензионный договор на использование программного обеспечения и сервиса 3D-эффектов Gridika."
  structuredData={breadcrumbs}
>
  <main class="flex-1 max-w-4xl mx-auto w-full px-4 sm:px-6 py-6 sm:py-10">
    <LegalDocs initialTab="offer" />
  </main>

  <Footer />
</Layout>
