---

<Layout
  title="404 — Страница не найдена · Gridika"
  description="Запрашиваемая страница не найдена."
>
  <main class="min-h-screen flex flex-col items-center justify-center px-4 py-6 sm:py-8 select-none">
    <div class="w-full max-w-[420px] mx-auto flex flex-col items-center">
      
      {/* Voxel Gridika Logo Header */}
      <a href="/" class="mb-4 inline-block hover:opacity-80 transition-opacity" aria-label="Gridika — на главную">
        <svg viewBox="0 0 51 11" class="h-6 sm:h-7 w-auto" style="shape-rendering: crispEdges;">
          <path d={VOXEL_DARK_PATH} fill="#132A22" />
          <path d={VOXEL_GREEN_PATH} fill="#19C37D" />
        </svg>
      </a>

      {/* Compact 3D Master Card */}
      <div class="w-full soft-3d-card rounded-[2rem] px-5 py-6 sm:px-7 sm:py-7 text-center relative overflow-hidden shadow-[0_20px_48px_-15px_rgba(19,42,34,0.13)]">
        
        {/* Soft background ambient glow */}
        <div class="absolute -top-12 -left-12 w-36 h-36 rounded-full bg-[#DFF8EB]/70 blur-2xl pointer-events-none"></div>
        <div class="absolute -bottom-12 -right-12 w-36 h-36 rounded-full bg-orange-100/50 blur-2xl pointer-events-none"></div>

        {/* Real 3D Optical Illusion Canvas without podium */}
        <div class="relative my-1 flex justify-center items-center">
          <canvas
            id="illusion-404-canvas"
            class="w-full max-w-[340px] h-[200px] sm:h-[210px] select-none pointer-events-none"
            aria-label="404 из кубиков"
          ></canvas>
        </div>

        {/* Headline & Description */}
        <div class="relative mt-2">
          <h1 class="sr-only">Страница не найдена</h1>
          <p class="text-[13.5px] text-[#5c544c] font-semibold leading-relaxed max-w-xs mx-auto">
            Страница, которую вы ищете, переместилась или ещё не была построена.
          </p>
        </div>

        {/* Single Action Button: На главную */}
        <div class="relative mt-5 flex justify-center">
          <a
            href="/"
            class="h-11 px-7 rounded-full bg-gradient-to-b from-[#1d3a2f] to-[#132A22] hover:from-[#254a3c] hover:to-[#173329] text-white font-extrabold text-[13.5px] shadow-[0_10px_22px_-6px_rgba(19,42,34,0.55)] hover:scale-[1.03] active:scale-95 transition-all inline-flex items-center justify-center gap-2 cursor-pointer select-none no-underline"
          >
            <span class="w-5 h-5 rounded-full bg-[var(--vx-accent)] text-[#132A22] flex items-center justify-center font-black text-xs">←</span>
            <span>На главную</span>
          </a>
        </div>

      </div>

    </div>
  </main>
</Layout>

<script>
  import * as THREE from 'three';

  /*
   * "404" that turns into "404": a two-shadow voxel sculpture (like the "reality / dream" desk object).
   * front shadow A(x, y) = "404", side shadow B(z, y) = "404";
   * a cube stands wherever both shadows are filled. Straight on (orthographic camera) the object shows
   * exactly A; turned 90° it shows exactly B. In between it is a loose lattice of cubes.
   */
  const FONT: Record<string, string[]> = {
    '4': ['00010', '00110', '01010', '10010', '11111', '00010', '00010'],
    '0': ['01110', '10001', '10011', '10101', '11001', '10001', '01110'],
  };
  const TEXT = '404';
  const ROWS = 7;
  const COLS = TEXT.length * 5 + (TEXT.length - 1); // 17

  /** pixel of "404" and which digit it belongs to (-1 = empty) */
  function digitAt(col: number, row: number): number {
    const d = Math.floor(col / 6), c = col % 6;
    if (d >= TEXT.length || c === 5) return -1;
    return FONT[TEXT[d]][row][c] === '1' ? d : -1;
  }

  function init404Illusion() {
    const canvas = document.getElementById('illusion-404-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    const scene = new THREE.Scene();
    scene.add(new THREE.HemisphereLight(0xffffff, 0xcfd8d2, 1.7));
    const key = new THREE.DirectionalLight(0xffffff, 1.5);
    key.position.set(6, 12, 9);
    scene.add(key);
    const back = new THREE.DirectionalLight(0xdff8eb, 0.6);
    back.position.set(-8, -4, -8);
    scene.add(back);

    // the sculpture: x, y from the front "404", z (reversed, so it reads from the right side) from the side "404"
    const cells: { x: number; y: number; z: number; a: number; b: number }[] = [];
    for (let row = 0; row < ROWS; row++) {
      for (let cx = 0; cx < COLS; cx++) {
        const a = digitAt(cx, row);
        if (a < 0) continue;
        for (let cz = 0; cz < COLS; cz++) {
          const b = digitAt(cz, row);
          if (b < 0) continue;
          cells.push({ x: cx - (COLS - 1) / 2, y: (ROWS - 1) / 2 - row, z: (COLS - 1) / 2 - cz, a, b });
        }
      }
    }

    // each digit has its colour: dark 4, green 0, dark 4. Faces looking along z show the front "404",
    // faces looking along x show the side "404", so both read cleanly.
    const PALETTE = [new THREE.Color('#1b3a2e'), new THREE.Color('#19C37D'), new THREE.Color('#1b3a2e')];
    const geo = new THREE.BoxGeometry(0.94, 0.94, 0.94);
    const mat = new THREE.MeshStandardMaterial({ roughness: 0.38, metalness: 0.08 });
    const colB = new Float32Array(cells.length * 3);
    mat.onBeforeCompile = (sh) => {
      sh.vertexShader = sh.vertexShader
        .replace('#include <common>', '#include <common>\nattribute vec3 aColB;\nvarying vec3 vColB;\nvarying vec3 vLocalN;')
        .replace('#include <begin_vertex>', '#include <begin_vertex>\nvColB = aColB;\nvLocalN = normal;');
      sh.fragmentShader = sh.fragmentShader
        .replace('#include <common>', '#include <common>\nvarying vec3 vColB;\nvarying vec3 vLocalN;')
        .replace('#include <color_fragment>', [
          '#include <color_fragment>',
          // side faces (x) take the side digit's colour; tops blend the two
          'float sideK = abs(vLocalN.x) > 0.5 ? 1.0 : (abs(vLocalN.y) > 0.5 ? 0.5 : 0.0);',
          '#if defined( USE_COLOR ) || defined( USE_INSTANCING_COLOR )',
          'diffuseColor.rgb = mix(vColor.rgb, vColB, sideK);',
          '#endif',
        ].join('\n'));
    };
    mat.customProgramCacheKey = () => 'gridika-404-two-faces';
    const mesh = new THREE.InstancedMesh(geo, mat, cells.length);
    const m4 = new THREE.Matrix4();
    const tint = new THREE.Color();
    cells.forEach((c, i) => {
      m4.makeTranslation(c.x, c.y, c.z);
      mesh.setMatrixAt(i, m4);
      // a light top row on each digit, as before
      tint.copy(PALETTE[c.a]);
      if (c.y === (ROWS - 1) / 2) tint.lerp(new THREE.Color('#ffffff'), 0.25);
      mesh.setColorAt(i, tint);
      const cb = PALETTE[c.b].clone();
      if (c.y === (ROWS - 1) / 2) cb.lerp(new THREE.Color('#ffffff'), 0.25);
      colB.set([cb.r, cb.g, cb.b], i * 3);
    });
    geo.setAttribute('aColB', new THREE.InstancedBufferAttribute(colB, 3));
    const group = new THREE.Group();
    group.add(mesh);
    scene.add(group);

    // orthographic: straight on, depth collapses and only the shadow (= "404") remains
    const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0.1, 200);
    camera.position.set(0, 0, 60);
    camera.lookAt(0, 0, 0);
    let aspect = 1.6;
    function resize() {
      const w = canvas!.clientWidth, h = canvas!.clientHeight;
      if (!w || !h) return;
      aspect = w / h;
      renderer.setSize(w, h, false);
    }
    function frameCamera(zoomOut: number) {
      // room for the 17-wide "404"; a little more while the lattice turns (its diagonal is wider)
      const halfW = (COLS / 2 + 0.9) * (1 + zoomOut * 0.42);
      const halfH = Math.max(halfW / aspect, (ROWS / 2 + 1) * (1 + zoomOut * 0.42));
      camera.left = -halfH * aspect;
      camera.right = halfH * aspect;
      camera.top = halfH;
      camera.bottom = -halfH;
      camera.updateProjectionMatrix();
    }
    window.addEventListener('resize', resize);
    resize();

    // turning: hold "404", turn a quarter (tilting up a little so the volume shows), hold "404", turn back
    const HOLD = 1.7, TURN = 2.1, CYCLE = (HOLD + TURN) * 2;
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    function autoAngle(t: number) {
      const u = ((t % CYCLE) + CYCLE) % CYCLE;
      if (u < HOLD) return 0;
      if (u < HOLD + TURN) return ease((u - HOLD) / TURN);
      if (u < HOLD * 2 + TURN) return 1;
      return 1 - ease((u - HOLD * 2 - TURN) / TURN);
    }

    const clock0 = performance.now();
    const now = () => (performance.now() - clock0) / 1000;

    let raf = 0;
    function loop() {
      raf = requestAnimationFrame(loop);
      const t = now();
      const k = reduced ? 0 : autoAngle(t);
      // a quarter turn; the tilt peaks halfway and is exactly zero at both "404"s
      const mid = Math.sin(Math.PI * k);
      group.rotation.set(0.38 * mid, -(Math.PI / 2) * k, 0, 'XYZ');
      frameCamera(mid);
      group.position.y = reduced ? 0 : Math.sin(t * 1.6) * 0.08 * (1 - mid);
      renderer.render(scene, camera);
    }
    loop();

    return () => {
      cancelAnimationFrame(raf);
      window.removeEventListener('resize', resize);
      renderer.dispose();
      geo.dispose();
      mat.dispose();
    };
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init404Illusion);
  else init404Illusion();
</script>
