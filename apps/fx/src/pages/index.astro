---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { QrConfigurator } from '../components/QrConfigurator';
---

<Layout title="Temka FX — Интерактивные 3D вау-эффекты для сайтов на Tilda">
  <Navbar />

  <main class="flex-1 pb-24">
    {/* HERO SECTION: GIANT TYPE & BENTO PILLS */}
    <section class="relative pt-12 pb-12 md:pt-16 md:pb-16 overflow-hidden">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center flex flex-col items-center">
        {/* Bento Tag Pill */}
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-indigo-500/15 border border-indigo-400/25 text-xs font-bold text-indigo-300 mb-6 transition-all hover:scale-105 shadow-md">
          <span class="flex h-2 w-2 rounded-full bg-indigo-400 animate-ping"></span>
          <span>Bento 3D Showcase • Первый эффект: QR-морфинг</span>
        </div>

        {/* GIANT TYPE HEADLINE */}
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black text-white tracking-[-0.035em] max-w-4xl leading-[1.06]">
          Интерактивные 3D эффекты <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-300 via-purple-300 to-indigo-400">
            для сайтов на Tilda
          </span>
        </h1>

        <p class="mt-5 text-base sm:text-lg text-slate-300 max-w-2xl font-medium leading-relaxed">
          Установка за 1 минуту без программирования. 
          Настройте 3D-эффект в живом превью и вставьте код в блок T123.
        </p>

        {/* Bento Quick Tags */}
        <div class="mt-8 flex flex-wrap items-center justify-center gap-2.5 text-xs sm:text-sm font-bold text-slate-200">
          <span class="flex items-center gap-1.5 px-4 py-2 rounded-2xl bg-[#1b1a33] border border-white/10 shadow-md">
            <span class="text-indigo-400">✦</span> Блок T123 в Тильде
          </span>
          <span class="flex items-center gap-1.5 px-4 py-2 rounded-2xl bg-[#1b1a33] border border-white/10 shadow-md">
            <span class="text-emerald-400 font-black">✓</span> 100% считываемый QR
          </span>
          <span class="flex items-center gap-1.5 px-4 py-2 rounded-2xl bg-[#1b1a33] border border-white/10 shadow-md">
            <span class="text-cyan-400">⚡</span> 0% CPU вне экрана
          </span>
          <span class="flex items-center gap-1.5 px-4 py-2 rounded-2xl bg-[#1b1a33] border border-white/10 shadow-md">
            <span class="text-indigo-400">★</span> Без регистрации
          </span>
        </div>
      </div>
    </section>

    {/* SHOWCASE SECTION */}
    <section id="showcase" class="relative pb-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-5 flex flex-col sm:flex-row sm:items-end justify-between gap-3">
        <div>
          <span class="text-[11px] font-black uppercase tracking-wider text-indigo-400">Живой конфигуратор</span>
          <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight mt-0.5">
            3D QR-морфинг в реальном времени
          </h2>
        </div>

        <div class="flex items-center gap-2 text-xs font-bold text-indigo-200 bg-[#1b1a33] border border-white/10 px-4 py-2 rounded-2xl shadow-md">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Поддерживает iPhone и Android</span>
        </div>
      </div>

      {/* Preact Interactive Island */}
      <QrConfigurator client:load />
    </section>

    {/* BENTO GRID: CAPABILITIES & METRICS (Reference: Nue Bento Grid slide) */}
    <section id="bento-features" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-[11px] font-black uppercase tracking-wider text-indigo-400">Возможности</span>
        <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight mt-1">
          Bento-преимущества Temka FX
        </h2>
        <p class="text-slate-300 text-sm mt-2 font-medium">
          Почему дизайнеры выбирают наши эффекты для проектов.
        </p>
      </div>

      {/* BENTO GRID 4-CARDS (Exact Nue style) */}
      <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
        {/* Bento Card 1: Electric Purple / Indigo Accent Card (like nue brand card) */}
        <div class="md:col-span-5 bento-card-purple p-7 sm:p-8 flex flex-col justify-between group hover:scale-[1.01] transition-all">
          <div class="flex items-center justify-between">
            <span class="px-3.5 py-1 rounded-full text-xs font-black bg-white/20 text-white uppercase tracking-wider backdrop-blur-md">
              Считываемость
            </span>
            <span class="text-3xl">🎯</span>
          </div>
          <div class="my-6">
            <div class="text-5xl sm:text-6xl font-black text-white tracking-tight">
              100%
            </div>
            <div class="text-xl font-bold text-indigo-100 mt-1">
              Гарантия сканирования
            </div>
            <p class="text-xs sm:text-sm text-indigo-100/90 mt-3 leading-relaxed">
              Встроенный алгоритм декодирования в браузере тестирует считываемость кода камерами смартфонов перед копированием.
            </p>
          </div>
          <div class="flex items-center gap-2 text-xs font-bold text-white bg-black/15 px-3 py-2 rounded-xl backdrop-blur-md">
            <span>✓</span> Проверено по стандарту WCAG 2.1
          </div>
        </div>

        {/* Bento Card 2: Soft Pale Lilac Card (0% CPU / Battery) */}
        <div class="md:col-span-7 bento-card-light p-7 sm:p-8 flex flex-col justify-between group hover:scale-[1.01] transition-all">
          <div class="flex items-center justify-between">
            <span class="px-3.5 py-1 rounded-full text-xs font-black bg-indigo-600 text-white uppercase tracking-wider">
              Энергосбережение
            </span>
            <span class="text-3xl">🔋</span>
          </div>
          <div class="my-6">
            <div class="text-5xl sm:text-6xl font-black text-zinc-950 tracking-tight flex items-baseline gap-2">
              <span>0% CPU</span>
              <span class="text-lg font-bold text-zinc-500">вне зоны экрана</span>
            </div>
            <p class="text-sm text-zinc-600 mt-3 leading-relaxed max-w-lg font-medium">
              Технология <code class="text-zinc-900 font-mono font-bold bg-white px-2 py-0.5 rounded-lg border border-slate-300">IntersectionObserver</code> автоматически замораживает WebGL цикл, когда блок уходит из зоны видимости. Телефон клиента не греется.
            </p>
          </div>
          <div class="flex items-center gap-2 text-xs font-bold text-zinc-700">
            <span class="text-emerald-600 font-black">✓</span> 60-120 FPS рендеринг в один Draw Call
          </div>
        </div>

        {/* Bento Card 3: Soft Pale Lilac Card (Autonomous snippet) */}
        <div class="md:col-span-7 bento-card-light p-7 sm:p-8 flex flex-col justify-between group hover:scale-[1.01] transition-all">
          <div class="flex items-center justify-between">
            <span class="px-3.5 py-1 rounded-full text-xs font-black bg-indigo-600 text-white uppercase tracking-wider">
              Автономность
            </span>
            <span class="text-3xl">📦</span>
          </div>
          <div class="my-6">
            <div class="text-3xl sm:text-4xl font-black text-zinc-950 tracking-tight">
              Никаких сторонних серверов
            </div>
            <p class="text-sm text-zinc-600 mt-2.5 leading-relaxed font-medium">
              Матрица модулей QR и 3D координаты рассчитываются заранее при генерации кода. Сниппет вставляется в блок T123 и работает вечно без сбоев.
            </p>
          </div>
          <div class="flex items-center gap-2 text-xs font-bold text-zinc-700">
            <span class="text-indigo-600 font-black">✓</span> Резервное зеркало CDN встроено в код
          </div>
        </div>

        {/* Bento Card 4: Dark Indigo Card (Commercial Free Tier) */}
        <div class="md:col-span-5 bento-card-dark p-7 sm:p-8 flex flex-col justify-between group hover:scale-[1.01] transition-all border border-indigo-500/20">
          <div class="flex items-center justify-between">
            <span class="px-3.5 py-1 rounded-full text-xs font-black bg-indigo-500/20 text-indigo-300 border border-indigo-400/25 uppercase tracking-wider">
              Лицензия
            </span>
            <span class="text-3xl">💎</span>
          </div>
          <div class="my-6">
            <div class="text-3xl sm:text-4xl font-black text-white tracking-tight">
              Бесплатный флагман
            </div>
            <p class="text-xs sm:text-sm text-slate-300 mt-2.5 leading-relaxed font-medium">
              Ставьте на сайты клиентов или в личные проекты со значком <i>«⚡ Сделано в Temka FX»</i>.
            </p>
          </div>
          <div class="flex items-center gap-2 text-xs font-bold text-indigo-300">
            <span class="text-emerald-400">✓</span> Полная коммерческая свобода
          </div>
        </div>
      </div>
    </section>

    {/* BENTO GRID: 3 STEPS ON TILDA */}
    <section id="how-it-works" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-[11px] font-black uppercase tracking-wider text-indigo-400">Простота</span>
        <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight mt-1">
          Установка в Тильду за 3 шага
        </h2>
        <p class="text-slate-300 text-sm mt-2 font-medium">
          Понятно даже без опыта в программировании.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {/* Step 01 */}
        <div class="bento-card-light p-7 sm:p-8 flex flex-col justify-between hover:scale-[1.01] transition-all">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-indigo-600 flex items-center justify-center text-white font-black text-lg mb-6 shadow-md shadow-indigo-600/30">
              01
            </div>
            <h3 class="text-xl font-black text-zinc-950">Настройте в превью</h3>
            <p class="text-xs sm:text-sm text-zinc-600 mt-2.5 leading-relaxed font-medium">
              Введите вашу ссылку, выберите фигуру (Мегаполис, Кристалл или Сердце) и нажмите <b>«Код для Tilda»</b>.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-200 text-xs font-bold text-indigo-600">
            ⏱ 20 секунд
          </div>
        </div>

        {/* Step 02 */}
        <div class="bento-card-light p-7 sm:p-8 flex flex-col justify-between hover:scale-[1.01] transition-all">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-indigo-600 flex items-center justify-center text-white font-black text-lg mb-6 shadow-md shadow-indigo-600/30">
              02
            </div>
            <h3 class="text-xl font-black text-zinc-950">Добавьте блок T123</h3>
            <p class="text-xs sm:text-sm text-zinc-600 mt-2.5 leading-relaxed font-medium">
              В редакторе страницы нажмите <b>«Все блоки» ➔ «Другое» ➔ «HTML-код» (блок T123)</b> и вставьте код.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-200 text-xs font-bold text-indigo-600">
            ⏱ 15 секунд
          </div>
        </div>

        {/* Step 03 */}
        <div class="bento-card-light p-7 sm:p-8 flex flex-col justify-between hover:scale-[1.01] transition-all">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-indigo-600 flex items-center justify-center text-white font-black text-lg mb-6 shadow-md shadow-indigo-600/30">
              03
            </div>
            <h3 class="text-xl font-black text-zinc-950">Опубликуйте страницу</h3>
            <p class="text-xs sm:text-sm text-zinc-600 mt-2.5 leading-relaxed font-medium">
              Нажмите <b>«Опубликовать»</b>. Эффект сразу работает на любом домене, адаптируясь под мобильные экраны.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-200 text-xs font-bold text-indigo-600">
            ⏱ 10 секунд
          </div>
        </div>
      </div>
    </section>

    {/* BENTO CATALOG TEASER: UPCOMING EFFECTS */}
    <section id="catalog" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-[11px] font-black uppercase tracking-wider text-indigo-400">Будущие эффекты</span>
        <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight mt-1">
          Каталог в разработке
        </h2>
        <p class="text-slate-300 text-sm mt-2 font-medium">
          Скоро появятся новые интерактивные механики.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <div class="bento-card-dark p-7 flex flex-col justify-between hover:scale-[1.01] transition-all border border-indigo-500/20">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-3xl">🌌</span>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black bg-indigo-500/20 text-indigo-300 uppercase">Скоро</span>
            </div>
            <h4 class="font-black text-white text-base">Заголовок из частиц</h4>
            <p class="text-xs text-slate-300 mt-2 leading-relaxed font-medium">
              Заголовок сайта из сотен светящихся частиц, которые мягко разлетаются от курсора мыши и тача.
            </p>
          </div>
          <div class="mt-6 pt-3 border-t border-white/10 text-[11px] font-bold text-indigo-400">
            Кандидат №2
          </div>
        </div>

        <div class="bento-card-dark p-7 flex flex-col justify-between hover:scale-[1.01] transition-all border border-indigo-500/20">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-3xl">⏳</span>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black bg-indigo-500/20 text-indigo-300 uppercase">Скоро</span>
            </div>
            <h4 class="font-black text-white text-base">Голографический таймер</h4>
            <p class="text-xs text-slate-300 mt-2 leading-relaxed font-medium">
              Объемный 3D таймер обратного отсчета до старта события, вебинара или распродажи с парящими цифрами.
            </p>
          </div>
          <div class="mt-6 pt-3 border-t border-white/10 text-[11px] font-bold text-indigo-400">
            Кандидат №3
          </div>
        </div>

        <div class="bento-card-dark p-7 flex flex-col justify-between hover:scale-[1.01] transition-all border border-indigo-500/20">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-3xl">🛍️</span>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black bg-indigo-500/20 text-indigo-300 uppercase">Скоро</span>
            </div>
            <h4 class="font-black text-white text-base">3D Витрина товара</h4>
            <p class="text-xs text-slate-300 mt-2 leading-relaxed font-medium">
              Интерактивный подиум товара с динамическим бликом, вращением на 360° и демонстрацией деталей.
            </p>
          </div>
          <div class="mt-6 pt-3 border-t border-white/10 text-[11px] font-bold text-indigo-400">
            Кандидат №4
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
