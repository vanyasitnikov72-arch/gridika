---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { QrConfigurator } from '../components/QrConfigurator';
---

<Layout title="Temka FX — Интерактивные 3D вау-эффекты для сайтов на Tilda">
  <Navbar />

  <main class="flex-1 pb-24 relative overflow-hidden">
    {/* HERO SECTION: FAITHFUL SOFA CAKE REFERENCE LAYOUT */}
    <section class="relative pt-8 pb-12 md:pt-12 md:pb-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        {/* Top Floating Pill */}
        <div class="flex justify-center lg:justify-end mb-6 max-w-5xl mx-auto">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full soft-3d-pill text-xs font-black text-[#1c1917] shadow-sm">
            <span class="flex h-2.5 w-2.5 rounded-full bg-[#1ea678] animate-ping"></span>
            <span>Soft 3D витрина • Первый эффект: QR-морфинг</span>
          </div>
        </div>

        {/* Hero Composition: Organic Jade Spill on Left + Content on Right (Sofa Cake Reference) */}
        <div class="flex flex-col lg:flex-row items-center justify-center gap-8 lg:gap-14 max-w-5xl mx-auto">
          
          {/* 1. ORGANIC JADE LIQUID SPILL (Uncut, complete rounded organic shape from reference) */}
          <div class="relative w-[280px] h-[330px] sm:w-[320px] sm:h-[370px] shrink-0 select-none group">
            {/* SVG Organic Shape with exact pleasant jade-mint color from reference */}
            <svg class="w-full h-full filter drop-shadow-[0_20px_35px_rgba(30,166,120,0.28)]" viewBox="0 0 460 520" fill="none">
              <defs>
                <linearGradient id="sofaCakeJade" x1="10%" y1="0%" x2="90%" y2="100%">
                  <stop offset="0%" stop-color="#24b282" />
                  <stop offset="60%" stop-color="#1ea678" />
                  <stop offset="100%" stop-color="#179469" />
                </linearGradient>
              </defs>
              {/* Organic smooth rounded pebble/flag shape matching the Sofa Cake reference */}
              <path
                d="M 50,45 
                   C 50,20 75,10 110,8 
                   L 330,12 
                   C 390,15 440,45 450,105 
                   C 460,170 450,250 435,320 
                   C 420,380 430,430 415,465 
                   C 395,510 350,520 280,515 
                   L 110,510 
                   C 60,510 45,475 45,430 
                   Z"
                fill="url(#sofaCakeJade)"
              />
            </svg>

            {/* Depth of field floating blurred terracotta pill (exact element from reference!) */}
            <div class="absolute -top-4 right-4 w-14 h-7 rounded-full bg-gradient-to-r from-[#ea580c] to-[#f97316] blur-[4px] opacity-85 pointer-events-none transform rotate-12 shadow-md"></div>

            {/* Content inside the Jade Spill (Typography matching Sofa Cake) */}
            <div class="absolute inset-0 p-8 sm:p-10 flex flex-col justify-between pointer-events-none text-white">
              {/* Top minimal outline icon */}
              <div class="w-7 h-7 rounded-lg border-2 border-white/60 flex items-center justify-center text-xs opacity-90">
                <svg class="w-3.5 h-3.5 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                  <path d="M12 2L2 19h20L12 2z" />
                </svg>
              </div>

              {/* Bold Stacked Title (like 'Sofa cake' on reference) */}
              <div class="my-auto">
                <div class="text-4xl sm:text-[46px] font-black tracking-[-0.03em] leading-[0.98]">
                  Temka <br />
                  FX
                </div>
                <div class="text-[11px] font-bold text-emerald-100/90 tracking-wide mt-2">
                  WebGL 3D Studio
                </div>
              </div>

              {/* White floating kidney bean/pebble (exact visual element from reference!) */}
              <div class="w-12 h-6 rounded-full bg-white/90 shadow-md transform -rotate-12 mt-2"></div>
            </div>
          </div>

          {/* 2. RIGHT SIDE CONTENT (Like 'My storehouse' on reference) */}
          <div class="flex flex-col items-center lg:items-start text-center lg:text-left flex-1 max-w-xl">
            {/* GIANT TYPE HEADLINE */}
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-[#1c1917] tracking-[-0.035em] leading-[1.08]">
              Интерактивные 3D эффекты <br />
              <span class="text-[#1ea678]">
                для сайтов на Tilda
              </span>
            </h1>

            <p class="mt-4 text-sm sm:text-base text-[#57534e] font-semibold leading-relaxed">
              Установка за 1 минуту без программирования. 
              Настройте тактильный 3D-эффект в живом превью и вставьте код в блок T123.
            </p>

            {/* Tactile Soft 3D Quick Tags */}
            <div class="mt-6 flex flex-wrap items-center justify-center lg:justify-start gap-2 text-xs font-bold text-[#1c1917]">
              <span class="flex items-center gap-1.5 px-3.5 py-1.5 rounded-full soft-3d-pill shadow-sm">
                <span class="text-[#1ea678] font-black">✦</span> Блок T123 в Тильде
              </span>
              <span class="flex items-center gap-1.5 px-3.5 py-1.5 rounded-full soft-3d-pill shadow-sm">
                <span class="text-[#1ea678] font-black">✓</span> 100% считываемый QR
              </span>
              <span class="flex items-center gap-1.5 px-3.5 py-1.5 rounded-full soft-3d-pill shadow-sm">
                <span class="text-[#ea580c] font-black">⚡</span> 0% CPU вне экрана
              </span>
              <span class="flex items-center gap-1.5 px-3.5 py-1.5 rounded-full soft-3d-pill shadow-sm">
                <span class="text-[#1ea678] font-black">★</span> Без регистрации
              </span>
            </div>
          </div>

        </div>

      </div>
    </section>

    {/* SHOWCASE SECTION */}
    <section id="showcase" class="relative pb-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 z-10">
      <div class="mb-5 flex flex-col sm:flex-row sm:items-end justify-between gap-3">
        <div>
          <span class="text-[11px] font-black uppercase tracking-wider text-[#1ea678]">Живой конфигуратор</span>
          <h2 class="text-2xl sm:text-3xl font-black text-[#1c1917] tracking-tight mt-0.5">
            3D QR-морфинг в реальном времени
          </h2>
        </div>

        <div class="flex items-center gap-2 text-xs font-bold text-[#1ea678] soft-3d-pill px-4 py-2 shadow-sm">
          <span class="w-2.5 h-2.5 rounded-full bg-[#1ea678] animate-pulse"></span>
          <span>Поддерживает iPhone и Android</span>
        </div>
      </div>

      {/* Preact Interactive Configurator Island */}
      <QrConfigurator client:load />
    </section>

    {/* BENTO GRID: CAPABILITIES & METRICS IN SOFT 3D */}
    <section id="bento-features" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-[11px] font-black uppercase tracking-wider text-[#1ea678]">Преимущества</span>
        <h2 class="text-3xl sm:text-4xl font-black text-[#1c1917] tracking-tight mt-1">
          Создано для идеальных лендингов
        </h2>
        <p class="text-[#78716c] text-sm mt-2 font-medium">
          Тактильный WebGL-код, упакованный в простой сниппет.
        </p>
      </div>

      {/* BENTO GRID 4-CARDS */}
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
        {/* Bento Card 1: Velvet Emerald Card */}
        <div class="md:col-span-5 soft-3d-card-emerald p-7 sm:p-9 flex flex-col justify-between group hover:scale-[1.01] transition-all">
          <div class="flex items-center justify-between">
            <span class="px-3.5 py-1 rounded-full text-xs font-black bg-white/20 text-white uppercase tracking-wider backdrop-blur-md">
              Считываемость
            </span>
            <span class="text-3xl">🎯</span>
          </div>
          <div class="my-6">
            <div class="text-5xl sm:text-6xl font-black text-white tracking-tight">
              100%
            </div>
            <div class="text-xl font-bold text-emerald-100 mt-1">
              Гарантия сканирования
            </div>
            <p class="text-xs sm:text-sm text-emerald-100/90 mt-3 leading-relaxed font-medium">
              Встроенный декодер тестирует считываемость кода камерами смартфонов перед генерацией сниппета.
            </p>
          </div>
          <div class="flex items-center gap-2 text-xs font-bold text-white bg-black/20 px-3.5 py-2 rounded-2xl backdrop-blur-md">
            <span>✓</span> Проверено по стандарту WCAG 2.1
          </div>
        </div>

        {/* Bento Card 2: Soft White Card (0% CPU / Battery) */}
        <div class="md:col-span-7 soft-3d-card p-7 sm:p-9 flex flex-col justify-between group hover:scale-[1.01] transition-all">
          <div class="flex items-center justify-between">
            <span class="px-3.5 py-1 rounded-full text-xs font-black bg-[#f6f4ee] text-[#1c1917] border border-[#e5dfd2] uppercase tracking-wider">
              Энергосбережение
            </span>
            <span class="text-3xl">🔋</span>
          </div>
          <div class="my-6">
            <div class="text-5xl sm:text-6xl font-black text-[#1c1917] tracking-tight flex items-baseline gap-2">
              <span>0% CPU</span>
              <span class="text-lg font-bold text-[#78716c]">вне зоны экрана</span>
            </div>
            <p class="text-sm text-[#57534e] mt-3 leading-relaxed max-w-lg font-medium">
              Технология <code class="text-[#1c1917] font-mono font-bold bg-[#f6f4ee] px-2 py-0.5 rounded-lg border border-[#e5dfd2]">IntersectionObserver</code> автоматически замораживает WebGL цикл, когда блок уходит из экрана. Телефон не разряжается.
            </p>
          </div>
          <div class="flex items-center gap-2 text-xs font-bold text-[#1ea678]">
            <span class="font-black">✓</span> 60–120 FPS рендеринг в один Draw Call
          </div>
        </div>

        {/* Bento Card 3: Soft White Card (Autonomous snippet) */}
        <div class="md:col-span-7 soft-3d-card p-7 sm:p-9 flex flex-col justify-between group hover:scale-[1.01] transition-all">
          <div class="flex items-center justify-between">
            <span class="px-3.5 py-1 rounded-full text-xs font-black bg-[#f6f4ee] text-[#1c1917] border border-[#e5dfd2] uppercase tracking-wider">
              Автономность
            </span>
            <span class="text-3xl">📦</span>
          </div>
          <div class="my-6">
            <div class="text-3xl sm:text-4xl font-black text-[#1c1917] tracking-tight">
              Без сторонних серверов
            </div>
            <p class="text-sm text-[#57534e] mt-2.5 leading-relaxed font-medium">
              QR-матрица и трехмерные координаты рассчитываются заранее. Сниппет вставляется в блок T123 и работает надежно всегда.
            </p>
          </div>
          <div class="flex items-center gap-2 text-xs font-bold text-[#1ea678]">
            <span class="font-black">✓</span> Резервное зеркало CDN встроено в код
          </div>
        </div>

        {/* Bento Card 4: Soft Cream Card (Commercial Free Tier) */}
        <div class="md:col-span-5 soft-3d-card-cream p-7 sm:p-9 flex flex-col justify-between group hover:scale-[1.01] transition-all">
          <div class="flex items-center justify-between">
            <span class="px-3.5 py-1 rounded-full text-xs font-black bg-white text-[#1c1917] border border-[#e2dcd0] uppercase tracking-wider shadow-sm">
              Лицензия
            </span>
            <span class="text-3xl">💎</span>
          </div>
          <div class="my-6">
            <div class="text-3xl sm:text-4xl font-black text-[#1c1917] tracking-tight">
              Бесплатный флагман
            </div>
            <p class="text-xs sm:text-sm text-[#57534e] mt-2.5 leading-relaxed font-medium">
              Ставьте на сайты клиентов или в личные проекты со значком <i>«⚡ Сделано в Temka FX»</i>.
            </p>
          </div>
          <div class="flex items-center gap-2 text-xs font-bold text-[#1ea678]">
            <span>✓</span> Полная коммерческая свобода
          </div>
        </div>
      </div>
    </section>

    {/* BENTO GRID: 3 STEPS ON TILDA */}
    <section id="how-it-works" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-[11px] font-black uppercase tracking-wider text-[#1ea678]">Простота</span>
        <h2 class="text-3xl sm:text-4xl font-black text-[#1c1917] tracking-tight mt-1">
          Установка в Тильду за 3 шага
        </h2>
        <p class="text-[#78716c] text-sm mt-2 font-medium">
          Понятно даже без навыков программирования.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {/* Step 01 */}
        <div class="soft-3d-card p-7 sm:p-8 flex flex-col justify-between hover:scale-[1.01] transition-all">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-[#1ea678] flex items-center justify-center text-white font-black text-lg mb-6 shadow-md shadow-emerald-950/20">
              01
            </div>
            <h3 class="text-xl font-black text-[#1c1917]">Настройте в превью</h3>
            <p class="text-xs sm:text-sm text-[#57534e] mt-2.5 leading-relaxed font-medium">
              Введите вашу ссылку, выберите фигуру (Смартфон, Мегаполис, Кристалл) и нажмите <b>«Код для Tilda»</b>.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-[#ede9df] text-xs font-bold text-[#1ea678]">
            ⏱ 20 секунд
          </div>
        </div>

        {/* Step 02 */}
        <div class="soft-3d-card p-7 sm:p-8 flex flex-col justify-between hover:scale-[1.01] transition-all">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-[#1ea678] flex items-center justify-center text-white font-black text-lg mb-6 shadow-md shadow-emerald-950/20">
              02
            </div>
            <h3 class="text-xl font-black text-[#1c1917]">Добавьте блок T123</h3>
            <p class="text-xs sm:text-sm text-[#57534e] mt-2.5 leading-relaxed font-medium">
              В редакторе страницы нажмите <b>«Все блоки» ➔ «Другое» ➔ «HTML-код» (блок T123)</b> и вставьте код.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-[#ede9df] text-xs font-bold text-[#1ea678]">
            ⏱ 15 секунд
          </div>
        </div>

        {/* Step 03 */}
        <div class="soft-3d-card p-7 sm:p-8 flex flex-col justify-between hover:scale-[1.01] transition-all">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-[#1ea678] flex items-center justify-center text-white font-black text-lg mb-6 shadow-md shadow-emerald-950/20">
              03
            </div>
            <h3 class="text-xl font-black text-[#1c1917]">Опубликуйте страницу</h3>
            <p class="text-xs sm:text-sm text-[#57534e] mt-2.5 leading-relaxed font-medium">
              Нажмите <b>«Опубликовать»</b>. Эффект сразу работает на любом домене, адаптируясь под мобильные экраны.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-[#ede9df] text-xs font-bold text-[#1ea678]">
            ⏱ 10 секунд
          </div>
        </div>
      </div>
    </section>

    {/* BENTO CATALOG TEASER: UPCOMING EFFECTS */}
    <section id="catalog" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-[11px] font-black uppercase tracking-wider text-[#1ea678]">Будущие эффекты</span>
        <h2 class="text-3xl sm:text-4xl font-black text-[#1c1917] tracking-tight mt-1">
          Каталог в разработке
        </h2>
        <p class="text-[#78716c] text-sm mt-2 font-medium">
          Скоро появятся новые интерактивные механики.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="soft-3d-card p-7 flex flex-col justify-between hover:scale-[1.01] transition-all">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-3xl">🌌</span>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black bg-[#ede9df] text-[#57534e] uppercase">Скоро</span>
            </div>
            <h4 class="font-black text-[#1c1917] text-base">Заголовок из частиц</h4>
            <p class="text-xs text-[#57534e] mt-2 leading-relaxed font-medium">
              Заголовок сайта из сотен частиц, которые мягко разлетаются от курсора мыши и пальца на экране.
            </p>
          </div>
          <div class="mt-6 pt-3 border-t border-[#ede9df] text-[11px] font-bold text-[#1ea678]">
            Кандидат №2
          </div>
        </div>

        <div class="soft-3d-card p-7 flex flex-col justify-between hover:scale-[1.01] transition-all">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-3xl">⏳</span>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black bg-[#ede9df] text-[#57534e] uppercase">Скоро</span>
            </div>
            <h4 class="font-black text-[#1c1917] text-base">Голографический таймер</h4>
            <p class="text-xs text-[#57534e] mt-2 leading-relaxed font-medium">
              Объемный 3D таймер обратного отсчета до старта события, вебинара или распродажи с парящими цифрами.
            </p>
          </div>
          <div class="mt-6 pt-3 border-t border-[#ede9df] text-[11px] font-bold text-[#1ea678]">
            Кандидат №3
          </div>
        </div>

        <div class="soft-3d-card p-7 flex flex-col justify-between hover:scale-[1.01] transition-all">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-3xl">🛍️</span>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black bg-[#ede9df] text-[#57534e] uppercase">Скоро</span>
            </div>
            <h4 class="font-black text-[#1c1917] text-base">3D Витрина товара</h4>
            <p class="text-xs text-[#57534e] mt-2 leading-relaxed font-medium">
              Интерактивный подиум товара с динамическим бликом, вращением на 360° и взрыв-схемой компонентов.
            </p>
          </div>
          <div class="mt-6 pt-3 border-t border-[#ede9df] text-[11px] font-bold text-[#1ea678]">
            Кандидат №4
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
