---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { QrConfigurator } from '../components/QrConfigurator';
---

<Layout title="Temka FX — Интерактивные 3D вау-эффекты для сайтов на Tilda">
  <Navbar />

  <main class="flex-1">
    {/* HERO SECTION */}
    <section class="relative pt-14 pb-16 md:pt-20 md:pb-20 overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center flex flex-col items-center">
        {/* Minimal pill banner */}
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-zinc-200 shadow-sm text-xs font-medium text-zinc-700 mb-6 transition-all hover:border-zinc-300">
          <span class="flex h-2 w-2 rounded-full bg-zinc-950"></span>
          <span>Первый эффект: 3D Интерактивный QR-код с морфингом</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-zinc-950 tracking-tight max-w-4xl leading-[1.12]">
          Интерактивные 3D вау-эффекты <br />
          <span class="text-zinc-500 font-medium">
            для сайтов на Tilda за 1 минуту
          </span>
        </h1>

        <p class="mt-5 text-base sm:text-lg text-zinc-600 max-w-2xl font-normal leading-relaxed">
          Выделите сайт клиента и добавьте премиальности без навыков программирования. 
          Настройте эффект в живом превью, скопируйте код и вставьте в блок T123.
        </p>

        {/* Benefits pills */}
        <div class="mt-8 flex flex-wrap items-center justify-center gap-2.5 text-xs sm:text-sm font-medium text-zinc-600">
          <span class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white border border-zinc-200 shadow-sm">
            <span class="text-zinc-950 font-bold">✓</span> Вставка через блок T123
          </span>
          <span class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white border border-zinc-200 shadow-sm">
            <span class="text-emerald-600 font-bold">✓</span> 100% сканируемый QR-код
          </span>
          <span class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white border border-zinc-200 shadow-sm">
            <span class="text-zinc-950 font-bold">✓</span> Автопауза вне экрана (0% CPU)
          </span>
          <span class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white border border-zinc-200 shadow-sm">
            <span class="text-zinc-950 font-bold">✓</span> Без подписок и регистрации
          </span>
        </div>
      </div>
    </section>

    {/* SHOWCASE & CONFIGURATOR SECTION */}
    <section id="showcase" class="relative pb-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-zinc-500">Живое превью</span>
          <h2 class="text-2xl sm:text-3xl font-bold text-zinc-950 tracking-tight mt-1">
            Интерактивный 3D QR-морфинг
          </h2>
          <p class="text-sm text-zinc-500 mt-1 max-w-xl">
            По нажатию рассыпается на объемные кубики и собирается в выбранную 3D-фигуру.
            Попробуйте кликнуть и повращать прямо сейчас.
          </p>
        </div>

        <div class="flex items-center gap-2 text-xs font-medium text-zinc-500 bg-white border border-zinc-200 px-3 py-1.5 rounded-xl shadow-sm">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>Поддерживает iPhone и Android</span>
        </div>
      </div>

      {/* Preact interactive configurator island */}
      <QrConfigurator client:load />
    </section>

    {/* HOW IT WORKS ON TILDA SECTION */}
    <section id="how-it-works" class="py-20 border-t border-zinc-200 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="text-xs font-bold uppercase tracking-wider text-zinc-500">Быстрый старт</span>
          <h2 class="text-3xl font-bold text-zinc-950 tracking-tight mt-2">
            Как установить на сайт в Тильде
          </h2>
          <p class="text-zinc-500 text-sm mt-2">
            Всего три шага без сторонних плагинов и сложных настроек.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {/* Step 1 */}
          <div class="relative p-7 rounded-3xl bg-[#fafafa] border border-zinc-200/90 flex flex-col hover:border-zinc-300 transition-colors">
            <div class="w-10 h-10 rounded-xl bg-white border border-zinc-200 flex items-center justify-center text-zinc-950 font-bold text-sm mb-5 shadow-sm">
              01
            </div>
            <h3 class="text-base font-bold text-zinc-950">Настройте и скопируйте код</h3>
            <p class="text-sm text-zinc-600 mt-2 leading-relaxed">
              В конфигураторе выше введите вашу ссылку, выберите 3D фигуру и цветовую тему. Нажмите <b>«Получить код»</b>.
            </p>
          </div>

          {/* Step 2 */}
          <div class="relative p-7 rounded-3xl bg-[#fafafa] border border-zinc-200/90 flex flex-col hover:border-zinc-300 transition-colors">
            <div class="w-10 h-10 rounded-xl bg-white border border-zinc-200 flex items-center justify-center text-zinc-950 font-bold text-sm mb-5 shadow-sm">
              02
            </div>
            <h3 class="text-base font-bold text-zinc-950">Добавьте блок T123 в Тильде</h3>
            <p class="text-sm text-zinc-600 mt-2 leading-relaxed">
              В редакторе страницы нажмите <b>«Все блоки» ➔ «Другое» ➔ «HTML-код» (блок T123)</b> и вставьте код внутрь.
            </p>
          </div>

          {/* Step 3 */}
          <div class="relative p-7 rounded-3xl bg-[#fafafa] border border-zinc-200/90 flex flex-col hover:border-zinc-300 transition-colors">
            <div class="w-10 h-10 rounded-xl bg-white border border-zinc-200 flex items-center justify-center text-zinc-950 font-bold text-sm mb-5 shadow-sm">
              03
            </div>
            <h3 class="text-base font-bold text-zinc-950">Опубликуйте страницу</h3>
            <p class="text-sm text-zinc-600 mt-2 leading-relaxed">
              Нажмите <b>«Опубликовать»</b>. Эффект сразу работает: посетители смогут нажимать, крутить в 3D и сканировать код камерой телефона.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* FEATURES / ADVANTAGES */}
    <section id="features" class="py-20 border-t border-zinc-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="text-xs font-bold uppercase tracking-wider text-zinc-500">Преимущества</span>
          <h2 class="text-3xl font-bold text-zinc-950 tracking-tight mt-2">
            Качество и производительность
          </h2>
          <p class="text-zinc-500 text-sm mt-2">
            Разработано специально для коммерческих сайтов с высокими требованиями.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="p-6 rounded-2xl bg-white border border-zinc-200 shadow-sm flex flex-col gap-3">
            <span class="text-2xl">🔋</span>
            <h4 class="font-bold text-zinc-950 text-base">Бережет батарею</h4>
            <p class="text-xs text-zinc-600 leading-relaxed">
              Автоматически ставит 3D-рендеринг на паузу через <code class="text-zinc-950 font-mono">IntersectionObserver</code>, когда блок вне экрана. 0% нагрузки в фоне.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-white border border-zinc-200 shadow-sm flex flex-col gap-3">
            <span class="text-2xl">🎯</span>
            <h4 class="font-bold text-zinc-950 text-base">Точное считывание</h4>
            <p class="text-xs text-zinc-600 leading-relaxed">
              Каждый вариант проверяется встроенным декодером <code class="text-zinc-950 font-mono">jsQR</code> на контраст и распознаваемость стандартной камерой.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-white border border-zinc-200 shadow-sm flex flex-col gap-3">
            <span class="text-2xl">📦</span>
            <h4 class="font-bold text-zinc-950 text-base">Автономный сниппет</h4>
            <p class="text-xs text-zinc-600 leading-relaxed">
              Координаты и матрица рассчитываются заранее при генерации. Код не зависит от тяжелых сторонних серверов.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-white border border-zinc-200 shadow-sm flex flex-col gap-3">
            <span class="text-2xl">⚡</span>
            <h4 class="font-bold text-zinc-950 text-base">Бесплатный флагман</h4>
            <p class="text-xs text-zinc-600 leading-relaxed">
              Эффект доступен бесплатно для установки на любые клиентские и личные сайты с сохранением значка Temka FX.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* CATALOG TEASER */}
    <section id="catalog" class="py-20 border-t border-zinc-200 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="text-xs font-bold uppercase tracking-wider text-zinc-500">В разработке</span>
          <h2 class="text-3xl font-bold text-zinc-950 tracking-tight mt-2">
            Следующие эффекты витрины
          </h2>
          <p class="text-zinc-500 text-sm mt-2">
            Новые интерактивные механики для главных экранов лендингов.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-6 rounded-2xl bg-[#fafafa] border border-zinc-200 flex flex-col gap-3">
            <div class="flex items-center justify-between">
              <span class="text-2xl">🌌</span>
              <span class="text-[10px] uppercase font-semibold px-2 py-0.5 rounded-full bg-zinc-200 text-zinc-700">Скоро</span>
            </div>
            <h4 class="font-bold text-zinc-950 text-base">Заголовок из частиц</h4>
            <p class="text-xs text-zinc-600 leading-relaxed">
              Главный заголовок сайта, состоящий из сотен частиц, которые мягко разлетаются от курсора мыши и собираются обратно.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-[#fafafa] border border-zinc-200 flex flex-col gap-3">
            <div class="flex items-center justify-between">
              <span class="text-2xl">⏳</span>
              <span class="text-[10px] uppercase font-semibold px-2 py-0.5 rounded-full bg-zinc-200 text-zinc-700">Скоро</span>
            </div>
            <h4 class="font-bold text-zinc-950 text-base">Голографический таймер</h4>
            <p class="text-xs text-zinc-600 leading-relaxed">
              Объемный 3D таймер обратного отсчета до старта события, вебинара или дропа с парящими цифрами и физикой.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-[#fafafa] border border-zinc-200 flex flex-col gap-3">
            <div class="flex items-center justify-between">
              <span class="text-2xl">🛍️</span>
              <span class="text-[10px] uppercase font-semibold px-2 py-0.5 rounded-full bg-zinc-200 text-zinc-700">Скоро</span>
            </div>
            <h4 class="font-bold text-zinc-950 text-base">3D Витрина товара</h4>
            <p class="text-xs text-zinc-600 leading-relaxed">
              Интерактивный подиум товара с динамическим бликом, вращением на 360° и демонстрацией деталей по клику.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
