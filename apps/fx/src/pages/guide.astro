</style>

<script>
  import { CMS_GUIDES } from '../engine/cmsGuides';
  import castleSnippet from '../embed/castleSnippet.txt?raw';

  // STEPPER DATA & TEXTS
  const STEPS = [
    {
      num: 1,
      title: 'Шаг 1: Открытие файла в любом редакторе',
      text: 'Кликните правой кнопкой мыши по файлу эффекта (или коду в CMS) и откройте его в Блокноте (Notepad), TextEdit, VS Code, Sublime Text или любом другом редакторе.',
      badge: 'Шаг 1 из 5',
    },
    {
      num: 2,
      title: 'Шаг 2: Нажатие Ctrl + F (Cmd + F) и поиск нужной строки',
      text: 'Сочетание клавиш Ctrl+F (или Cmd+F на Mac) мгновенно открывает строку поиска в редакторе. Введите старый номер телефона или текст — редактор автоматически пролистает код вниз и подсветит нужную строку.',
      badge: 'Шаг 2 из 5',
    },
    {
      num: 3,
      title: 'Шаг 3: Замена текста в кавычках и сохранение (Ctrl + S / Cmd + S)',
      text: 'Сотрите старый номер внутри одинарных кавычек и впишите свой. Затем нажмите сочетание клавиш Ctrl+S (Cmd+S на Mac) для сохранения файла. Главное: одинарные кавычки \'...\' и запятую в конце не удаляйте!',
      badge: 'Шаг 3 из 5',
    },
    {
      num: 4,
      title: 'Шаг 4: Готовый результат на вашем сайте',
      text: 'Обновите страницу сайта в браузере (F5): 3D-сцена сразу отображает новые контактные данные без перезагрузок и повторной покупки.',
      badge: 'Шаг 4 из 5',
    },
    {
      num: 5,
      title: 'Шаг 5: Почему нельзя менять ссылку QR-кода вручную',
      text: '3D-кубики QR-кода генерируются сервером под конкретную ссылку. Если заменить ссылку в текстовом файле, кубики не перестроятся, и камера откроет старый сайт!',
      badge: 'Шаг 5 из 5',
    },
  ];

  function initGuidePage() {
    if (!document.getElementById('guide-step-tabs')) return;

    let currentStep = 1;
  const tabBtns = document.querySelectorAll('#guide-step-tabs button[data-step]');
  const stages = document.querySelectorAll('.guide-stage');
  const playerTitle = document.getElementById('player-title');
  const playerBadge = document.getElementById('player-badge');
  const descTitle = document.getElementById('step-desc-title');
  const descText = document.getElementById('step-desc-text');
  const stepCounter = document.getElementById('step-counter');
  const btnPrev = document.getElementById('btn-prev-step') as HTMLButtonElement | null;
  const btnNext = document.getElementById('btn-next-step') as HTMLButtonElement | null;

  const CYCLE_MS = 8000;
  let stepStartTime = performance.now();

  function setStep(stepNum: number) {
    if (stepNum < 1) stepNum = 1;
    if (stepNum > STEPS.length) stepNum = STEPS.length;
    currentStep = stepNum;
    stepStartTime = performance.now();

    const data = STEPS[stepNum - 1];

    // Update buttons (grid-friendly, never triggering horizontal scrollbars)
    tabBtns.forEach((btn) => {
      const s = Number((btn as HTMLElement).dataset.step);
      const isColSpan = s === 5 ? ' col-span-2 sm:col-span-1' : '';
      const baseBtnClass = `h-10 px-2 sm:px-2.5 rounded-xl text-[11px] sm:text-[12px] transition-all cursor-pointer flex items-center justify-center gap-1.5 w-full text-center${isColSpan}`;
      const badge = btn.querySelector('.step-num-badge');

      if (s === stepNum) {
        if (s === 5) {
          btn.className = `${baseBtnClass} font-black bg-[#e11d48] text-white shadow-xs`;
          if (badge) badge.className = 'step-num-badge w-5 h-5 rounded-full bg-white text-[#e11d48] text-[10px] flex items-center justify-center font-black shrink-0';
        } else {
          btn.className = `${baseBtnClass} font-black bg-[#19C37D] text-[#132A22] shadow-xs`;
          if (badge) badge.className = 'step-num-badge w-5 h-5 rounded-full bg-[#132A22] text-white text-[10px] flex items-center justify-center font-black shrink-0';
        }
      } else {
        if (s === 5) {
          btn.className = `${baseBtnClass} font-extrabold bg-[#fff1f2] hover:bg-[#ffe4e6] text-[#e11d48]`;
          if (badge) badge.className = 'step-num-badge w-5 h-5 rounded-full bg-[#f43f5e] text-white text-[10px] flex items-center justify-center font-black shrink-0';
        } else {
          btn.className = `${baseBtnClass} font-extrabold bg-[#f6f3ee] hover:bg-[#eee9df] text-[#78716c]`;
          if (badge) badge.className = 'step-num-badge w-5 h-5 rounded-full bg-[#d6cfc3] text-[#132A22] text-[10px] flex items-center justify-center font-black shrink-0';
        }
      }
    });

    // Update stages & sync CSS animations to start from t=0
    stages.forEach((stage) => {
      const s = Number((stage as HTMLElement).dataset.stage);
      const isTarget = s === stepNum;
      stage.classList.toggle('hidden', !isTarget);
      if (isTarget) {
        const animEls = stage.querySelectorAll<HTMLElement>('[class*="anim-"], .code-track-scroll');
        animEls.forEach((el) => {
          el.style.animation = 'none';
          void el.offsetHeight; // trigger reflow
          el.style.animation = '';
        });
      }
    });

    // OS Switcher visibility: ONLY on steps 2 and 3 (keeps reserved slot on steps 1, 4, 5 to prevent horizontal movement)
    const osSwitcher = document.getElementById('os-switcher');
    if (osSwitcher) {
      const showOs = (stepNum === 2 || stepNum === 3);
      if (showOs) {
        osSwitcher.classList.remove('invisible', 'opacity-0', 'pointer-events-none');
        osSwitcher.classList.add('opacity-100', 'pointer-events-auto');
      } else {
        osSwitcher.classList.add('invisible', 'opacity-0', 'pointer-events-none');
        osSwitcher.classList.remove('opacity-100', 'pointer-events-auto');
      }
    }

    // Texts
    if (playerTitle) playerTitle.textContent = data.title;
    if (playerBadge) playerBadge.textContent = data.badge;
    if (descTitle) descTitle.textContent = data.title;
    if (descText) descText.textContent = data.text;
    if (stepCounter) stepCounter.textContent = `${stepNum} / ${STEPS.length}`;

    if (btnPrev) btnPrev.disabled = stepNum === 1;
    if (btnNext) btnNext.textContent = stepNum === STEPS.length ? 'В начало ↺' : 'Далее →';
  }

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const s = Number((btn as HTMLElement).dataset.step);
      setStep(s);
    });
  });

  btnPrev?.addEventListener('click', () => setStep(currentStep - 1));
  btnNext?.addEventListener('click', () => {
    if (currentStep === STEPS.length) {
      setStep(1);
    } else {
      setStep(currentStep + 1);
    }
  });

  // SYNCHRONIZED AUTO-TYPE ANIMATIONS (8000ms cycle)
  const typeSearchEl = document.querySelector('.anim-type-search');
  const typeNewPhoneEl = document.querySelector('.anim-typed-new-phone');

  const searchTarget = '+7 900 123-45-67';
  const newPhoneTarget = '+7 999 555-44-33';

  function animateTyping(now: number) {
    if (!document.getElementById('guide-step-tabs')) return;
    const elapsed = (now - stepStartTime) % CYCLE_MS;

    // STEP 2: SEARCH TYPING (Starts at 2200ms after keys press & box appearance, finishes at 4200ms)
    if (typeSearchEl) {
      if (elapsed < 2200) {
        typeSearchEl.textContent = '';
      } else if (elapsed >= 2200 && elapsed < 4200) {
        const progress = (elapsed - 2200) / (4200 - 2200);
        const chars = Math.floor(progress * searchTarget.length);
        typeSearchEl.textContent = searchTarget.slice(0, chars) + '▌';
      } else if (elapsed >= 4200 && elapsed < 7500) {
        typeSearchEl.textContent = searchTarget;
      } else {
        typeSearchEl.textContent = '';
      }
    }

    // STEP 3: NEW NUMBER TYPING (Erases from 800ms-1800ms, types new from 1800ms-3400ms)
    if (typeNewPhoneEl) {
      if (elapsed < 800) {
        typeNewPhoneEl.textContent = searchTarget;
      } else if (elapsed >= 800 && elapsed < 1800) {
        const progress = (elapsed - 800) / (1800 - 800);
        const charsRemaining = Math.max(0, Math.floor((1 - progress) * searchTarget.length));
        typeNewPhoneEl.textContent = searchTarget.slice(0, charsRemaining) + '▌';
      } else if (elapsed >= 1800 && elapsed < 3400) {
        const progress = (elapsed - 1800) / (3400 - 1800);
        const chars = Math.floor(progress * newPhoneTarget.length);
        typeNewPhoneEl.textContent = newPhoneTarget.slice(0, chars) + '▌';
      } else if (elapsed >= 3400 && elapsed < 7400) {
        typeNewPhoneEl.textContent = newPhoneTarget;
      } else {
        typeNewPhoneEl.textContent = searchTarget;
      }
    }

    requestAnimationFrame(animateTyping);
  }

  requestAnimationFrame(animateTyping);

  // OS SWITCHER LOGIC (Windows / Linux & macOS)
  const osBtns = document.querySelectorAll('#os-switcher button[data-os]');
  let currentOS = 'pc';

  function setOS(os: string) {
    currentOS = os;
    osBtns.forEach((btn) => {
      const isTarget = (btn as HTMLElement).dataset.os === os;
      if (isTarget) {
        btn.className = 'os-tab-btn active px-3 py-1 rounded-lg transition-all flex items-center gap-1.5 bg-[#19C37D] text-[#132A22] font-black shadow-xs cursor-pointer';
      } else {
        btn.className = 'os-tab-btn px-3 py-1 rounded-lg transition-all flex items-center gap-1.5 text-white/70 hover:text-white font-semibold cursor-pointer';
      }
    });

    const isMac = os === 'mac';
    const firstKeyText = isMac ? 'Cmd ⌘' : 'Ctrl';
    const osLabelText = isMac ? 'для macOS' : 'для Windows / Linux';

    const step2Key = document.querySelector('.step2-first-key');
    const step2Label = document.querySelector('.step2-os-label');
    if (step2Key) step2Key.textContent = firstKeyText;
    if (step2Label) step2Label.textContent = osLabelText;

    const step3Key = document.querySelector('.step3-first-key');
    const step3Label = document.querySelector('.step3-os-label');
    if (step3Key) step3Key.textContent = firstKeyText;
    if (step3Label) step3Label.textContent = osLabelText;
  }

  osBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const os = (btn as HTMLElement).dataset.os;
      if (os) setOS(os);
    });
  });

  // ==========================================
  // CMS INTERACTIVE SIMULATOR CONTROLLER
  // ==========================================
  let currentCms = 'tilda';
  let currentCmsStep = 1;

  const cmsTabs = document.querySelectorAll<HTMLButtonElement>('#cms-tabs button[data-cms]');
  const cmsStepTabs = document.querySelectorAll<HTMLButtonElement>('#cms-step-tabs button[data-cms-step]');

  const cmsPlayerPlatformPill = document.getElementById('cms-player-platform-pill');
  const cmsPlayerPlatformDot = document.getElementById('cms-player-platform-dot');
  const cmsPlayerPlatformName = document.getElementById('cms-player-platform-name');
  const cmsPlayerHeaderTitle = document.getElementById('cms-player-header-title');

  const cmsInfoBadge = document.getElementById('cms-info-badge');
  const cmsInfoTitle = document.getElementById('cms-info-title');
  const cmsInfoDesc = document.getElementById('cms-info-desc');
  const cmsInfoTip = document.getElementById('cms-info-tip');
  const cmsStepCounter = document.getElementById('cms-step-counter');

  const cmsPrevBtn = document.getElementById('cms-prev-btn') as HTMLButtonElement | null;
  const cmsNextBtn = document.getElementById('cms-next-btn') as HTMLButtonElement | null;
  const cmsCopyTestBtn = document.getElementById('cms-copy-test-btn');
  const cmsCopyBtnText = document.getElementById('cms-copy-btn-text');
  const cmsVisualStage = document.getElementById('cms-visual-stage');

