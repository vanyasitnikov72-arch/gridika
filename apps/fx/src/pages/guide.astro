        <div class="flex-1 p-3.5 flex flex-col justify-between overflow-hidden">
          <div class="p-2.5 rounded-lg bg-[#111f18] border border-[#1f4030] flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="px-2 py-0.5 rounded text-[10.5px] font-black text-white" style="background-color: ${brand};">
                ${guide.iconLabel}
              </span>
              <span class="text-[12px] font-bold text-white">${step.mockHeadline}</span>
            </div>
            <span class="text-[11px] text-white/40 font-mono">${step.mockSub}</span>
          </div>
          <div class="my-2 p-3.5 rounded-xl bg-[#0e1c15] border-2 border-[#19C37D]/40 relative overflow-hidden">
            <div class="flex items-center justify-between mb-2 pb-2 border-b border-white/10">
              <span class="text-[11px] font-bold text-[#86efac] flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-[#19C37D]"></span>
                <span>${step.mockBadge}</span>
              </span>
              <div class="relative">
                <button type="button" class="px-3 py-1 rounded text-[11px] font-black text-white anim-cms-glow cursor-pointer" style="background-color: ${brand};">
                  ${step.mockButton}
