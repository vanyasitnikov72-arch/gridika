---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import WidgetCrossLinks from '../components/sections/WidgetCrossLinks.astro';
import { EFFECT_GUIDES } from '../engine/effectGuides';
import { PRODUCTS } from '../data/products';
import { CMS_GUIDES } from '../engine/cmsGuides';

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Главная',
      item: 'https://gridika.ru/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Гайд: как изменить и установить код',
      item: 'https://gridika.ru/guide',
    },
  ],
};
---

<Layout
  title="Интерактивный гайд: как изменить и установить 3D-код — Gridika"
  description="Пошаговая интерактивная инструкция: как открыть код в любом редакторе, найти строки через Ctrl+F, заменить текст и контакты, и как установить код на Tilda, WordPress, Webflow, Wix."
  structuredData={breadcrumbs}
>
  {/* TOP FLOATING NAVBAR */}
  <Navbar />

  <main class="flex-1 max-w-5xl mx-auto w-full px-4 sm:px-6 pt-4 sm:pt-6 pb-8 sm:pb-12">
    
    {/* HERO HEADER */}
    <div class="text-center max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#DFF8EB] text-[#0f5c3c] text-[12px] font-extrabold mb-3 shadow-xs">
        <svg class="w-3.5 h-3.5 text-[#19C37D] animate-pulse" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
        </svg>
        <span>Интерактивная база знаний</span>
      </div>
      <h1 class="text-[32px] sm:text-[44px] font-black text-[#132A22] tracking-tight leading-[1.08]">
        Как установить код и изменить данные
      </h1>
      <p class="mt-3 text-[15px] sm:text-[17px] font-semibold text-[#6b645c] leading-relaxed">
        Купленный код ваш навсегда. Выберите вашу CMS для быстрой установки на сайт, а затем воспользуйтесь интерактивным тренажёром для редактирования контактов в коде.
      </p>
    </div>

    {/* ======================================================== */}
    {/* SECTION 1: INTERACTIVE CMS INSTALLATION (TILDA, WP, ETC) */}
    {/* ======================================================== */}
    <section id="install" class="mt-10 sm:mt-12 bg-white rounded-[28px] border border-[#ece6da] p-4 sm:p-8 shadow-[0_20px_50px_-25px_rgba(19,42,34,0.12)]">
      
      <div class="text-center max-w-xl mx-auto mb-6">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#f6f3ee] text-[#78716c] text-[11px] font-black uppercase tracking-wider mb-2">
          <span>Часть 1: Инструкция по установке</span>
        </div>
        <h2 class="text-[26px] sm:text-[32px] font-black text-[#132A22] tracking-tight">
          Как установить код на ваш сайт
        </h2>
        <p class="text-[13.5px] text-[#78716c] font-semibold mt-1">
          Выберите вашу CMS или конструктор для пошаговой инструкции:
        </p>
      </div>

      {/* CMS SELECTOR TABS */}
      <div class="flex items-center justify-center gap-2 flex-wrap" id="cms-tabs">
        <button type="button" data-cms="tilda" class="h-10 px-4 rounded-xl text-[12.5px] font-black transition-all cursor-pointer bg-[#132A22] text-[#19C37D] shadow-sm flex items-center gap-2">
          <span class="w-5 h-5 rounded-md bg-[#ff5f56]/20 text-[#ff5f56] flex items-center justify-center font-black text-[11px]">T</span>
          <span>Tilda (Тильда)</span>
        </button>
        <button type="button" data-cms="wordpress" class="h-10 px-4 rounded-xl text-[12.5px] font-bold transition-all cursor-pointer bg-white hover:bg-[#f6f3ee] text-[#132A22] border border-[#e5dfd2] flex items-center gap-2">
          <span class="w-5 h-5 rounded-md bg-[#3b82f6]/20 text-[#3b82f6] flex items-center justify-center font-black text-[11px]">W</span>
          <span>WordPress</span>
        </button>
        <button type="button" data-cms="webflow" class="h-10 px-4 rounded-xl text-[12.5px] font-bold transition-all cursor-pointer bg-white hover:bg-[#f6f3ee] text-[#132A22] border border-[#e5dfd2] flex items-center gap-2">
          <span class="w-5 h-5 rounded-md bg-[#10b981]/20 text-[#10b981] flex items-center justify-center font-black text-[10px]">Wf</span>
          <span>Webflow</span>
        </button>
        <button type="button" data-cms="wix" class="h-10 px-4 rounded-xl text-[12.5px] font-bold transition-all cursor-pointer bg-white hover:bg-[#f6f3ee] text-[#132A22] border border-[#e5dfd2] flex items-center gap-2">
          <span class="w-5 h-5 rounded-md bg-[#8b5cf6]/20 text-[#8b5cf6] flex items-center justify-center font-black text-[10px]">Wx</span>
          <span>Wix</span>
        </button>
        <button type="button" data-cms="html" class="h-10 px-4 rounded-xl text-[12.5px] font-bold transition-all cursor-pointer bg-white hover:bg-[#f6f3ee] text-[#132A22] border border-[#e5dfd2] flex items-center gap-2">
          <span class="w-5 h-5 rounded-md bg-[#f59e0b]/20 text-[#f59e0b] flex items-center justify-center font-mono font-black text-[10px]">&lt;/&gt;</span>
          <span>Чистый HTML</span>
        </button>
      </div>

      {/* CMS STEP SELECTOR TABS (4 STEPS) */}
      <div class="mt-4 grid grid-cols-2 sm:grid-cols-4 gap-2 select-none" id="cms-step-tabs">
        <button type="button" data-cms-step="1" class="h-10 px-3 rounded-xl text-[11.5px] sm:text-[12.5px] font-black transition-all cursor-pointer bg-[#19C37D] text-[#132A22] shadow-xs flex items-center justify-center gap-2 w-full text-center">
          <span class="cms-step-badge w-5 h-5 rounded-full bg-[#132A22] text-white text-[10px] flex items-center justify-center font-black shrink-0">1</span>
          <span class="cms-step-tab-label truncate">1. Блок T123</span>
        </button>
        <button type="button" data-cms-step="2" class="h-10 px-3 rounded-xl text-[11.5px] sm:text-[12.5px] font-extrabold transition-all cursor-pointer bg-[#f6f3ee] hover:bg-[#eee9df] text-[#78716c] flex items-center justify-center gap-2 w-full text-center">
          <span class="cms-step-badge w-5 h-5 rounded-full bg-[#d6cfc3] text-[#132A22] text-[10px] flex items-center justify-center font-black shrink-0">2</span>
          <span class="cms-step-tab-label truncate">2. Кнопка «Контент»</span>
        </button>
        <button type="button" data-cms-step="3" class="h-10 px-3 rounded-xl text-[11.5px] sm:text-[12.5px] font-extrabold transition-all cursor-pointer bg-[#f6f3ee] hover:bg-[#eee9df] text-[#78716c] flex items-center justify-center gap-2 w-full text-center">
          <span class="cms-step-badge w-5 h-5 rounded-full bg-[#d6cfc3] text-[#132A22] text-[10px] flex items-center justify-center font-black shrink-0">3</span>
          <span class="cms-step-tab-label truncate">3. Вставка 3D-кода</span>
        </button>
        <button type="button" data-cms-step="4" class="h-10 px-3 rounded-xl text-[11.5px] sm:text-[12.5px] font-extrabold transition-all cursor-pointer bg-[#f6f3ee] hover:bg-[#eee9df] text-[#78716c] flex items-center justify-center gap-2 w-full text-center">
          <span class="cms-step-badge w-5 h-5 rounded-full bg-[#d6cfc3] text-[#132A22] text-[10px] flex items-center justify-center font-black shrink-0">4</span>
          <span class="cms-step-tab-label truncate">4. Публикация</span>
        </button>
      </div>

      {/* CMS INTERACTIVE SIMULATOR PLAYER */}
      <div class="mt-4 rounded-2xl bg-[#0d1713] border border-[#1b382b] overflow-hidden shadow-2xl">
        {/* PLAYER HEADER */}
        <div class="px-4 py-3 bg-[#08120d] border-b border-[#1b382b] flex items-center justify-between gap-3">
          <div class="flex items-center gap-2.5 min-w-0">
            <div class="flex items-center gap-1.5 shrink-0">
              <span class="w-2.5 h-2.5 rounded-full bg-[#ef4444]"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#f59e0b]"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#10b981]"></span>
            </div>
            <div id="cms-player-platform-pill" class="px-2.5 py-0.5 rounded-md bg-[#ff5f56]/20 text-[#ff5f56] font-black text-[11px] flex items-center gap-1.5 shrink-0">
              <span id="cms-player-platform-dot" class="w-2 h-2 rounded-full bg-[#ff5f56]"></span>
              <span id="cms-player-platform-name">Tilda (Тильда)</span>
            </div>
            <span class="text-white/30 hidden sm:inline">•</span>
            <span id="cms-player-header-title" class="text-white/80 font-bold text-[12px] sm:text-[12.5px] truncate">
              Шаг 1 из 4: Выбор блока
            </span>
          </div>
        </div>

        {/* PLAYER MAIN BODY (2 COLUMNS) */}
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 p-4 sm:p-6 items-stretch">
          
          {/* LEFT COLUMN: INSTRUCTIONS & CONTROLS */}
          <div class="lg:col-span-5 flex flex-col justify-between space-y-4">
            <div>
              <div class="flex items-center gap-2">
                <span id="cms-info-badge" class="px-2.5 py-0.5 rounded-md bg-[#19C37D]/20 text-[#19C37D] text-[10.5px] font-mono font-black uppercase tracking-wider">
                  Шаг 1 из 4: Выбор блока
                </span>
              </div>

              <h3 id="cms-info-title" class="mt-2 text-[19px] sm:text-[21px] font-black text-white leading-tight">
                Добавьте блок T123 (HTML-код)
              </h3>

              <p id="cms-info-desc" class="mt-2 text-[12.5px] sm:text-[13px] text-[#9ca3af] leading-relaxed">
                В библиотеке блоков Тильды прокрутите левое меню вниз до категории «Другое» и выберите стандартный блок «HTML-код» (T123). Он появится в выбранном месте страницы.
              </p>

              {/* PRO TIP BOX */}
              <div class="mt-3.5 p-3 rounded-xl bg-[#142820] border border-[#1f4534] text-[12px] text-[#86efac] leading-relaxed flex items-start gap-2.5">
                <svg class="w-4 h-4 text-[#19C37D] shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="12" y1="16" x2="12" y2="12"></line>
                  <line x1="12" y1="8" x2="12.01" y2="8"></line>
                </svg>
                <div id="cms-info-tip" class="font-medium">
                  Блок T123 доступен на тарифах Personal и Business. Если у вас несколько 3D-эффектов — каждый вставляется в свой отдельный блок T123.
                </div>
              </div>

              {/* COPY TEST CODE BUTTON (Interactive feature) */}
              <div id="cms-copy-box" class="mt-3">
                <button id="cms-copy-test-btn" type="button" class="w-full py-2.5 px-3.5 rounded-xl bg-[#19C37D] hover:bg-[#16a366] text-[#081d14] font-black text-[12px] flex items-center justify-center gap-2 transition-all shadow-md active:scale-[0.98] cursor-pointer">
                  <svg id="cms-copy-icon" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                  <span id="cms-copy-btn-text">Скопировать тестовый 3D-код</span>
                </button>
                <p class="mt-2 text-[11px] text-[#9ca3af] leading-snug">
                  💡 Вставьте тестовый код на черновик, покажите заказчику для согласования, а чистый код купите после утверждения проекта.
                </p>
              </div>
            </div>

            {/* STEPPER NAVIGATION CONTROLS */}
            <div class="pt-3 border-t border-[#1b382b] flex items-center justify-between">
              <button id="cms-prev-btn" type="button" class="h-9 px-3.5 rounded-xl bg-[#132a22] hover:bg-[#1a382e] text-[#19C37D] border border-[#1b382b] text-[12px] font-bold transition-all disabled:opacity-30 disabled:pointer-events-none cursor-pointer flex items-center gap-1.5">
                <span>←</span>
                <span>Назад</span>
              </button>
              
              <span id="cms-step-counter" class="text-[12px] font-mono font-bold text-white/50">
                1 / 4
              </span>

              <button id="cms-next-btn" type="button" class="h-9 px-4 rounded-xl bg-[#19C37D] hover:bg-[#16a366] text-[#081d14] text-[12px] font-black transition-all cursor-pointer flex items-center gap-1.5 shadow-sm">
                <span>Далее</span>
                <span>→</span>
              </button>
            </div>
          </div>

          {/* RIGHT COLUMN: INTERACTIVE VISUAL CMS SIMULATION STAGE */}
          <div class="lg:col-span-7 flex flex-col">
            <div id="cms-visual-stage" class="relative w-full h-[320px] sm:h-[340px] rounded-xl bg-[#09100d] border border-[#1b382b] overflow-hidden flex flex-col select-none">
              {/* Dynamically populated by JS based on current CMS & Step */}
            </div>
          </div>

        </div>

      </div>

      {/* CMS INSTALLATION QUICK FAQ / TIPS */}
      <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-3">
        <div class="p-3.5 rounded-2xl bg-[#FAF8F5] border border-[#ece6da]">
          <div class="flex items-center gap-2 font-black text-[#132A22] text-[13px]">
            <span class="w-6 h-6 rounded-lg bg-[#19C37D]/15 text-[#19C37D] flex items-center justify-center font-black text-[11px]">1</span>
            <span>Несколько 3D-виджетов</span>
          </div>
          <p class="mt-1.5 text-[12px] text-[#78716c] leading-relaxed">
            Если на одной странице нужно несколько эффектов — каждый вставляется в свой блок HTML. Движок автоматически оптимизирует общую память.
          </p>
        </div>

        <div class="p-3.5 rounded-2xl bg-[#FAF8F5] border border-[#ece6da]">
          <div class="flex items-center gap-2 font-black text-[#132A22] text-[13px]">
            <span class="w-6 h-6 rounded-lg bg-[#19C37D]/15 text-[#19C37D] flex items-center justify-center font-black text-[11px]">2</span>
            <span>Скорость сайта (PageSpeed)</span>
          </div>
          <p class="mt-1.5 text-[12px] text-[#78716c] leading-relaxed">
            Скрипт весит всего ~45 КБ и загружается асинхронно, не блокируя основной контент и сохраняя зелёную зону Google PageSpeed.
          </p>
        </div>

        <div class="p-3.5 rounded-2xl bg-[#FAF8F5] border border-[#ece6da]">
          <div class="flex items-center gap-2 font-black text-[#132A22] text-[13px]">
            <span class="w-6 h-6 rounded-lg bg-[#19C37D]/15 text-[#19C37D] flex items-center justify-center font-black text-[11px]">3</span>
            <span>Мобильные устройства</span>
          </div>
          <p class="mt-1.5 text-[12px] text-[#78716c] leading-relaxed">
            Все эффекты поддерживают touch-жесты, автоматически подстраиваются под ширину экрана смартфона и плавно работают на iOS и Android.
          </p>
        </div>
      </div>
    </section>

    {/* ======================================================== */}
    {/* SECTION 2: INTERACTIVE STEPPER FOR EDITING CODE           */}
    {/* ======================================================== */}
    <section class="mt-12 sm:mt-16 bg-white rounded-[28px] border border-[#ece6da] p-4 sm:p-8 shadow-[0_20px_50px_-25px_rgba(19,42,34,0.12)]">
      
      {/* SECTION HEADER */}
      <div class="text-center max-w-xl mx-auto mb-6">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#f6f3ee] text-[#78716c] text-[11px] font-black uppercase tracking-wider mb-2">
          <span>Часть 2: Инструкция по изменению текста</span>
        </div>
        <h2 class="text-[26px] sm:text-[32px] font-black text-[#132A22] tracking-tight">
          Как изменить текст и контакты в коде
        </h2>
        <p class="text-[13.5px] text-[#78716c] font-semibold mt-1">
          Интерактивный плеер: пошагово откройте файл в редакторе, найдите нужную строку и сохраните результат:
        </p>
      </div>

      {/* STEP TABS (5 STEPS) - RESPONSIVE GRID WITHOUT HORIZONTAL SCROLLBAR */}
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-1.5 sm:gap-2 select-none" id="guide-step-tabs">
        <button type="button" data-step="1" class="h-10 px-2 sm:px-2.5 rounded-xl text-[11px] sm:text-[12px] font-black transition-all cursor-pointer bg-[#19C37D] text-[#132A22] shadow-xs flex items-center justify-center gap-1.5 w-full text-center">
          <span class="step-num-badge w-5 h-5 rounded-full bg-[#132A22] text-white text-[10px] flex items-center justify-center font-black shrink-0">1</span>
          <span class="truncate">Открыть файл</span>
        </button>
        <button type="button" data-step="2" class="h-10 px-2 sm:px-2.5 rounded-xl text-[11px] sm:text-[12px] font-extrabold transition-all cursor-pointer bg-[#f6f3ee] hover:bg-[#eee9df] text-[#78716c] flex items-center justify-center gap-1.5 w-full text-center">
          <span class="step-num-badge w-5 h-5 rounded-full bg-[#d6cfc3] text-[#132A22] text-[10px] flex items-center justify-center font-black shrink-0">2</span>
          <span class="truncate">Найти (Ctrl+F)</span>
        </button>
        <button type="button" data-step="3" class="h-10 px-2 sm:px-2.5 rounded-xl text-[11px] sm:text-[12px] font-extrabold transition-all cursor-pointer bg-[#f6f3ee] hover:bg-[#eee9df] text-[#78716c] flex items-center justify-center gap-1.5 w-full text-center">
          <span class="step-num-badge w-5 h-5 rounded-full bg-[#d6cfc3] text-[#132A22] text-[10px] flex items-center justify-center font-black shrink-0">3</span>
          <span class="truncate">Заменить (Ctrl+S)</span>
        </button>
        <button type="button" data-step="4" class="h-10 px-2 sm:px-2.5 rounded-xl text-[11px] sm:text-[12px] font-extrabold transition-all cursor-pointer bg-[#f6f3ee] hover:bg-[#eee9df] text-[#78716c] flex items-center justify-center gap-1.5 w-full text-center">
          <span class="step-num-badge w-5 h-5 rounded-full bg-[#d6cfc3] text-[#132A22] text-[10px] flex items-center justify-center font-black shrink-0">4</span>
          <span class="truncate">На сайте</span>
        </button>
        <button type="button" data-step="5" class="h-10 px-2 sm:px-2.5 rounded-xl text-[11px] sm:text-[12px] font-extrabold transition-all cursor-pointer bg-[#fff1f2] hover:bg-[#ffe4e6] text-[#e11d48] flex items-center justify-center gap-1.5 w-full text-center col-span-2 sm:col-span-1">
          <span class="step-num-badge w-5 h-5 rounded-full bg-[#f43f5e] text-white text-[10px] flex items-center justify-center font-black shrink-0">5</span>
          <span class="truncate">Смена QR-ссылки</span>
        </button>
      </div>

      {/* VIDEO / VISUAL DEMO STAGE */}
      <div class="mt-5 rounded-2xl border border-[#ece6da] overflow-hidden bg-[#132A22] shadow-inner text-white">
        
        {/* PLAYER TOP BAR - STRICTLY FIXED HEIGHT (52px) & MOTIONLESS ACROSS ALL STEPS */}
        <div class="h-[52px] min-h-[52px] max-h-[52px] px-4 bg-[#0b1b15] border-b border-white/10 flex items-center justify-between gap-3 shrink-0 overflow-hidden">
          <div class="flex items-center gap-2 min-w-0">
            <div class="flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-white/5 border border-white/10 shrink-0">
              <span class="relative flex h-2 w-2 shrink-0">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#19C37D] opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-[#19C37D]"></span>
              </span>
              <span class="text-[10px] font-mono font-bold text-[#8BF0C2] uppercase tracking-wider hidden sm:inline">Интерактивный плеер</span>
            </div>
            <span class="text-white/20 hidden sm:inline">•</span>
            <span id="player-title" class="font-mono text-[12px] text-white/85 font-bold truncate">Шаг 1: Открытие файла в любом редакторе</span>
          </div>

          {/* OS SWITCHER (WINDOWS / LINUX & MACOS) - INVISIBLE (RESERVES SAME WIDTH) ON STEPS 1, 4, 5 */}
          <div class="invisible opacity-0 pointer-events-none inline-flex p-1 rounded-xl bg-white/5 border border-white/10 text-[11px] font-bold shrink-0 transition-opacity duration-200" id="os-switcher">
            <button type="button" data-os="pc" class="os-tab-btn active px-3 py-1 rounded-lg transition-all flex items-center gap-1.5 bg-[#19C37D] text-[#132A22] font-black shadow-xs cursor-pointer">
              <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor">
                <path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.801"/>
              </svg>
              <span>Windows</span>
              <span class="opacity-40 font-normal">/</span>
