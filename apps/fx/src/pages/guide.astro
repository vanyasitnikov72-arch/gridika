                        </li>
                      ))}
                    </ul>
                  </div>

                  <div class="mt-4 pt-3 border-t border-[#d2f3e3] text-[11px] text-[#0f5c3c] font-semibold flex items-center gap-2">
                    <svg class="w-4 h-4 text-[#19C37D] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"></circle>
                      <line x1="12" y1="16" x2="12" y2="12"></line>
                      <line x1="12" y1="8" x2="12.01" y2="8"></line>
                    </svg>
                    <span>Нажмите <kbd class="px-1.5 py-0.5 rounded bg-white border text-[10px] font-mono font-bold shadow-xs">Ctrl+F</kbd> в редакторе, найдите название параметра и впишите своё значение.</span>
                  </div>
                </div>

                {/* CANNOT EDIT (AMBER / RED) */}
                <div class="rounded-2xl bg-[#FFF9ED] border border-[#fdecd0] p-4 sm:p-5 flex flex-col justify-between">
                  <div>
                    <div class="flex items-center justify-between">
                      <div class="flex items-center gap-2 text-[13.5px] font-black text-[#991b1b]">
                        <span class="w-5 h-5 rounded-full bg-[#ef4444] text-white flex items-center justify-center shrink-0 shadow-xs">
                          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                          </svg>
                        </span>
                        <span>Что НЕЛЬЗЯ менять вручную в коде:</span>
                      </div>
                      <span class="hidden sm:inline-flex items-center gap-1 text-[10px] font-extrabold text-[#ef4444] bg-[#fee2e2] px-2 py-0.5 rounded-full">
                        защищено 3D
                      </span>
                    </div>
                    <p class="text-[11.5px] text-[#7f1d1d]/85 mt-1">Эти части встроены в трёхмерную модель — ручная правка сломает сцену</p>

                    {/* Specific forbidden list with code snippet boxes */}
                    <div class="mt-3.5 space-y-3">
                      {(g.forbiddenItems || []).map((item) => (
                        <div class="p-3.5 rounded-xl bg-white border border-[#fecaca] shadow-xs">
                          <div class="flex items-center justify-between gap-2 mb-1.5">
                            <div class="flex items-center gap-1.5 font-bold text-[#991b1b] text-[12px]">
                              <svg class="w-3.5 h-3.5 text-[#ef4444] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
