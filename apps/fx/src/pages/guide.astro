          <div class="p-3 rounded-lg bg-[#050b08] border border-[#183628] font-mono text-[11px] sm:text-[11.5px] leading-relaxed select-text overflow-hidden">
            <div class="text-white/40 mb-1">// Вставка автономного 3D-кода Gridika:</div>
            <div class="flex items-start gap-2">
              <span class="text-white/30 select-none">1</span>
              <span class="text-[#f59e0b]">&lt;<span class="text-[#ef4444]">div</span> <span class="text-[#38bdf8]">id</span>=<span class="text-[#86efac]">"gridika-widget"</span>&gt;&lt;/<span class="text-[#ef4444]">div</span>&gt;</span>
            </div>
            <div class="flex items-start gap-2">
              <span class="text-white/30 select-none">2</span>
              <span class="text-[#f59e0b]">&lt;<span class="text-[#ef4444]">script</span> <span class="text-[#38bdf8]">src</span>=<span class="text-[#86efac]">"https://cdnjs.cloudflare.com/.../three.min.js"</span>&gt;&lt;/<span class="text-[#ef4444]">script</span>&gt;</span>
            </div>
            <div class="flex items-start gap-2">
              <span class="text-white/30 select-none">3</span>
              <span class="text-[#f59e0b]">&lt;<span class="text-[#ef4444]">script</span>&gt;<span class="text-white/50">/* 3D-сцена инициализируется сама */</span>&lt;/<span class="text-[#ef4444]">script</span>&gt;</span>
            </div>
          </div>
          <div class="mt-2.5 pt-2 border-t border-[#183628] flex items-center justify-between">
            <div class="text-[11px] text-white/50 flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-[#19C37D]"></span>
              <span>Код валиден • Ready</span>
            </div>
            <div class="relative">
              <button type="button" class="px-4 py-1.5 rounded-lg text-[11.5px] font-black text-white anim-cms-glow shadow-md cursor-pointer" style="background-color: ${brand};">
                ${step.mockButton}
              </button>
              <div class="absolute -right-2 -bottom-2 z-10 anim-cms-cursor pointer-events-none">
                <svg class="w-5 h-5 text-white drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M4 0l16 12.279-6.951 1.17 4.325 8.817-3.596 1.734-4.35-8.879-5.428 5.428z"/>
                </svg>
              </div>
            </div>
          </div>
        </div>
      `;
      return;
    }

    // STEP 4: PUBLISHED RESULT
    const cleanBadge = (step.mockBadge || '').replace(/^[✓✔\s]+/, '');
    cmsVisualStage.innerHTML = `
      <div class="px-3.5 py-2 bg-[#0d1813] border-b border-[#1b382b] flex items-center justify-between text-[11px] text-white/60">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#10b981]"></span>
          <span class="font-mono text-white/80">https://vash-sait.ru</span>
        </div>
        <div class="flex items-center gap-1.5 px-2.5 py-0.5 rounded bg-emerald-500/20 text-[#19C37D] text-[10.5px] font-bold">
          <span>✓ ${cleanBadge}</span>
        </div>
      </div>
      <div class="flex-1 p-3.5 flex flex-col items-center justify-center relative overflow-hidden bg-gradient-to-b from-[#0a1711] to-[#040806]">
        <div class="anim-cms-float relative w-56 sm:w-60 h-32 sm:h-34 rounded-2xl bg-gradient-to-br from-[#1b3f30] via-[#12281e] to-[#0a1610] border border-[#19C37D]/50 shadow-[0_14px_34px_rgba(25,195,125,0.28)] flex flex-col justify-between p-3.5 overflow-hidden">
          <div class="absolute inset-0 w-1/3 bg-gradient-to-r from-transparent via-white/20 to-transparent skew-x-[-20deg] anim-card-shine pointer-events-none"></div>
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-[#19C37D]"></span>
              <span class="text-[10.5px] font-black tracking-wider uppercase text-[#19C37D]">Gridika 3D</span>
            </div>
            <span class="text-[9.5px] px-2 py-0.5 rounded-full bg-white/10 text-white/80 font-mono font-bold">LIVE</span>
          </div>
          <div class="my-auto text-center py-0.5">
            <div class="text-[13.5px] sm:text-[14px] font-black text-white tracking-wide">3D-ВИДЖЕТ АКТИВЕН</div>
            <div class="text-[10.5px] text-[#86efac] font-medium mt-0.5">WebGL • 60 FPS • Интерактив</div>
          </div>
          <div class="flex items-center justify-between text-[9.5px] sm:text-[10px] text-white/60 border-t border-white/10 pt-1.5 whitespace-nowrap">
            <span>Онлайн на сайте</span>
            <span class="text-[#19C37D] font-bold">✓ Работает</span>
          </div>
        </div>
        <div class="mt-3 px-3.5 py-1.5 rounded-full bg-[#19C37D]/15 border border-[#19C37D]/30 text-[11px] sm:text-[11.5px] font-bold text-[#86efac] flex items-center gap-1.5 max-w-[92%]">
          <svg class="w-3.5 h-3.5 text-[#19C37D] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span class="truncate">${step.title}</span>
        </div>
      </div>
    `;
  }

  function updateCmsUI() {
    const guide = CMS_GUIDES[currentCms] || CMS_GUIDES.tilda;
    const step = guide.steps[currentCmsStep - 1] || guide.steps[0];

    // CMS Tabs
    cmsTabs.forEach((btn) => {
      const c = btn.dataset.cms;
      if (c === currentCms) {
        btn.className = 'h-10 px-4 rounded-xl text-[12.5px] font-black transition-all cursor-pointer bg-[#132A22] text-[#19C37D] shadow-sm flex items-center gap-2';
      } else {
        btn.className = 'h-10 px-4 rounded-xl text-[12.5px] font-bold transition-all cursor-pointer bg-white hover:bg-[#f6f3ee] text-[#132A22] border border-[#e5dfd2] flex items-center gap-2';
      }
    });

    // Step Tabs
    cmsStepTabs.forEach((btn, idx) => {
      const s = Number(btn.dataset.cmsStep);
      const isTarget = s === currentCmsStep;
      const stepData = guide.steps[idx];
      const label = btn.querySelector('.cms-step-tab-label');
      const badge = btn.querySelector('.cms-step-badge');
      if (label && stepData) label.textContent = stepData.shortTab;

      if (isTarget) {
        btn.className = 'h-10 px-3 rounded-xl text-[11.5px] sm:text-[12.5px] font-black transition-all cursor-pointer bg-[#19C37D] text-[#132A22] shadow-xs flex items-center justify-center gap-2 w-full text-center';
        if (badge) badge.className = 'cms-step-badge w-5 h-5 rounded-full bg-[#132A22] text-white text-[10px] flex items-center justify-center font-black shrink-0';
      } else {
        btn.className = 'h-10 px-3 rounded-xl text-[11.5px] sm:text-[12.5px] font-extrabold transition-all cursor-pointer bg-[#f6f3ee] hover:bg-[#eee9df] text-[#78716c] flex items-center justify-center gap-2 w-full text-center';
        if (badge) badge.className = 'cms-step-badge w-5 h-5 rounded-full bg-[#d6cfc3] text-[#132A22] text-[10px] flex items-center justify-center font-black shrink-0';
      }
    });

    // Player Header
    if (cmsPlayerPlatformPill) {
      cmsPlayerPlatformPill.className = `px-2.5 py-0.5 rounded-md ${guide.iconBg} ${guide.iconColor} font-black text-[11px] flex items-center gap-1.5 shrink-0`;
    }
    if (cmsPlayerPlatformDot) {
      cmsPlayerPlatformDot.style.backgroundColor = guide.brandColor;
    }
    if (cmsPlayerPlatformName) {
      cmsPlayerPlatformName.textContent = guide.name;
    }
    if (cmsPlayerHeaderTitle) {
      cmsPlayerHeaderTitle.textContent = `${step.badge}: ${step.title}`;
    }

    // Left Column Info
    if (cmsInfoBadge) cmsInfoBadge.textContent = step.badge;
    if (cmsInfoTitle) cmsInfoTitle.textContent = step.title;
    if (cmsInfoDesc) cmsInfoDesc.textContent = step.desc;
    if (cmsInfoTip) cmsInfoTip.textContent = step.tip;
    if (cmsStepCounter) cmsStepCounter.textContent = `${currentCmsStep} / 4`;

    if (cmsPrevBtn) cmsPrevBtn.disabled = currentCmsStep === 1;
    if (cmsNextBtn) cmsNextBtn.textContent = currentCmsStep === 4 ? 'В начало ↺' : 'Далее →';

    // Render Stage
    renderCmsVisualStage(currentCms, currentCmsStep);
  }

  cmsTabs.forEach((btn) => {
    btn.addEventListener('click', () => {
      const c = btn.dataset.cms;
      if (c && c !== currentCms) {
        currentCms = c;
        if (c === 'tilda' && typeof (window as any).ym === 'function') {
          (window as any).ym(114261124, 'reachGoal', 'open_tilda_guide', { source: 'guide_tab' });
        }
        updateCmsUI();
      }
    });
  });

  cmsStepTabs.forEach((btn) => {
    btn.addEventListener('click', () => {
      const s = Number(btn.dataset.cmsStep);
      if (s) {
        currentCmsStep = s;
        updateCmsUI();
      }
    });
  });

  cmsPrevBtn?.addEventListener('click', () => {
    if (currentCmsStep > 1) {
      currentCmsStep--;
      updateCmsUI();
    }
  });

  cmsNextBtn?.addEventListener('click', () => {
    if (currentCmsStep < 4) {
      currentCmsStep++;
    } else {
      currentCmsStep = 1;
    }
    updateCmsUI();
  });

  cmsCopyTestBtn?.addEventListener('click', () => {
    const code = castleSnippet;
    navigator.clipboard.writeText(code).then(() => {
      if (typeof (window as any).trackGoal === 'function') {
        (window as any).trackGoal('copy_test_code');
      } else if (typeof (window as any).ym === 'function') {
        (window as any).ym(114261124, 'reachGoal', 'copy_test_code');
      }
      if (cmsCopyBtnText) {
        const orig = cmsCopyBtnText.textContent;
        cmsCopyBtnText.textContent = '✓ Код скопирован — переходите к шагу 2';
        setTimeout(() => {
          cmsCopyBtnText.textContent = orig;
        }, 3000);
      }
    });
  });

  // Initial render
  updateCmsUI();

  // PRODUCT PILLS FILTER
  const effectPills = document.querySelectorAll('#effect-pills button[data-effect-id]');
  const effectCards = document.querySelectorAll('#effect-details-container [data-effect-card]');

  function selectEffect(id: string) {
    effectPills.forEach((p) => {
      const pId = (p as HTMLElement).dataset.effectId;
      if (pId === id) {
        p.className = 'h-9 px-3.5 rounded-full text-[12px] font-bold transition-all cursor-pointer bg-[#132A22] text-[#19C37D] shadow-sm';
      } else {
        p.className = 'h-9 px-3.5 rounded-full text-[12px] font-bold transition-all cursor-pointer bg-white hover:bg-[#f6f3ee] text-[#132A22] border border-[#e5dfd2]';
      }
    });

    effectCards.forEach((c) => {
      const cId = (c as HTMLElement).dataset.effectCard;
      c.classList.toggle('hidden', cId !== id);
    });
  }

  effectPills.forEach((p) => {
    p.addEventListener('click', () => {
      const id = (p as HTMLElement).dataset.effectId;
      if (id) selectEffect(id);
    });
  });

  // Check URL hash (e.g. /guide#gift-box or /guide#install)
  const hash = window.location.hash.replace('#', '');
  if (hash === 'install') {
    document.getElementById('install')?.scrollIntoView({ behavior: 'smooth' });
  } else if (hash) {
    selectEffect(hash);
  }
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initGuidePage);
} else {
  initGuidePage();
}
document.addEventListener('astro:page-load', initGuidePage);
</script>
