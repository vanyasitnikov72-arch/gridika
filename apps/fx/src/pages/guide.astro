                <div class="absolute -right-2 -bottom-2 z-10 anim-cms-cursor pointer-events-none">
                  <svg class="w-5 h-5 text-white drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M4 0l16 12.279-6.951 1.17 4.325 8.817-3.596 1.734-4.35-8.879-5.428 5.428z"/>
                  </svg>
                </div>
              </div>
            </div>
            <div class="py-4 text-center">
              <div class="text-[12px] font-bold text-white/80">Блок готов к вставке 3D-скрипта</div>
