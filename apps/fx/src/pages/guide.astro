                          </div>

                          {/* Realistic Dark Monospace Code Box - zero scrollbars, compact fit */}
                          <div class="my-2 rounded-lg bg-[#0b130e] border border-[#ef4444]/35 p-2.5 font-mono text-[10.5px] sm:text-[11px] leading-snug select-text overflow-hidden shadow-inner">
                            <div class="flex items-center justify-between text-[9px] text-white/40 pb-1 mb-1.5 border-b border-white/10 font-sans select-none">
                              <span class="flex items-center gap-1.5 text-[#fca5a5] font-semibold">
                                <span class="w-1.5 h-1.5 rounded-full bg-[#ef4444]"></span>
                                <span>Строка в файле effect.html:</span>
                              </span>
                              <span class="text-[#f87171] font-semibold uppercase tracking-wider text-[8.5px] bg-[#ef4444]/15 px-1.5 py-0.5 rounded shrink-0">только для чтения</span>
                            </div>
                            <code class="text-[#fca5a5] font-bold block whitespace-pre-wrap break-all sm:break-normal select-all">{item.codeSnippet}</code>
                          </div>

                          {/* Human explanation */}
                          <div class="text-[11px] text-[#57534e] mt-1.5 leading-snug">
                            {item.desc}
                          </div>

                          {/* Consequence alert */}
                          <div class="mt-2 pt-2 border-t border-[#fecaca]/60 text-[10.5px] text-[#991b1b] flex items-start gap-1.5 bg-[#FFF5F5] p-2 rounded-lg">
                            <svg class="w-3.5 h-3.5 text-[#ef4444] shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                              <circle cx="12" cy="12" r="10"></circle>
                              <line x1="12" y1="8" x2="12" y2="12"></line>
                              <line x1="12" y1="16" x2="12.01" y2="16"></line>
                            </svg>
                            <div>
                              <span class="font-bold">Что произойдёт при изменении: </span>
                              <span class="text-[#7f1d1d]">{item.consequence}</span>
                            </div>
                          </div>
                        </div>
                      ))}
                    </div>

                    {/* Why and Truth */}
                    <div class="mt-3.5 p-3 rounded-xl bg-white/95 border border-[#fdecd0] text-[11px] text-[#78716c] space-y-2 leading-relaxed shadow-xs">
                      <div class="flex items-start gap-2">
                        <svg class="w-4 h-4 text-[#b45309] shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                          <line x1="12" y1="8" x2="12" y2="12"></line>
                          <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                        <div>
                          <span class="text-[#b45309] font-bold">Причина: </span>
                          <span class="text-[#57534e]">{g.breakTarget.brokenWhy}</span>
                        </div>
                      </div>
                      <div class="flex items-start gap-2">
                        <svg class="w-4 h-4 text-[#b45309] shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                          <line x1="12" y1="18" x2="12.01" y2="18"></line>
                        </svg>
                        <div>
                          <span class="text-[#b45309] font-bold">Результат: </span>
                          <span class="text-[#57534e]">{g.breakTarget.cameraTruth}</span>
                        </div>
                      </div>
                    </div>
                  </div>
                  
                  <div class="mt-4 pt-3.5 border-t border-[#fdecd0]">
                    <div class="text-[11.5px] font-bold text-[#b45309] mb-2 flex items-center gap-1.5">
                      <svg class="w-3.5 h-3.5 text-[#b45309] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
                      </svg>
                      <span>Как изменить геометрию или ссылку правильно:</span>
                    </div>
                    <a href={`/?effect=${prod.id}`} class="w-full h-10 rounded-xl bg-[#132A22] hover:bg-[#1d3a2f] text-[#19C37D] font-extrabold text-[12px] flex items-center justify-center gap-2 transition-colors shadow-sm group">
                      <span>{g.studioActionText}</span>
                      <svg class="w-4 h-4 text-[#19C37D] transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                      </svg>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    {/* WIDGET CROSS LINKS */}
    <WidgetCrossLinks currentPath="/guide" />
  </main>

  <Footer />
</Layout>

<style>
  /* ======================================================== */
  /* CSS ANIMATIONS FOR INTERACTIVE CODE EDITING WALKTHROUGH */
  /* ======================================================== */

  /* STEP 1: DESKTOP SIMULATION (8.0s MASTER CYCLE) */
  /* Sequence:
     0% - 14%: Cursor moves smoothly onto effect.html file icon (48px, 50px).
     15% - 32%: Cursor stays on file! Simultaneously, white mouse outside window presses ПКМ with emerald glow, and cursor on file performs right click.
     33%: White mouse fades out.
     34% - 58%: Context menu appears at file (left: 76px, width: 124px).
     37%: Cursor moves onto "Открыть с помощью ▸".
     44% - 58%: Submenu with editors opens to the right (left: 202px, width: 116px, zero overlap!). Cursor moves to "Блокнот" and clicks.
     59%: Menus vanish, cursor vanishes.
     61% - 94%: Code editor window blooms in, displaying opened code (clean, no "готово к поиску").
     96% - 100%: Smooth reset for loop.
  */

  @keyframes step1CursorSequence {
    0%   { transform: translate(220px, 140px); opacity: 0; }
    4%   { opacity: 1; }
    14%  { transform: translate(48px, 50px); opacity: 1; }
    /* CURSOR DOES NOT DISAPPEAR! IT STAYS ON EFFECT.HTML */
    15%, 19% { transform: translate(48px, 50px) scale(1); opacity: 1; }
    21%, 27% { transform: translate(48px, 50px) scale(0.9); opacity: 1; } /* CLICK ON FILE SIMULTANEOUSLY WITH ПКМ */
    29%, 34% { transform: translate(48px, 50px) scale(1); opacity: 1; }
    37%  { transform: translate(128px, 46px); opacity: 1; } /* Moves onto "Открыть с помощью" */
    43%  { transform: translate(128px, 46px); opacity: 1; }
    48%  { transform: translate(246px, 44px); opacity: 1; } /* Moves to "Блокнот" in submenu to the right */
    52%, 56% { transform: translate(246px, 44px) scale(0.9); opacity: 1; } /* Clicks on Блокнот */
    58%  { opacity: 0; transform: translate(246px, 44px); }
    60%, 100% { opacity: 0; transform: translate(220px, 140px); }
  }

  @keyframes clickRippleStep1 {
    0%, 19% { transform: scale(0); opacity: 0; }
    21%     { transform: scale(0.6); opacity: 1; }
    27%     { transform: scale(1.6); opacity: 0; }
    50%     { transform: scale(0); opacity: 0; }
    52%     { transform: scale(0.6); opacity: 1; }
    56%     { transform: scale(1.6); opacity: 0; }
    100%    { opacity: 0; }
  }

  @keyframes step1MouseHardwareFade {
    0%, 13%  { opacity: 0; transform: translateY(8px) scale(0.92); pointer-events: none; }
    16%, 31% { opacity: 1; transform: translateY(0) scale(1); pointer-events: auto; }
    34%, 100%{ opacity: 0; transform: translateY(-6px) scale(0.95); pointer-events: none; }
  }

  @keyframes step1WhiteMouseRClickPress {
    0%, 18%  { transform: translateY(0); background-color: transparent; }
    21%, 29% { transform: translateY(1.5px); background-color: rgba(25, 195, 125, 0.22); border-radius: 0 20px 0 0; box-shadow: 0 0 14px rgba(25, 195, 125, 0.85); }
    32%, 100%{ transform: translateY(0); background-color: transparent; }
  }

  @keyframes step1RClickLabelPop {
    0%, 18%  { opacity: 0.6; transform: scale(0.92); }
    21%, 29% { opacity: 1; transform: scale(1.06); box-shadow: 0 0 14px rgba(25, 195, 125, 0.9); }
    32%, 100%{ opacity: 0.6; transform: scale(0.92); }
  }

  @keyframes step1ContextMenuShow {
    0%, 33%  { opacity: 0; transform: scale(0.92) translateY(4px); pointer-events: none; }
    36%, 58% { opacity: 1; transform: scale(1) translateY(0); pointer-events: auto; }
    60%, 100%{ opacity: 0; transform: scale(0.96); pointer-events: none; }
  }

  @keyframes step1OpenWithHighlight {
    0%, 36%  { background-color: transparent; color: rgba(255,255,255,0.7); }
    39%, 58% { background-color: #19C37D; color: #132A22; }
    60%, 100%{ background-color: transparent; }
  }

  @keyframes step1SubmenuShow {
    0%, 43%  { opacity: 0; transform: scale(0.92) translateY(4px); pointer-events: none; }
    46%, 58% { opacity: 1; transform: scale(1) translateY(0); pointer-events: auto; }
    60%, 100%{ opacity: 0; transform: scale(0.96); pointer-events: none; }
  }

  @keyframes step1NotepadHighlight {
    0%, 47%  { background-color: transparent; color: rgba(255,255,255,0.8); }
    50%, 58% { background-color: #19C37D; color: #132A22; }
    60%, 100%{ background-color: transparent; }
  }

  @keyframes step1EditorBloom {
    0%, 60%  { opacity: 0; transform: scale(0.94) translateY(6px); pointer-events: none; }
    64%, 94% { opacity: 1; transform: scale(1) translateY(0); pointer-events: auto; }
    97%, 100%{ opacity: 0; transform: scale(0.98); pointer-events: none; }
  }

  .anim-cursor-step1 {
    animation: step1CursorSequence 8.0s ease-in-out infinite;
  }
  .anim-click-ripple-step1 {
    animation: clickRippleStep1 8.0s ease-out infinite;
  }
  .anim-mouse-hardware {
    animation: step1MouseHardwareFade 8.0s ease-in-out infinite;
  }
  .anim-rclick-btn {
    animation: step1WhiteMouseRClickPress 8.0s ease-in-out infinite;
  }
  .anim-rclick-label {
    animation: step1RClickLabelPop 8.0s ease-in-out infinite;
  }
  .anim-context-menu {
    animation: step1ContextMenuShow 8.0s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }
  .anim-context-item-openwith {
    animation: step1OpenWithHighlight 8.0s ease-in-out infinite;
  }
  .anim-editors-submenu {
    animation: step1SubmenuShow 8.0s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }
  .anim-submenu-item-notepad {
    animation: step1NotepadHighlight 8.0s ease-in-out infinite;
  }
  .anim-editor-bloom {
    animation: step1EditorBloom 8.0s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  /* File selection highlight on desktop (Step 1) */
  @keyframes fileSelectionCycle {
    0%, 19% {
      border-color: rgba(255, 255, 255, 0.1);
      background-color: rgba(255, 255, 255, 0.05);
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }
    21%, 58% {
      border-color: rgba(25, 195, 125, 0.75);
      background-color: rgba(25, 195, 125, 0.16);
      box-shadow: 0 0 0 1px rgba(25, 195, 125, 0.4), 0 0 16px rgba(25, 195, 125, 0.3);
    }
    60%, 100% {
      border-color: rgba(255, 255, 255, 0.1);
      background-color: rgba(255, 255, 255, 0.05);
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }
  }

  .anim-file-select {
    animation: fileSelectionCycle 8.0s ease-in-out infinite;
  }

  /* STEP 2: SEARCH SEQUENCE (8.0s MASTER CYCLE) */
  /* Sequence:
     0% - 15%: Keys Ctrl+F / Cmd+F appear and press down.
     16% - 22%: Keys fade out. Search box appears.
     24% - 50%: Phone number is typed into search box char-by-char.
     52%: "1 совпадение" badge pops in.
     59% - 68%: Code track scrolls down to line 14.
     68% - 94%: Target line glows with green highlight and "← найдено!".
     96% - 100%: Smooth reset for loop.
  */

  @keyframes keysAppearPressFadeCycle {
    0%        { opacity: 0; transform: translateY(12px) scale(0.92); }
    5%, 15%   { opacity: 1; transform: translateY(0) scale(1); }
    22%, 100% { opacity: 0; transform: translateY(-8px) scale(0.95); pointer-events: none; }
  }

  /* DEEP TACTILE KEY PRESS FOR STEP 2 (SEARCH) */
  @keyframes keyPressSearchCycle {
    0%, 7% {
      transform: translateY(0);
      border-bottom-width: 3px;
      box-shadow: 0 6px 16px rgba(0,0,0,0.35);
    }
    9%, 16% {
      transform: translateY(4px) scale(0.96);
      background-color: #19C37D;
      color: #081d14;
      border-bottom-width: 0px;
      box-shadow: inset 0 2px 4px rgba(0,0,0,0.5), 0 0 20px rgba(25, 195, 125, 0.85);
    }
    19%, 100% {
      transform: translateY(0);
      border-bottom-width: 3px;
      box-shadow: 0 6px 16px rgba(0,0,0,0.35);
    }
  }

  .anim-keys-appear-fade {
    animation: keysAppearPressFadeCycle 8.0s ease-in-out infinite;
  }
  .anim-key-press-search {
    animation: keyPressSearchCycle 8.0s ease-in-out infinite;
  }
  .anim-key-press-search-delayed {
    animation: keyPressSearchCycle 8.0s ease-in-out 0.08s infinite;
  }

  @keyframes searchBoxFade {
    0%, 20%   { opacity: 0; transform: translateY(-8px) scale(0.95); pointer-events: none; }
    24%, 68%  { opacity: 1; transform: translateY(0) scale(1); pointer-events: auto; }
    74%, 100% { opacity: 0; transform: translateY(-6px) scale(0.96); pointer-events: none; }
  }

  .anim-search-box {
    animation: searchBoxFade 8.0s ease-in-out infinite;
  }

  @keyframes searchFoundBadgePop {
    0%, 53%   { opacity: 0; transform: scale(0.75); }
    56%, 68%  { opacity: 1; transform: scale(1); }
    74%, 100% { opacity: 0; transform: scale(0.75); }
  }

  .anim-search-found-badge {
    animation: searchFoundBadgePop 8.0s ease-out infinite;
  }

  @keyframes codeScrollTrack {
    0%, 59%   { transform: translateY(0); }
    67%, 93%  { transform: translateY(-118px); }
    97%, 100% { transform: translateY(0); }
  }

  .code-track-scroll {
    animation: codeScrollTrack 8.0s cubic-bezier(0.25, 1, 0.5, 1) infinite;
  }

  @keyframes lineGlow {
    0%, 66%   { background-color: transparent; }
    70%, 93%  { background-color: rgba(25, 195, 125, 0.28); border-left: 4px solid #19C37D; }
    97%, 100% { background-color: transparent; }
  }

  .anim-highlight-line {
    animation: lineGlow 8.0s ease-in-out infinite;
  }

  /* STEP 3: REPLACE & SAVE SEQUENCE (8.0s MASTER CYCLE) */
  /* Sequence:
     0% - 10%: Initial state.
     10% - 22%: Erases old number char-by-char.
     22% - 42%: Types new phone number (+7 999 555-44-33).
     44%: Badge "✓ ввели новый номер!" pops in.
     47% - 58%: Keys Ctrl+S / Cmd+S appear and press down.
     60% - 66%: Keys fade out.
     67% - 94%: Save confirmation badge pops up in top-right corner of code window.
     96% - 100%: Smooth reset for loop.
  */

  @keyframes step3BadgePop {
    0%, 43%  { opacity: 0; transform: scale(0.8); }
    46%, 93% { opacity: 1; transform: scale(1); }
    97%, 100%{ opacity: 0; }
  }

  .anim-step3-badge {
    animation: step3BadgePop 8.0s ease-out infinite;
  }

  @keyframes keysSaveCycle {
    0%, 45%   { opacity: 0; transform: translateY(12px) scale(0.92); pointer-events: none; }
    48%, 59%  { opacity: 1; transform: translateY(0) scale(1); }
    63%, 100% { opacity: 0; transform: translateY(-8px) scale(0.95); pointer-events: none; }
  }

  .anim-keys-save-cycle {
    animation: keysSaveCycle 8.0s ease-in-out infinite;
  }

  /* DEEP TACTILE KEY PRESS FOR STEP 3 (SAVE) */
  @keyframes keyPressSaveCycle {
    0%, 50% {
      transform: translateY(0);
      border-bottom-width: 3px;
      box-shadow: 0 6px 16px rgba(0,0,0,0.35);
    }
    52%, 58% {
      transform: translateY(4px) scale(0.96);
      background-color: #19C37D;
      color: #081d14;
      border-bottom-width: 0px;
      box-shadow: inset 0 2px 4px rgba(0,0,0,0.5), 0 0 20px rgba(25, 195, 125, 0.85);
    }
    61%, 100% {
      transform: translateY(0);
      border-bottom-width: 3px;
      box-shadow: 0 6px 16px rgba(0,0,0,0.35);
    }
  }

  .anim-key-press-save {
    animation: keyPressSaveCycle 8.0s ease-in-out infinite;
  }
  .anim-key-press-save-delayed {
    animation: keyPressSaveCycle 8.0s ease-in-out 0.08s infinite;
  }

  @keyframes saveCornerBadgePop {
    0%, 64%  { opacity: 0; transform: translateY(-6px) scale(0.9); pointer-events: none; }
    68%, 93% { opacity: 1; transform: translateY(0) scale(1); pointer-events: auto; }
    97%, 100%{ opacity: 0; transform: translateY(-4px) scale(0.95); pointer-events: none; }
  }

  .anim-save-corner {
    animation: saveCornerBadgePop 8.0s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  /* STEP 4: REFRESH SPIN & REALISTIC 3D BUSINESS CARD FLOAT & GLOW */
  @keyframes refreshSpin {
    0%, 20%  { transform: rotate(0deg); }
    35%, 60% { transform: rotate(360deg); }
    100%     { transform: rotate(360deg); }
  }
  .anim-refresh-spin {
    display: inline-block;
    animation: refreshSpin 3.5s ease-in-out infinite;
  }

