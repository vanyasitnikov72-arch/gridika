              Выбранная позиция на странице
            </span>
          </div>
        </div>
      `;
      return;
    }

    if (stepNum === 2) {
      cmsVisualStage.innerHTML = `
        <div class="px-3.5 py-2 bg-[#0d1813] border-b border-[#1b382b] flex items-center justify-between text-[11px] text-white/60">
          <div class="flex items-center gap-2">
