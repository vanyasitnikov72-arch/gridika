---

<!doctype html>
<html lang="ru" class="h-full w-full overflow-hidden bg-transparent">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gridika — Embed Preview</title>
  </head>
  <body class="m-0 p-0 h-full w-full overflow-hidden flex items-center justify-center">
    <div id="embed-mount" class="w-full h-full relative overflow-hidden">
      {/* Target canvas container */}
      <div id="canvas-container" class="w-full h-full"></div>

      {/* Made in Gridika badge */}
      <a
        id="fx-badge"
        href="https://gridika.ru"
        target="_blank"
        rel="noopener"
        class="absolute bottom-3 right-3 z-10 text-[11px] font-semibold px-2.5 py-1 rounded-md bg-slate-950/70 text-slate-400 hover:text-white border border-slate-800 backdrop-blur-md transition-opacity"
      >
        Gridika
      </a>
    </div>

    <script>
      import { QrMorphViewer } from '../engine/QrMorphViewer';
      import type { TargetShapeType } from '../engine/shapes';

      const params = new URLSearchParams(window.location.search);
      const text = params.get('text') || 'https://gridika.ru';
      const shape = (params.get('shape') as TargetShapeType) || 'city';
      const themeId = params.get('theme') || 'dark-gold';

      const container = document.getElementById('canvas-container');
      if (container) {
        new QrMorphViewer({
          container,
          text,
          shape,
          themeId,
        });
      }
    </script>
  </body>
</html>
