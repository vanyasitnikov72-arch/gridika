---
import Layout from '../layouts/Layout.astro';
import { ChangeNote } from '../components/ChangeNote';
---

<Layout title="Спасибо за покупку — Gridika" description="Готовый код эффектов Gridika из вашего заказа.">
  <main class="min-h-screen flex flex-col items-center px-4 py-10 sm:py-16">
    {/* the name made of cubes, the same as in the site header */}
    <a href="/" id="thx-brand" class="relative block w-[150px] h-12 select-none" aria-label="Gridika — на главную">
      <span id="thx-brand-name" class="absolute left-1 top-1/2 -translate-y-1/2 text-[30px] font-black text-[#132A22] tracking-[-0.03em] w-max opacity-0">Grid<span class="text-[#19C37D]">ika</span></span>
    </a>

    <section class="mt-8 w-full max-w-[560px] bg-white border border-[#ebe5da] rounded-[28px] shadow-[0_24px_60px_-28px_rgba(19,42,34,0.25)] p-7 sm:p-9">
      {/* with a key in the link */}
      <div id="thx-ok" class="hidden" hidden>
        {/* status mark: a ring draws, fills, the tick is drawn in, voxel confetti bursts out */}
        <div class="thx-sky relative w-[132px] h-[92px] rounded-[24px] overflow-hidden border border-[#d5f2e3] shadow-[0_12px_28px_-16px_rgba(19,42,34,0.35)] flex items-center justify-center" style="background:linear-gradient(180deg,#d9f7e8 0%,#fbfefc 100%)" aria-hidden="true">
          <svg viewBox="0 0 132 92" class="absolute inset-0 w-full h-full">
            <g class="thx-cloud thx-cloud-a">
              <rect x="6" y="0" width="12" height="9" rx="2.5" fill="#ffffff" />
              <rect x="0" y="5" width="30" height="8" rx="2.5" fill="#ffffff" />
              <rect x="15" y="2" width="10" height="7" rx="2.5" fill="#ffffff" />
            </g>
            <g class="thx-cloud thx-cloud-b">
              <rect x="6" y="0" width="12" height="9" rx="2.5" fill="#ffffff" />
              <rect x="0" y="5" width="30" height="8" rx="2.5" fill="#ffffff" />
              <rect x="15" y="2" width="10" height="7" rx="2.5" fill="#ffffff" />
            </g>
          </svg>
          <div class="thx-check relative w-[62px] h-[62px]">
            <span class="thx-halo"></span>
            <span class="thx-bit" style="--a:0deg;--c:#19C37D;--d:0ms"></span><span class="thx-bit" style="--a:36deg;--c:#8BF0C2;--d:30ms"></span><span class="thx-bit" style="--a:72deg;--c:#132A22;--d:10ms"></span><span class="thx-bit" style="--a:108deg;--c:#19C37D;--d:40ms"></span><span class="thx-bit" style="--a:144deg;--c:#8BF0C2;--d:20ms"></span><span class="thx-bit" style="--a:180deg;--c:#19C37D;--d:0ms"></span><span class="thx-bit" style="--a:216deg;--c:#132A22;--d:30ms"></span><span class="thx-bit" style="--a:252deg;--c:#8BF0C2;--d:10ms"></span><span class="thx-bit" style="--a:288deg;--c:#19C37D;--d:40ms"></span><span class="thx-bit" style="--a:324deg;--c:#132A22;--d:20ms"></span>
            <svg viewBox="0 0 96 96" class="thx-check-svg relative w-full h-full overflow-visible">
              <defs>
                <linearGradient id="thx-disc-g" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#2ee39a" />
                  <stop offset="100%" stop-color="#109e60" />
                </linearGradient>
              </defs>
              <circle class="thx-ring" cx="48" cy="48" r="42" fill="none" stroke="#19C37D" stroke-width="5" stroke-linecap="round" pathLength="100" transform="rotate(-90 48 48)" />
              <circle class="thx-disc" cx="48" cy="48" r="42" fill="url(#thx-disc-g)" />
              <path class="thx-tick" d="M29 49.5 L42.5 62 L67 35.5" fill="none" stroke="#ffffff" stroke-width="7.5" stroke-linecap="round" stroke-linejoin="round" pathLength="100" />
            </svg>
          </div>
        </div>

        <h1 class="mt-6 text-[30px] sm:text-[34px] font-black text-[#132A22] tracking-tight leading-[1.08]">Оплата прошла</h1>
        <p class="mt-2 text-[15px] font-semibold text-[#6b645c] leading-relaxed"><span id="thx-lead">Код уже собран с вашими настройками.</span> Он ваш навсегда — без подписки и привязки к сайту.</p>

        <div class="mt-6 flex items-center justify-between gap-3">
          <span class="text-[11px] font-black uppercase tracking-[0.14em] text-[#a8a29e]">Заказ № <span id="thx-id" class="font-mono normal-case tracking-normal text-[#132A22]"></span></span>
          <span id="thx-count" class="px-2.5 h-6 inline-flex items-center rounded-full bg-[#DFF8EB] text-[#0f5c3c] text-[11.5px] font-black"></span>
        </div>
        {/* one card per effect: its own code, copy or download */}
        <p id="thx-sample" class="mt-2.5 rounded-xl bg-[#FFF4DB] px-3.5 py-2.5 text-[12px] font-bold text-[#8a5a12] leading-snug" hidden>Это пример заказа: так выглядит страница после оплаты. В примере код показывает пометку Gridika — в купленном её нет.</p>
        <ul id="thx-items" class="mt-2.5 flex flex-col gap-2.5"></ul>
        <p id="thx-empty" class="mt-2.5 rounded-2xl bg-[#fff4ed] px-4 py-3 text-[13px] font-semibold text-[#9a3412]" hidden>Не получилось прочитать заказ из ссылки. Откройте ссылку из письма целиком или напишите нам — пришлём код заново.</p>

        {/* where to paste it */}
        <div class="mt-6 rounded-2xl bg-[#f6f3ee] p-4">
          <div class="text-[12px] font-black text-[#132A22]">Куда вставить<span id="thx-each" hidden> — каждый эффект в свой блок</span></div>
          <div id="thx-tabs" class="mt-2 flex flex-wrap gap-1"></div>
          <ol id="thx-tab-steps" class="mt-3 flex flex-col gap-1.5 text-[13px] font-semibold text-[#44403c] leading-snug list-decimal pl-5"></ol>
        </div>
        <div class="mt-3 text-left"><ChangeNote /></div>
      </div>

      {/* no order in the link: the link comes by email */}
      <div id="thx-wait">
        {/* status mark: a paper plane loops through a little sky ("письмо летит на почту") */}
        <div class="thx-sky relative w-[132px] h-[92px] rounded-[24px] overflow-hidden border border-[#d5f2e3] shadow-[0_12px_28px_-16px_rgba(19,42,34,0.35)]" aria-hidden="true">
          <svg id="thx-sky-svg" viewBox="0 0 132 92" class="absolute inset-0 w-full h-full">
            <defs>
              <linearGradient id="thx-sky-g" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#d9f7e8" />
                <stop offset="100%" stop-color="#fbfefc" />
              </linearGradient>
              {/* the trail shows only where the plane has already been */}
              <mask id="thx-trail-m" maskUnits="userSpaceOnUse" x="-20" y="-10" width="180" height="110">
                <path d="M -16 66 C 12 67, 30 58, 46 46 C 60 35, 75 22, 67 14 C 59 7, 46 19, 56 29 C 66 39, 88 40, 104 30 C 117 22, 131 14, 152 7" fill="none" stroke="#ffffff" stroke-width="8" pathLength="100" stroke-dasharray="100 100">
                  <animate attributeName="stroke-dashoffset" dur="4.4s" repeatCount="indefinite" values="100;0;0" keyTimes="0;0.82;1" calcMode="spline" keySplines="0.45 0 0.55 1; 0 0 1 1" />
                </path>
              </mask>
            </defs>
            <rect width="132" height="92" fill="url(#thx-sky-g)" />
            <g class="thx-cloud thx-cloud-a">
              <rect x="6" y="0" width="12" height="9" rx="2.5" fill="#ffffff" />
              <rect x="0" y="5" width="30" height="8" rx="2.5" fill="#ffffff" />
              <rect x="15" y="2" width="10" height="7" rx="2.5" fill="#ffffff" />
            </g>
            <g class="thx-cloud thx-cloud-b">
              <rect x="6" y="0" width="12" height="9" rx="2.5" fill="#ffffff" />
              <rect x="0" y="5" width="30" height="8" rx="2.5" fill="#ffffff" />
              <rect x="15" y="2" width="10" height="7" rx="2.5" fill="#ffffff" />
            </g>
            <g mask="url(#thx-trail-m)">
              <path d="M -16 66 C 12 67, 30 58, 46 46 C 60 35, 75 22, 67 14 C 59 7, 46 19, 56 29 C 66 39, 88 40, 104 30 C 117 22, 131 14, 152 7" fill="none" stroke="#19C37D" stroke-width="1.6" stroke-linecap="round" stroke-dasharray="0.1 4.2" opacity="0.75">
                <animate attributeName="opacity" dur="4.4s" repeatCount="indefinite" values="0.75;0.75;0;0" keyTimes="0;0.8;0.96;1" />
              </path>
            </g>
            <g>
              <animateMotion dur="4.4s" repeatCount="indefinite" rotate="auto" path="M -16 66 C 12 67, 30 58, 46 46 C 60 35, 75 22, 67 14 C 59 7, 46 19, 56 29 C 66 39, 88 40, 104 30 C 117 22, 131 14, 152 7" keyPoints="0;1;1" keyTimes="0;0.82;1" calcMode="spline" keySplines="0.45 0 0.55 1; 0 0 1 1" />
              <g transform="scale(1.25)">
              <g class="thx-plane">
                <path d="M11 0 L-9 5 L-4 1 Z" fill="#b6efd4" stroke="#0f5c3c" stroke-width="0.9" stroke-linejoin="round" />
                <path d="M11 0 L-4 1 L-6.5 6 Z" fill="#19C37D" stroke="#0f5c3c" stroke-width="0.9" stroke-linejoin="round" />
                <path d="M11 0 L-10 -7.5 L-4 1 Z" fill="#ffffff" stroke="#0f5c3c" stroke-width="0.9" stroke-linejoin="round" />
              </g>
              </g>
            </g>
          </svg>
        </div>

        <h1 class="mt-6 text-[30px] sm:text-[34px] font-black text-[#132A22] tracking-tight leading-[1.08]">Спасибо за покупку</h1>
        <p class="mt-2 text-[15px] font-semibold text-[#6b645c] leading-relaxed">Письмо со ссылкой на готовый код уже летит на вашу почту вместе с чеком. Откройте ссылку — и код каждого эффекта будет перед вами.</p>
        <p id="thx-bad" class="mt-4 rounded-2xl bg-[#fff4ed] px-4 py-3 text-[13px] font-semibold text-[#9a3412] leading-relaxed" hidden>Эта ссылка на заказ неполная или изменена, поэтому код по ней не открывается. Откройте ссылку из письма целиком — а если не выходит, напишите нам, пришлём заново.</p>
        <p class="mt-3 text-[13px] font-semibold text-[#a8a29e] leading-relaxed">Письма нет через 5 минут? Загляните в «Спам» или напишите нам — пришлём ещё раз.</p>
        <a href="#order=demo" id="thx-demo" class="mt-4 inline-block text-[12.5px] font-bold text-[#6b645c] underline decoration-[#d6cfc2] underline-offset-4 hover:text-[#132A22]">Посмотреть, как это выглядит</a>
      </div>

      {/* what's next — same for both */}
      <ol class="mt-8 pt-6 border-t border-[#ece6da] flex flex-col gap-4">
        <li class="flex gap-3.5">
          <span class="w-6 h-6 shrink-0 rounded-full bg-[#19C37D] text-[#132A22] text-[12px] font-black flex items-center justify-center">1</span>
          <span class="text-[14px] font-semibold text-[#6b645c] leading-snug"><b class="text-[#132A22]">Заберите код</b> — у каждого эффекта свой: скопируйте или скачайте файлом.</span>
        </li>
        <li class="flex gap-3.5">
          <span class="w-6 h-6 shrink-0 rounded-full bg-[#19C37D] text-[#132A22] text-[12px] font-black flex items-center justify-center">2</span>
          <span class="text-[14px] font-semibold text-[#6b645c] leading-snug"><b class="text-[#132A22]">Вставьте на сайт</b> — Tilda (блок T123), WordPress, Webflow, Wix или обычный HTML.</span>
        </li>
        <li class="flex gap-3.5">
          <span class="w-6 h-6 shrink-0 rounded-full bg-[#19C37D] text-[#132A22] text-[12px] font-black flex items-center justify-center">3</span>
          <span class="text-[14px] font-semibold text-[#6b645c] leading-snug"><b class="text-[#132A22]">Опубликуйте</b> — эффект заработает сразу, на компьютере и на телефоне.</span>
        </li>
      </ol>

      <div class="mt-6 rounded-2xl bg-[#f6f3ee] px-4 py-3.5 text-[13px] font-semibold text-[#6b645c] leading-relaxed">
        <b class="text-[#132A22]">Сохраните письмо.</b> Ссылка в нём не сгорает: по ней код можно скопировать снова в любой момент.
      </div>
    </section>

    <p class="mt-6 text-[12px] font-semibold text-[#a8a29e]">Есть вопросы? Напишите в поддержку: <a href="mailto:support@gridika.ru" class="text-[#132A22] underline underline-offset-4 font-bold hover:text-[#19C37D] transition-colors">support@gridika.ru</a> • <a href="/" class="underline underline-offset-4 hover:text-[#132A22]">gridika.ru</a></p>
  </main>

  <style>
    [hidden] {
      display: none !important;
    }

    /* ---- paid: check mark ---- */
    .thx-ring { stroke-dasharray: 100; stroke-dashoffset: 100; animation: thxDraw 0.6s cubic-bezier(0.65, 0, 0.35, 1) 0.15s forwards; }
    .thx-disc { transform-box: fill-box; transform-origin: center; transform: scale(0); animation: thxDisc 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 0.6s forwards; }
    .thx-tick { stroke-dasharray: 100; stroke-dashoffset: 100; animation: thxDraw 0.45s cubic-bezier(0.65, 0, 0.35, 1) 0.95s forwards; }
    .thx-check-svg { animation: thxFloat 3.2s ease-in-out 2.2s infinite; }
    .thx-halo { position: absolute; inset: 6px; border-radius: 50%; background: #19C37D; opacity: 0; animation: thxHalo 1.1s ease-out 1.05s forwards; }
    .thx-bit {
      position: absolute; left: 50%; top: 50%; width: 7px; height: 7px; margin: -3.5px 0 0 -3.5px; border-radius: 2px;
      background: var(--c); opacity: 0; animation: thxBit 0.95s cubic-bezier(0.2, 0.75, 0.3, 1) calc(1.1s + var(--d)) forwards;
    }
    @keyframes thxDraw { to { stroke-dashoffset: 0; } }
    @keyframes thxDisc { to { transform: scale(1); } }
    @keyframes thxHalo { 0% { opacity: 0.32; transform: scale(0.92); } 100% { opacity: 0; transform: scale(1.7); } }
    @keyframes thxBit {
      0% { opacity: 1; transform: rotate(var(--a)) translateX(24px) scale(0.3) rotate(0deg); }
      70% { opacity: 1; }
      100% { opacity: 0; transform: rotate(var(--a)) translateX(46px) scale(1) rotate(120deg); }
    }
    @keyframes thxFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-3px); } }

    /* ---- the bought effects slide in one after another ---- */
    :global(.thx-item) { opacity: 0; transform: translateY(8px); animation: thxIn 0.45s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    @keyframes thxIn { to { opacity: 1; transform: none; } }

    /* ---- waiting: paper plane ---- */
    .thx-plane { animation: thxBob 0.9s ease-in-out infinite alternate; }
    @keyframes thxBob { from { transform: translateY(-0.6px) rotate(-3deg); } to { transform: translateY(0.6px) rotate(3deg); } }
    .thx-cloud { opacity: 0.95; }
    .thx-cloud-a { animation: thxCloud 13s linear infinite; }
    .thx-cloud-b { animation: thxCloud 19s linear -9s infinite; opacity: 0.8; }
    .thx-cloud-a > * { transform: translateY(14px); }
    .thx-cloud-b > * { transform: translateY(58px) scale(0.8); }
    @keyframes thxCloud { from { transform: translateX(140px); } to { transform: translateX(-40px); } }

    @media (prefers-reduced-motion: reduce) {
      .thx-ring, .thx-tick { animation: none; stroke-dashoffset: 0; }
      .thx-disc { animation: none; transform: scale(1); }
      .thx-bit, .thx-halo { display: none; }
      .thx-check-svg, .thx-plane, .thx-cloud { animation: none; }
      :global(.thx-item) { animation: none; opacity: 1; transform: none; }
    }
  </style>
</Layout>

<script>
  import { PRODUCTS } from '../data/products';
  import { createMorphLogo } from '../brand/morphLogo';
  import { readOrderHash, encodeConfig, type OrderItem } from '../engine/purchase';
  import { codeFileName, downloadCode } from '../engine/codeNotice';
  import { describeOrderItem } from '../engine/cartStore';
  import { DEMO_ORDER, DEMO_ORDER_ID } from '../engine/demoOrder';
  import { verifyOrder } from '../engine/license';
  import { effectsWord } from '../emails/orderEmail';

  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const sky = document.getElementById('thx-sky-svg') as unknown as SVGSVGElement | null;
    sky?.pauseAnimations();
    sky?.setCurrentTime(2.2);
  }

  // cube name at the top (static: progress 0 = the word)
  const brandHost = document.getElementById('thx-brand'), brandName = document.getElementById('thx-brand-name');
  if (brandHost && brandName) {
    const build = () => createMorphLogo(brandHost, brandName, { logoCenter: { x: 24, y: 24 }, logoSize: 40 }).snap(0);
    document.fonts ? document.fonts.load('900 30px Nunito').then(build, build) : build();
  }

  const $ = (id: string) => document.getElementById(id)!;
  const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  const toggle = (id: string, on: boolean) => {
    $(id).hidden = !on;
    $(id).classList.toggle('hidden', !on);
  };
  const flash = (b: HTMLElement, text: string, back: string) => {
    b.textContent = text;
    setTimeout(() => (b.textContent = back), 1900);
  };

  /** one bought effect: its own code, copy / download, peek, and the way back into the studio */
  function createItemCard(c: OrderItem, orderId: string, idx: number): { el: HTMLLIElement; setCode: (code: string | null) => void } {
    const d = describeOrderItem(c);
    const prod = PRODUCTS.find((p) => p.id === c.p);
    const studio = `/?fx=${encodeURIComponent(c.p)}#cfg=${encodeConfig({ ...c, site: '' })}`;
    const li = document.createElement('li');
    li.className = 'thx-item rounded-2xl border border-[#ece6da] bg-[#fbf9f5] p-3.5';
    li.style.animationDelay = `${0.25 + idx * 0.09}s`;
    li.innerHTML = `
      <div class="flex items-center gap-3">
        <span class="w-10 h-10 rounded-[13px] shrink-0 flex items-center justify-center text-[13px] font-black text-white shadow-[0_6px_14px_-8px_rgba(0,0,0,0.5)]" style="background:linear-gradient(135deg,${d.theme.accent},${d.theme.deep})">${idx + 1}</span>
        <div class="min-w-0 flex-1">
          <div class="text-[14px] font-black text-[#132A22] truncate leading-tight">${esc(d.title)}</div>
          <div class="text-[12px] font-semibold text-[#78716c] truncate mt-0.5">${esc(d.subtitle)}</div>
        </div>
        <span data-size class="text-[11px] font-bold text-[#a8a29e] shrink-0"></span>
      </div>
      <div data-body class="mt-3">
        <div class="flex items-center justify-center py-2.5 text-[12.5px] font-semibold text-[#78716c] gap-2">
          <span class="w-3.5 h-3.5 border-2 border-[#19C37D] border-t-transparent rounded-full animate-spin"></span>
          Загрузка кода с сервера...
        </div>
      </div>`;

    function setCode(code: string | null) {
      const sizeSpan = li.querySelector('[data-size]') as HTMLElement;
      const body = li.querySelector('[data-body]') as HTMLElement;
      if (!body) return;

      if (!code) {
        if (sizeSpan) sizeSpan.textContent = '';
        body.innerHTML = `<p class="text-[12.5px] font-semibold text-[#9a3412]">Не удалось загрузить код этого эффекта с сервера. Напишите нам — пришлём его отдельно.</p>`;
        return;
      }

      if (sizeSpan) {
        sizeSpan.textContent = `${Math.max(1, Math.round(code.length / 1024))} КБ`;
      }

      body.innerHTML = `
        <div class="grid grid-cols-[1fr_auto] gap-2">
          <button type="button" data-act="copy" class="h-11 rounded-full bg-[#19C37D] hover:bg-[#17b373] text-[#132A22] font-extrabold text-[14px] transition-colors cursor-pointer">Скопировать код</button>
          <button type="button" data-act="dl" class="h-11 px-4 rounded-full bg-white border border-[#e5dfd2] hover:bg-[#f6f3ee] text-[#132A22] font-extrabold text-[13px] transition-colors cursor-pointer">Скачать</button>
        </div>
        <div class="mt-2 flex items-center justify-between gap-2 px-1">
          <button type="button" data-act="peek" aria-expanded="false" class="text-[12px] font-bold text-[#78716c] hover:text-[#132A22] cursor-pointer">Показать код</button>
          <a href="${studio}" class="text-[12px] font-bold text-[#78716c] hover:text-[#132A22]">Изменить в студии →</a>
        </div>
        <pre data-code hidden class="mt-2 max-h-36 overflow-auto rounded-xl bg-[#132A22] text-[#8BF0C2] px-3.5 py-3 font-mono text-[10.5px] leading-[1.5] whitespace-pre-wrap break-all"></pre>`;

      const text = code;
      const pre = body.querySelector('[data-code]') as HTMLPreElement;
      pre.textContent = text;
      const copy = body.querySelector('[data-act="copy"]') as HTMLButtonElement;
      copy.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(text); } catch {}
        flash(copy, 'Код скопирован ✓', 'Скопировать код');
      });
      const dl = body.querySelector('[data-act="dl"]') as HTMLButtonElement;
      dl.addEventListener('click', () => {
        downloadCode(text, codeFileName(prod?.id || c.p, orderId));
        flash(dl, 'Сохранён ✓', 'Скачать');
      });
      const peek = body.querySelector('[data-act="peek"]') as HTMLButtonElement;
      peek.addEventListener('click', () => {
        pre.hidden = !pre.hidden;
        peek.textContent = pre.hidden ? 'Показать код' : 'Скрыть код';
        peek.setAttribute('aria-expanded', String(!pre.hidden));
      });
    }

    return { el: li, setCode };
  }

  let shown = 0;
  async function fromHash() {
    const run = ++shown;
    const raw = readOrderHash(location.hash);
    const sample = raw?.id === 'demo';
    // a real order opens only with a valid signature: no code for a made-up or edited link
    const valid = !!raw && !sample && raw.items.length > 0 && (await verifyOrder(raw.id, raw.itemsB64, raw.sig));
    if (run !== shown) return;
    $('thx-bad').hidden = !raw || sample || valid;
    const order = sample ? { id: DEMO_ORDER_ID, items: DEMO_ORDER } : valid ? raw : null;
    if (!order) {
      $('thx-items').innerHTML = '';
      toggle('thx-ok', false);
      toggle('thx-wait', true);
      return;
    }
    $('thx-sample').hidden = !sample;
    const n = order.items.length;
    $('thx-id').textContent = order.id;
    $('thx-count').textContent = effectsWord(n);
    $('thx-count').hidden = n === 0;
    $('thx-lead').textContent = n > 1 ? `Код всех ${n} эффектов уже собран с вашими настройками.` : 'Код уже собран с вашими настройками.';
    $('thx-each').hidden = n < 2;

    const list = $('thx-items');
    list.innerHTML = '';
    const cards = order.items.map((c, i) => {
      const card = createItemCard(c, order.id, i);
      list.appendChild(card.el);
      return card;
    });

    $('thx-empty').hidden = n > 0;
    renderTabs();
    toggle('thx-wait', false);
    toggle('thx-ok', true);

    if (sample) {
      // Demo order: display sample preview embed codes without commercial license
      cards.forEach((card, idx) => {
        const item = order.items[idx];
        const demoSnippet = `<!-- Gridika Demo Effect: ${item.p} (Показана демо-версия с водяным знаком) -->\n<div id="gridika-${item.p}-demo" style="width:100%;max-width:560px;height:480px;margin:0 auto;display:flex;align-items:center;justify-content:center;background:#f6f3ee;border-radius:24px;border:1px dashed #d5cfc4;font-family:Nunito,system-ui,sans-serif;color:#132A22;font-weight:800;">\n  Gridika 3D Preview (${item.p})\n</div>\n<script type="module">\n  console.log("Gridika demo embed loaded: ${item.p}");\n<\/script>`;
        card.setCode(demoSnippet);
      });
      return;
    }

    // Real paid order: fetch clean, compiled commercial code directly from the server!
    try {
      const apiEndpoint = (window as any).GRIDIKA_API_URL
        ? `${(window as any).GRIDIKA_API_URL.replace(/\/create-payment\/?$/, '')}/get-order-codes`
        : '/api/get-order-codes';

      const res = await fetch(apiEndpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          orderId: order.id,
          itemsB64: (order as any).itemsB64,
          sig: (order as any).sig,
        }),
      });

      if (!res.ok) {
        throw new Error(`HTTP ${res.status}`);
      }

      const data = await res.json();
      if (run !== shown) return;

      const codes: string[] = data.codes || [];
      cards.forEach((card, idx) => {
        card.setCode(codes[idx] || null);
      });
    } catch (err) {
      console.error('Failed to fetch order codes from server:', err);
      if (run !== shown) return;
      cards.forEach((card) => {
        card.setCode(null);
      });
    }
  }

  const GUIDES: Record<string, string[]> = {
    Tilda: ['«Все блоки» → «Другое» → «HTML-код» (T123)', 'Вставьте код, сохраните и опубликуйте'],
    WordPress: ['Добавьте блок «Произвольный HTML» (в Elementor — виджет «HTML»)', 'Вставьте код и обновите страницу'],
    Webflow: ['Перетащите элемент Code Embed', 'Вставьте код, сохраните и опубликуйте'],
    Wix: ['«Добавить» → «Встроить код» → «Встроить HTML», режим «Код»', 'Вставьте код и растяните блок по высоте эффекта'],
    HTML: ['Вставьте код внутрь <body> в нужное место страницы', 'Больше ничего подключать не нужно'],
  };
  function renderTabs(active = 'Tilda') {
    const tabs = $('thx-tabs');
    tabs.innerHTML = '';
    Object.keys(GUIDES).forEach((name) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.textContent = name;
      b.className = `px-3 h-7 rounded-lg text-[12px] font-extrabold transition-colors cursor-pointer ${name === active ? 'bg-[#132A22] text-white' : 'text-[#6b645c] hover:text-[#132A22]'}`;
      b.addEventListener('click', () => renderTabs(name));
      tabs.appendChild(b);
    });
    const ol = $('thx-tab-steps');
    ol.innerHTML = '';
    GUIDES[active].forEach((t) => { const li = document.createElement('li'); li.textContent = t; ol.appendChild(li); });
  }

  window.addEventListener('hashchange', fromHash);
  fromHash();
</script>
