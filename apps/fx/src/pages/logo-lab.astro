<script>
  function initLab() {
    // Top Navbar Elements
    const brandLink = document.getElementById('lab-brand-link');
    const logoBox = document.getElementById('lab-logo-box');
    const logoRipple = document.getElementById('logo-ripple');

    // Cards
    const cards = [
      document.getElementById('card-facets'),
      document.getElementById('card-voxels'),
      document.getElementById('card-vmonogram'),
      document.getElementById('card-vka')
    ];

    // Simulator Elements
    const scrubSlider = document.getElementById('scrub-slider') as HTMLInputElement | null;
    const scrubPct = document.getElementById('scrub-pct');
    const btnPlayToggle = document.getElementById('btn-play-toggle');
    const playIcon = document.getElementById('play-icon');
    const playText = document.getElementById('play-text');
    const btnResetTop = document.getElementById('btn-reset-top');
    const btnSetScrolled = document.getElementById('btn-set-scrolled');
    const simGlyphs = document.querySelectorAll<HTMLElement>('.sim-glyph');
    const simSub = document.getElementById('sim-sub');
    const simInnerGlyphs = document.getElementById('sim-inner-glyphs');
    const simFacetGlow = document.getElementById('sim-facet-glow');

    let currentVariant = 'facets'; // 'facets' | 'voxels' | 'vmonogram' | 'vka'
    let isPlaying = false;
    let playInterval: number | null = null;
    let isNavCollapsed = false;

    // 1. SELECT ACTIVE VARIANT FOR NAVBAR & SIMULATOR
    function selectVariant(variant: string) {
      currentVariant = variant;

      // Update Card Visuals
      cards.forEach((c) => {
        if (!c) return;
        const btnSelect = c.querySelector('.btn-select-variant');
        const dot = c.querySelector('.card-status-dot');

        if (c.id === `card-${variant}`) {
          c.classList.add('border-[#19C37D]');
          c.classList.remove('border-transparent');
          if (dot) {
            dot.className = 'card-status-dot w-2.5 h-2.5 rounded-full bg-[#19C37D]';
          }
          if (btnSelect) {
            btnSelect.textContent = 'Выбран для симулятора';
            btnSelect.className = 'btn-select-variant px-3 py-1.5 rounded-lg bg-[#132A22] text-white text-xs font-bold transition-colors cursor-pointer';
          }
        } else {
          c.classList.remove('border-[#19C37D]');
          c.classList.add('border-transparent');
          if (dot) {
            dot.className = 'card-status-dot w-2.5 h-2.5 rounded-full bg-[#d5cdc2]';
          }
          if (btnSelect) {
            btnSelect.textContent = 'Выбрать для симулятора';
            btnSelect.className = 'btn-select-variant px-3 py-1.5 rounded-lg bg-white hover:bg-[#132A22] hover:text-white border border-[#d5cdc2] text-[#132A22] text-xs font-bold transition-colors cursor-pointer';
          }
        }
      });

      // Update Navbar Class
      brandLink?.classList.remove('mode-facets', 'mode-voxels', 'mode-vmonogram', 'mode-vka');
      brandLink?.classList.add(`mode-${variant}`);

      // Re-render simulator
      if (scrubSlider) updateSimulator(parseFloat(scrubSlider.value));
    }

    // Attach click to card select buttons
    document.querySelectorAll<HTMLButtonElement>('.btn-select-variant').forEach((btn) => {
      btn.addEventListener('click', () => {
        const variant = btn.getAttribute('data-variant');
        if (variant) selectVariant(variant);
      });
    });

    // 2. SIMULATOR UPDATE LOGIC
    function updateSimulator(progress: number) {
      const t = progress / 100;
      if (scrubPct) scrubPct.textContent = `${Math.round(progress)}%`;

      if (simSub) {
        const subT = Math.min(1, t / 0.35);
        simSub.style.opacity = `${1 - subT}`;
        simSub.style.transform = `translateY(${-4 * subT}px) scale(${1 - 0.15 * subT})`;
      }

      simGlyphs.forEach((glyph) => {
        const idx = parseInt(glyph.style.getPropertyValue('--i') || '0', 10);

        if (currentVariant === 'facets') {
          const delay = (6 - idx) * 0.08;
          const letterT = Math.max(0, Math.min(1, (t - delay) / (1 - 0.48)));

          let targetX = -45 - (idx * 11);
          let targetY = 0;
          let targetSkew = 0;
          let targetScale = 1 - 0.88 * letterT;

          if (idx >= 5) {
            targetY = -12 * letterT;
            targetSkew = -25 * letterT;
          } else if (idx <= 2) {
            targetY = 4 * letterT;
            targetSkew = 30 * letterT;
          } else {
            targetY = 5 * letterT;
            targetSkew = -30 * letterT;
          }

          glyph.style.transform = `translate3d(${targetX * letterT}px, ${targetY}px, 0) scale(${targetScale}) skewY(${targetSkew}deg)`;
          glyph.style.opacity = `${1 - Math.max(0, (letterT - 0.7) * 3.3)}`;
        } else if (currentVariant === 'voxels') {
          const delay = (6 - idx) * 0.09;
          const letterT = Math.max(0, Math.min(1, (t - delay) / (1 - 0.5)));
          const targetX = (-52 - (idx * 12)) * letterT;
          const targetY = -4 * letterT;
          const targetRot = (idx * 15) * letterT;
          const targetScale = 1 - 0.9 * letterT;

          glyph.style.transform = `translate3d(${targetX}px, ${targetY}px, 0) scale(${targetScale}) rotate(${targetRot}deg)`;
          glyph.style.opacity = `${1 - Math.max(0, (letterT - 0.65) * 2.85)}`;
        } else if (currentVariant === 'vmonogram') {
          if (idx === 0) {
            glyph.style.transform = `translate3d(${-18 * t}px, 0, 0) scale(${1 + 0.12 * t})`;
            glyph.style.color = t > 0.6 ? '#19C37D' : '#132A22';
            glyph.style.opacity = '1';
          } else {
            const delay = (6 - idx) * 0.08;
            const letterT = Math.max(0, Math.min(1, (t - delay) / (1 - 0.48)));
            const targetX = (-25 - (idx * 10)) * letterT;
            glyph.style.transform = `translate3d(${targetX}px, 0, 0) scaleX(${Math.max(0.05, 1 - letterT)}) scaleY(${1 - 0.3 * letterT})`;
            glyph.style.opacity = `${1 - Math.max(0, (letterT - 0.5) * 2)}`;
          }
        } else if (currentVariant === 'vka') {
          if (idx === 0) {
            glyph.style.transform = `translate3d(${-24 * t}px, 0, 0) scale(${1 + 0.08 * t})`;
            glyph.style.opacity = '1';
          } else if (idx >= 5) {
            glyph.style.transform = `translate3d(${-54 * t}px, 0, 0) scale(1)`;
            glyph.style.opacity = '1';
          } else {
            const collapseT = Math.min(1, t / 0.5);
            glyph.style.transform = `scale(${1 - collapseT})`;
            glyph.style.opacity = `${1 - collapseT}`;
          }
        }
      });

      // Facet graphic / glow inside badge
      if (currentVariant === 'facets') {
        const glowT = Math.max(0, (t - 0.6) / 0.4);
        if (simInnerGlyphs) simInnerGlyphs.style.opacity = `${glowT}`;
        if (simFacetGlow) simFacetGlow.style.opacity = `${glowT * 0.6}`;
      } else {
        if (simInnerGlyphs) simInnerGlyphs.style.opacity = '0';
        if (simFacetGlow) simFacetGlow.style.opacity = '0';
      }
    }

    // Scrubber input event
    scrubSlider?.addEventListener('input', () => {
      stopAutoPlay();
      if (scrubSlider) updateSimulator(parseFloat(scrubSlider.value));
    });

    // Reset to Top (0%)
    btnResetTop?.addEventListener('click', () => {
      stopAutoPlay();
      if (scrubSlider) {
        scrubSlider.value = '0';
        updateSimulator(0);
      }
      brandLink?.classList.remove('is-collapsed');
    });

    // Set to Scrolled (100%)
    btnSetScrolled?.addEventListener('click', () => {
      stopAutoPlay();
      if (scrubSlider) {
        scrubSlider.value = '100';
        updateSimulator(100);
      }
      brandLink?.classList.add('is-collapsed');
      triggerNavbarPulse();
    });

    // 3. AUTO-PLAY LOOP
    function startAutoPlay() {
      isPlaying = true;
      if (playIcon) playIcon.textContent = '⏸';
      if (playText) playText.textContent = 'Пауза';

      let direction = 1;
      let val = scrubSlider ? parseFloat(scrubSlider.value) : 0;

      playInterval = window.setInterval(() => {
        val += direction * 2;
        if (val >= 100) {
          val = 100;
          direction = -1;
        } else if (val <= 0) {
          val = 0;
          direction = 1;
        }
        if (scrubSlider) {
          scrubSlider.value = val.toString();
          updateSimulator(val);
        }
      }, 35);
    }

    function stopAutoPlay() {
      if (playInterval) {
        clearInterval(playInterval);
        playInterval = null;
      }
      isPlaying = false;
      if (playIcon) playIcon.textContent = '▶';
      if (playText) playText.textContent = 'Авто-показ (Play)';
    }

    btnPlayToggle?.addEventListener('click', () => {
      if (isPlaying) {
        stopAutoPlay();
      } else {
        startAutoPlay();
      }
    });

    // Individual card test buttons
    document.querySelectorAll<HTMLButtonElement>('.btn-play-single').forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        const targetCard = document.getElementById(targetId || '');
        if (targetCard) {
          targetCard.classList.toggle('card-collapsed');
        }
      });
    });

    // 4. NAVBAR PULSE
    function triggerNavbarPulse() {
      if (!logoBox) return;
      logoBox.classList.remove('logo-pulse');
      void logoBox.offsetWidth;
      logoBox.classList.add('logo-pulse');
      if (logoRipple) {
        logoRipple.style.opacity = '1';
        setTimeout(() => {
          logoRipple.style.opacity = '0';
        }, 320);
      }
    }

    // 5. NATIVE SCROLL LISTENER (NAVBAR COLLAPSE)
    window.addEventListener('scroll', () => {
      if (window.scrollY > 45) {
        if (!isNavCollapsed) {
          isNavCollapsed = true;
          brandLink?.classList.add('is-collapsed');
          triggerNavbarPulse();
        }
      } else {
        if (isNavCollapsed) {
          isNavCollapsed = false;
          brandLink?.classList.remove('is-collapsed');
          triggerNavbarPulse();
        }
      }
    }, { passive: true });

    // Initial run
    selectVariant('facets');
    updateSimulator(0);
  }

  // Init on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLab);
  } else {
    initLab();
  }
</script>

<script>
  import { createMorphLogo } from '../brand/morphLogo';

  const start = () => {
    const host = document.getElementById('morph-host');
    const name = document.getElementById('morph-name');
    const sub = document.getElementById('morph-sub');
    const bigHost = document.getElementById('morph-big');
    const bigName = document.getElementById('morph-big-name');
    const bigSub = document.getElementById('morph-big-sub');
    const range = document.getElementById('flip-range') as HTMLInputElement | null;
    const tile = document.getElementById('morph-tile');
    const bigTile = document.getElementById('morph-big-tile');
    const val = document.getElementById('flip-val');
    if (!host || !name || !sub) return;
    const logo = createMorphLogo(host, name, { logoCenter: { x: 32, y: 32 }, logoSize: 44 });
    const big = bigHost && bigName ? createMorphLogo(bigHost, bigName, { logoCenter: { x: 70, y: 60 }, logoSize: 96 }) : null;
    const count = document.getElementById('flip-count');
    if (count) count.textContent = `кубиков: в названии ${logo.counts.text}, в логотипе ${logo.counts.logo}`;
    (window as any).__morph = { logo, big };

    const smooth = (a: number, b: number, t: number) => { const k = Math.min(1, Math.max(0, (t - a) / (b - a))); return k * k * (3 - 2 * k); };
    let manual = false;
    const apply = (p: number) => {
      logo.setProgress(p);
      big?.setProgress(p);
      // the crisp text hands over to its voxel copy right at the start; the subtitle fades a bit slower
      const subOp = String(1 - smooth(0, 0.22, p));
      sub.style.opacity = subOp;
      if (bigSub) bigSub.style.opacity = subOp;
      // the dark tile behind the mark grows in while the cubes settle
      const t = smooth(0.55, 0.95, p);
      for (const el of [tile, bigTile]) {
        if (!el) continue;
        el.style.opacity = String(t);
        el.style.transform = `scale(${0.7 + 0.3 * t})`;
      }
      if (range && !manual) range.value = String(Math.round(p * 1000));
      if (val) val.textContent = `${Math.round(p * 100)}%`;
    };
    const fromScroll = () => apply(Math.min(1, window.scrollY / 420));
    window.addEventListener('scroll', () => { manual = false; fromScroll(); }, { passive: true });
    range?.addEventListener('input', () => { manual = true; apply(Number(range.value) / 1000); });
    fromScroll();
  };
  // the voxel copy of the name needs the site font: wait for Nunito
  const go = () => (document.fonts ? document.fonts.load('900 24px Nunito').then(start, start) : start());
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', go);
  else go();
</script>
