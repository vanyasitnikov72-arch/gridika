            <button type="button" class="btn-select-variant px-3 py-1.5 rounded-lg bg-white hover:bg-[#132A22] hover:text-white border border-[#d5cdc2] text-[#132A22] text-xs font-bold transition-colors cursor-pointer" data-variant="vka">
