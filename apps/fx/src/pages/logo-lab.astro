---
import Layout from '../layouts/Layout.astro';
import { gridikaEssence, essenceLevel } from '../brand/gridikaEssence';
import { gridikaMarkSvg, gridikaMark, gridikaLevel, GRIDIKA_PALETTES, MARK_CONCEPTS, MARK_SIZES } from '../brand/gridikaMark';

const SIZES = [160, 96, 64, 44, 32, 28, 20, 16];
const PALETTES = Object.entries(GRIDIKA_PALETTES);
---

<Layout title="Gridika — Интерактивный симулятор логотипа 2.5x">
  {/* FLOATING HEADER UNDER TEST */}
  <div id="old-lab-header" style="display:none" class="fixed top-3 sm:top-5 z-50 w-full px-3 sm:px-6 lg:px-8 pointer-events-none">
    <header
      id="lab-header"
      class="max-w-4xl mx-auto px-3 sm:px-4 h-14 flex items-center justify-between pointer-events-auto rounded-full border border-[#e9e3d7] bg-white/95 backdrop-blur-xl shadow-[0_12px_32px_-10px_rgba(19,42,34,0.18)] transition-all duration-300"
    >
      {/* BRAND LOGO ZONE IN NAVBAR */}
      <a
        href="#"
        id="lab-brand-link"
        class="group flex items-center select-none cursor-pointer overflow-hidden p-1 rounded-2xl hover:bg-black/[0.03] transition-colors mode-facets"
      >
        {/* ICON CONTAINER */}
        <div
          id="lab-logo-box"
          class="relative w-9 h-9 shrink-0 rounded-[12px] bg-[#11231C] border border-[#19C37D]/35 shadow-[0_6px_14px_-3px_rgba(19,42,34,0.45)] flex items-center justify-center overflow-hidden transition-all duration-300 group-hover:scale-105"
        >
          {/* APPROVED HYBRID SVG LOGO: ISOMETRIC V-CUBE + QR FINDERS + 5-DOT SEAM */}
          <svg class="w-6 h-6 transition-all duration-300" viewBox="0 0 32 32" fill="none">
            {/* Wireframe Cube Faces & Edges */}
            <path d="M16 3.5 L28.5 10 L16 16.5 L3.5 10 Z" fill="#132A22" stroke="#19C37D" stroke-width="1.3" stroke-linejoin="round" />
            <path d="M3.5 10 L16 16.5 V29.5 L3.5 23 Z" fill="#0C1B15" stroke="#19C37D" stroke-width="1.3" stroke-linejoin="round" />
            <path d="M28.5 10 L16 16.5 V29.5 L28.5 23 Z" fill="#081410" stroke="#19C37D" stroke-width="1.3" stroke-linejoin="round" />

            {/* Top Face: Diamond QR Finder + 2 Flanking Dots */}
            <path d="M16 6.5 L20.5 9.2 L16 12 L11.5 9.2 Z" stroke="#5BE3A6" stroke-width="1.1" fill="#19C37D" fill-opacity="0.3" stroke-linejoin="round" />
            <circle cx="16" cy="9.2" r="1.1" fill="#8BF0C2" />
            <circle cx="10" cy="8" r="0.9" fill="#19C37D" />
            <circle cx="22" cy="8" r="0.9" fill="#19C37D" />

            {/* Left Face: Square QR Finder + Top Dot */}
            <path d="M6.5 17.5 L12.5 20.5 V25.5 L6.5 22.5 Z" stroke="#5BE3A6" stroke-width="1.1" fill="#19C37D" fill-opacity="0.3" stroke-linejoin="round" />
            <circle cx="9.5" cy="21.5" r="1.1" fill="#8BF0C2" />
            <circle cx="9.5" cy="14.8" r="1.0" fill="#19C37D" />

            {/* Right Face: Square QR Finder + Top Dot */}
            <path d="M25.5 17.5 L19.5 20.5 V25.5 L25.5 22.5 Z" stroke="#5BE3A6" stroke-width="1.1" fill="#19C37D" fill-opacity="0.3" stroke-linejoin="round" />
            <circle cx="22.5" cy="21.5" r="1.1" fill="#8BF0C2" />
            <circle cx="22.5" cy="14.8" r="1.0" fill="#19C37D" />

            {/* Center Front Seam: 5 Glowing Emerald Dots */}
            <circle cx="16" cy="16.5" r="1.4" fill="#8BF0C2" />
            <circle cx="16" cy="19.7" r="1.0" fill="#19C37D" />
            <circle cx="16" cy="23.0" r="1.2" fill="#8BF0C2" />
            <circle cx="16" cy="26.2" r="1.0" fill="#19C37D" />
            <circle cx="16" cy="29.5" r="1.2" fill="#8BF0C2" />
          </svg>

          {/* Ripple pulse inside logo */}
          <span id="logo-ripple" class="absolute inset-0 rounded-[12px] bg-[#19C37D]/30 opacity-0 pointer-events-none transition-opacity duration-300"></span>
        </div>

        {/* ANIMATED LETTERS CONTAINER IN NAVBAR */}
        <div id="brand-text-wrapper" class="flex flex-col leading-none ml-2.5 overflow-visible">
          <div id="word-gridika" class="font-black text-[#132A22] tracking-[-0.03em] text-[17px] flex items-baseline select-none">
            <span class="v-letter inline-block font-black text-[#132A22]">V</span>
            <span class="fly-letter letter-o inline-block text-[#132A22]" style="--idx: 1;">o</span>
            <span class="fly-letter letter-x inline-block text-[#132A22]" style="--idx: 2;">x</span>
            <span class="fly-letter letter-e inline-block text-[#132A22]" style="--idx: 3;">e</span>
            <span class="fly-letter letter-l inline-block text-[#132A22]" style="--idx: 4;">l</span>
            <span class="fly-letter letter-k inline-block text-[#19C37D]" style="--idx: 5;">k</span>
            <span class="fly-letter letter-a inline-block text-[#19C37D]" style="--idx: 6;">a</span>
          </div>
          <span
            id="brand-subtitle"
            class="text-[9.5px] font-bold tracking-[0.14em] uppercase text-[#a8a29e] whitespace-nowrap mt-1 transition-all duration-300 ease-out origin-left"
          >
            3D для сайтов
          </span>
        </div>
      </a>

      {/* CENTER NAV DUMMY TABS */}
      <nav class="hidden sm:flex items-center gap-1 p-1 rounded-full bg-[#f6f3ee] border border-[#ebe5da] text-xs font-bold text-[#6b645c] select-none">
        <a href="#simulator" class="px-3.5 py-1.5 rounded-full bg-white text-[#132A22] shadow-xs">Симулятор 2.5x</a>
        <a href="#variants-section" class="px-3.5 py-1.5 rounded-full hover:text-[#132A22]">4 Варианта</a>
        <a href="#scroll-test" class="px-3.5 py-1.5 rounded-full hover:text-[#132A22]">Тест скролла</a>
      </nav>

      {/* RIGHT ACTION */}
      <div class="flex items-center gap-2 select-none">
        <a
          href="/"
          class="px-4 py-2 rounded-full bg-[#132A22] hover:bg-[#19C37D] text-[#F0EBE9] hover:text-[#132A22] font-extrabold text-xs shadow-md transition-all duration-200 active:scale-95 flex items-center gap-1.5 cursor-pointer"
        >
          <span>На главную</span>
          <svg class="w-3.5 h-3.5 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </header>
  </div>

  {/* FLIP HEADER: mark ↔ word GRIDIKA, driven by scroll */}
  <div class="fixed top-3 sm:top-5 z-50 w-full px-3 sm:px-6 lg:px-8 pointer-events-none">
    <header id="flip-header" class="max-w-5xl mx-auto pl-3 pr-3 sm:pr-4 h-20 flex items-center justify-between pointer-events-auto rounded-[28px] border border-[#e9e3d7] bg-white/95 backdrop-blur-xl shadow-[0_14px_36px_-14px_rgba(19,42,34,0.22)]">
      <a href="#" id="morph-host" class="relative block w-[230px] h-16 select-none" aria-label="Gridika">
        <div id="morph-tile" class="absolute pointer-events-none border border-[#19C37D]/30 shadow-[0_10px_24px_-8px_rgba(12,26,20,0.55),inset_0_1px_0_rgba(255,255,255,0.06)]" style="left:4px;top:4px;width:56px;height:56px;border-radius:16px;background:linear-gradient(145deg,#12261d,#0a1611);opacity:0;transform:scale(0.7);transform-origin:center"></div>
        <div id="morph-text" class="absolute left-1 top-1/2 -translate-y-1/2 flex flex-col leading-none pointer-events-none">
          <span id="morph-name" class="text-[24px] font-black text-[#132A22] tracking-[-0.03em] w-max opacity-0">Grid<span class="text-[#19C37D]">ika</span></span>
          <span id="morph-sub" class="mt-1.5 text-[10px] font-bold tracking-[0.15em] uppercase text-[#a8a29e]">3D для сайтов</span>
        </div>
      </a>
      <nav class="hidden md:flex items-center gap-1 p-1 rounded-full bg-[#f6f3ee] border border-[#ebe5da] text-[13px] font-bold text-[#6b645c]">
        <span class="px-4 py-2 rounded-full bg-white text-[#132A22] shadow-sm">Студия</span>
        <span class="px-4 py-2">Примеры</span>
        <span class="px-4 py-2">Цены</span>
      </nav>
      <span class="h-11 px-5 rounded-full bg-[#132A22] text-white font-extrabold text-sm flex items-center">Создать 3D</span>
    </header>
  </div>

  {/* MAIN CONTENT */}
  <main class="pt-32 pb-32 max-w-4xl mx-auto px-4 sm:px-6">

    {/* ========================================================
        NEW MARK: ISOMETRIC CUBE · DOTTED FRONT EDGE · QR EYES ON THE FACES
        ======================================================== */}
    <section id="flip-test" class="soft-3d-card p-6 sm:p-8 mb-10 bg-white/95 border border-[#e5dfd2] rounded-3xl">
      <span class="px-3 py-1 rounded-full text-[11px] font-black uppercase tracking-wider bg-[#DFF8EB] text-[#132A22] border border-[#19C37D]/25 inline-block mb-1.5">Прототип · шапка</span>
      <h2 class="text-2xl sm:text-3xl font-black text-[#132A22] tracking-tight">Название → логотип</h2>
      <p class="text-sm text-[#6b645c] font-semibold mt-1 max-w-2xl">
        Наверху страницы — название. Прокрутите вниз: буквы рассыпаются на кубики, те разлетаются, поворачиваются и собираются в кубик-логотип; прокрутка вверх — обратно. Превращение растянуто на 420 px прокрутки. Или крутите ползунком.
      </p>
      <div class="mt-5 flex items-center gap-4">
        <input id="flip-range" type="range" min="0" max="1000" value="0" class="flex-1 accent-[#19C37D]" />
        <span id="flip-val" class="w-16 text-right font-mono text-xs font-bold text-[#19C37D]">0%</span>
      </div>
      <div class="mt-4 rounded-3xl bg-[#f6f3ee] border border-[#ebe5da] p-6">
        <div id="morph-big" class="relative w-[420px] h-[120px]">
          <div id="morph-big-tile" class="absolute pointer-events-none border border-[#19C37D]/30 shadow-[0_10px_24px_-8px_rgba(12,26,20,0.55),inset_0_1px_0_rgba(255,255,255,0.06)]" style="left:8px;top:-2px;width:124px;height:124px;border-radius:34px;background:linear-gradient(145deg,#12261d,#0a1611);opacity:0;transform:scale(0.7);transform-origin:center"></div>
          <div class="absolute left-2 top-1/2 -translate-y-1/2 flex flex-col leading-none pointer-events-none" id="morph-big-text">
            <span id="morph-big-name" class="text-[52px] font-black text-[#132A22] tracking-[-0.03em] w-max opacity-0">Grid<span class="text-[#19C37D]">ika</span></span>
            <span id="morph-big-sub" class="mt-2 text-[15px] font-bold tracking-[0.15em] uppercase text-[#a8a29e]">3D для сайтов</span>
          </div>
        </div>
        <span id="flip-count" class="block mt-2 text-[11px] font-mono text-[#a8a29e]"></span>
      </div>
    </section>

    <section id="essence-mark" class="soft-3d-card p-6 sm:p-8 mb-10 bg-white/95 border border-[#e5dfd2] rounded-3xl">
      <span class="px-3 py-1 rounded-full text-[11px] font-black uppercase tracking-wider bg-[#DFF8EB] text-[#132A22] border border-[#19C37D]/25 inline-block mb-1.5">Новый вариант · плоское → объём</span>
      <h2 class="text-2xl sm:text-3xl font-black text-[#132A22] tracking-tight">Gridika: из сетки вырастает объём</h2>
      <p class="text-sm text-[#6b645c] font-semibold mt-1 max-w-2xl">
        Общее у всех продуктов — из плоского собирается 3D. Левая грань — QR: глазок и выдавленные модули (3D QR). Правая — пиксельная G из кубиков (бренд и 3D-логотип). Верхняя — сам принцип: клетки сетки от контура к заливке и к кубикам, растущим к переднему углу. Точки — только на переднем ребре.
      </p>

      <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="rounded-3xl flex items-center justify-center py-8" style={`background:${GRIDIKA_PALETTES.dark.p.bg}`} set:html={gridikaEssence(260, 'dark')} />
        <div class="rounded-3xl border border-[#ebe5da] flex items-center justify-center py-8" style={`background:${GRIDIKA_PALETTES.light.p.bg}`} set:html={gridikaEssence(260, 'light')} />
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-4">
        <div class="h-14 pl-2 pr-5 rounded-full border border-[#e9e3d7] bg-white shadow-[0_10px_30px_-12px_rgba(19,42,34,0.18)] flex items-center gap-2.5">
          <span class="w-10 h-10 rounded-[12px] flex items-center justify-center" style={`background:${GRIDIKA_PALETTES.dark.p.bg}`} set:html={gridikaEssence(34, 'dark')} />
          <span class="flex flex-col leading-none">
            <span class="text-[17px] font-black text-[#132A22] tracking-[-0.03em]">Grid<span class="text-[#19C37D]">ika</span></span>
            <span class="mt-1 text-[9.5px] font-bold tracking-[0.14em] uppercase text-[#a8a29e]">3D для сайтов</span>
          </span>
        </div>
        <div class="h-14 pl-2 pr-5 rounded-full border border-[#e9e3d7] bg-white flex items-center gap-2.5">
          <span class="w-10 h-10 flex items-center justify-center" set:html={gridikaEssence(40, 'light')} />
          <span class="text-[17px] font-black text-[#132A22] tracking-[-0.03em]">Grid<span class="text-[#19C37D]">ika</span></span>
        </div>
        <div class="h-14 pl-2 pr-5 rounded-full bg-[#132A22] flex items-center gap-2.5">
          <span class="w-10 h-10 flex items-center justify-center" set:html={gridikaEssence(40, 'dark')} />
          <span class="text-[17px] font-black text-white tracking-[-0.03em]">Grid<span class="text-[#19C37D]">ika</span></span>
        </div>
        <div class="h-10 pl-3 pr-4 rounded-t-xl bg-[#e9e5de] border border-b-0 border-[#d9d3c7] flex items-center gap-2 self-end">
          <span set:html={gridikaEssence(16, 'dark')} />
          <span class="text-[12px] font-semibold text-[#44403c]">Gridika — 3D для сайтов</span>
        </div>
      </div>

      <div class="mt-6 rounded-3xl p-5 flex items-end gap-6 flex-wrap" style={`background:${GRIDIKA_PALETTES.dark.p.bg}`}>
        {SIZES.map((sz) => (
          <div class="flex flex-col items-center gap-2">
            <span set:html={gridikaEssence(sz, 'dark')} />
            <span class="text-[10px] font-mono text-white/50">{sz}px · {essenceLevel(sz)}</span>
          </div>
        ))}
      </div>

      <div class="mt-6 grid grid-cols-2 sm:grid-cols-5 gap-3">
        {PALETTES.map(([id, v]) => (
          <figure class="rounded-2xl border border-[#ebe5da] overflow-hidden">
            <div class="flex items-center justify-center gap-3 py-6" style={`background:${v.p.bg}`}>
              <span set:html={gridikaEssence(96, id as any)} />
              <span set:html={gridikaEssence(34, id as any)} />
            </div>
            <figcaption class="px-3 py-2 text-[11px] font-bold text-[#57534e] leading-snug">{v.title}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section id="new-mark" class="soft-3d-card p-6 sm:p-8 mb-10 bg-white/95 border border-[#e5dfd2] rounded-3xl">
      <span class="px-3 py-1 rounded-full text-[11px] font-black uppercase tracking-wider bg-[#DFF8EB] text-[#132A22] border border-[#19C37D]/25 inline-block mb-1.5">Выбранный знак · точечный QR</span>
      <h2 class="text-2xl sm:text-3xl font-black text-[#132A22] tracking-tight">Gridika: кубик из точечного QR</h2>
      <p class="text-sm text-[#6b645c] font-semibold mt-1 max-w-2xl">
        Переднее ребро — столбик точек (по точке на концах, между ними поровну), контур к нему не касается. Скруглённые глазки QR внизу боковых граней и сверху соединены дорожками-таймингом через верх. Грани заполнены точками-модулями, которые редеют к ребру. Детализация подбирается по размеру сама: L — от 96 px, M — от 28 px, S — меньше.
      </p>

      {/* hero: dark and light */}
      <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="rounded-3xl flex items-center justify-center py-10" style={`background:${GRIDIKA_PALETTES.dark.p.bg}`} set:html={gridikaMark(240, 'dark')} />
        <div class="rounded-3xl border border-[#ebe5da] flex items-center justify-center py-10" style={`background:${GRIDIKA_PALETTES.light.p.bg}`} set:html={gridikaMark(240, 'light')} />
      </div>

      {/* in the header, next to the word */}
      <div class="mt-6 flex flex-wrap items-center gap-4">
        <div class="h-14 pl-2 pr-5 rounded-full border border-[#e9e3d7] bg-white shadow-[0_10px_30px_-12px_rgba(19,42,34,0.18)] flex items-center gap-2.5">
          <span class="w-10 h-10 rounded-[12px] flex items-center justify-center" style={`background:${GRIDIKA_PALETTES.dark.p.bg}`} set:html={gridikaMark(32, 'dark')} />
          <span class="flex flex-col leading-none">
            <span class="text-[17px] font-black text-[#132A22] tracking-[-0.03em]">Grid<span class="text-[#19C37D]">ika</span></span>
            <span class="mt-1 text-[9.5px] font-bold tracking-[0.14em] uppercase text-[#a8a29e]">3D для сайтов</span>
          </span>
        </div>
        <div class="h-14 pl-2 pr-5 rounded-full border border-[#e9e3d7] bg-white flex items-center gap-2.5">
          <span class="w-10 h-10 flex items-center justify-center" set:html={gridikaMark(38, 'light')} />
          <span class="text-[17px] font-black text-[#132A22] tracking-[-0.03em]">Grid<span class="text-[#19C37D]">ika</span></span>
        </div>
        <div class="h-14 pl-2 pr-5 rounded-full bg-[#132A22] flex items-center gap-2.5">
          <span class="w-10 h-10 flex items-center justify-center" set:html={gridikaMark(38, 'dark')} />
          <span class="text-[17px] font-black text-white tracking-[-0.03em]">Grid<span class="text-[#19C37D]">ika</span></span>
        </div>
        {/* browser tab */}
        <div class="h-10 pl-3 pr-4 rounded-t-xl bg-[#e9e5de] border border-b-0 border-[#d9d3c7] flex items-center gap-2 self-end">
          <span set:html={gridikaMark(16, 'dark')} />
          <span class="text-[12px] font-semibold text-[#44403c]">Gridika — 3D для сайтов</span>
        </div>
      </div>

      {/* size ramp with the automatic level */}
      <div class="mt-6 rounded-3xl p-5 flex items-end gap-6 flex-wrap" style={`background:${GRIDIKA_PALETTES.dark.p.bg}`}>
        {SIZES.map((sz) => (
          <div class="flex flex-col items-center gap-2">
            <span set:html={gridikaMark(sz, 'dark')} />
            <span class="text-[10px] font-mono text-white/50">{sz}px · {gridikaLevel(sz)}</span>
          </div>
        ))}
      </div>

      {/* colour versions */}
      <div class="mt-6 grid grid-cols-2 sm:grid-cols-5 gap-3">
        {PALETTES.map(([id, v]) => (
          <figure class="rounded-2xl border border-[#ebe5da] overflow-hidden">
            <div class="flex items-center justify-center gap-3 py-6" style={`background:${v.p.bg}`}>
              <span set:html={gridikaMark(96, id as any)} />
              <span set:html={gridikaMark(32, id as any)} />
            </div>
            <figcaption class="px-3 py-2 text-[11px] font-bold text-[#57534e] leading-snug">{v.title}</figcaption>
          </figure>
        ))}
      </div>

      {/* ===== directions for the faces ===== */}
      <h3 class="mt-10 text-xl font-black text-[#132A22]">Направления (выбрано B)</h3>
      <div class="mt-4 grid grid-cols-1 md:grid-cols-3 gap-4">
        {MARK_CONCEPTS.map((c) => (
          <figure class="rounded-3xl border border-[#ebe5da] overflow-hidden bg-white">
            <div class="bg-[#0c1a14] flex items-center justify-center py-6" set:html={gridikaMarkSvg(c.opts, 200)} />
            <figcaption class="p-4">
              <div class="text-[15px] font-black text-[#132A22]">{c.title}</div>
              <p class="mt-1 text-[12px] font-semibold text-[#6b645c] leading-relaxed">{c.text}</p>
              <div class="mt-3 flex items-center gap-3">
                <span class="w-9 h-9 rounded-[12px] bg-[#0c1a14] flex items-center justify-center" set:html={gridikaMarkSvg(c.opts, 30)} />
                <span class="text-[11px] font-bold text-[#a8a29e]">так в шапке (30 px)</span>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>

      {/* ===== size system ===== */}
      <h3 class="mt-10 text-xl font-black text-[#132A22]">D. Система размеров</h3>
      <p class="mt-1 text-sm text-[#6b645c] font-semibold max-w-2xl">Один знак в трёх степенях детализации: крупно — с модулями данных, в шапке — глазки и дорожки, в значке вкладки — только куб, глазки и 4 крупные точки на ребре.</p>
      <div class="mt-4 rounded-3xl bg-[#0c1a14] p-6 flex flex-wrap items-end gap-10">
        {MARK_SIZES.map((m) => (
          <div class="flex flex-col items-center gap-3">
            <span set:html={gridikaMarkSvg(m.opts, m.px)} />
            <span class="text-[11px] font-bold text-white/60 text-center">{m.title}<br />{m.px}px</span>
          </div>
        ))}
        <div class="flex flex-col items-center gap-3">
          <span class="flex items-end gap-3">
            <span set:html={gridikaMarkSvg(MARK_SIZES[1].opts, 16)} />
