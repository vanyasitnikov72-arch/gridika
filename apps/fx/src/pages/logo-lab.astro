          <div class="w-10 h-10 rounded-xl bg-[#DFF8EB] text-[#132A22] font-black text-sm flex items-center justify-center shadow-inner">
            {idx}
          </div>
        </div>
      ))}
    </div>

  </main>
</Layout>

