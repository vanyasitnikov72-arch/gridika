                    <span class="g-x text-[#132A22] transition-all" style="--d: 2;">x</span>
                    <span class="g-e text-[#132A22] transition-all" style="--d: 3;">e</span>
                    <span class="g-l text-[#132A22] transition-all" style="--d: 4;">l</span>
                    <span class="g-k text-[#19C37D] transition-all" style="--d: 5;">k</span>
                    <span class="g-a text-[#19C37D] transition-all" style="--d: 6;">a</span>
                  </div>
                  <span class="sub text-[8.5px] font-bold tracking-[0.14em] uppercase text-[#a8a29e] mt-1">3D для сайтов</span>
