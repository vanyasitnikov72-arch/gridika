---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { QrConfigurator } from '../components/QrConfigurator';
import InstallSteps from '../components/sections/InstallSteps.astro';
import WidgetCrossLinks from '../components/sections/WidgetCrossLinks.astro';

const pageTitle = "3D QR-код для сайта — интерактивный генератор и виджет | Gridika";
const pageDesc = "Интерактивный 3D QR-код для Tilda, WordPress и Webflow: превращается в дерево, мегаполис, остров или замок. 100% сканируется смартфоном. Установка за минуту без кода.";
const canonicalUrl = "https://gridika.ru/3d-qr-code/";

const faqItems = [
  {
    q: "QR-код точно будет сканироваться со смартфона?",
    a: "Да, гарантированно на 100%. Когда камера поворачивается сверху, все декоративные 3D-детали скрываются, а модули QR-кода выравниваются по контрасту. Студия автоматически проверяет считываемость сканером jsQR перед выдачей кода.",
  },
  {
    q: "Как вставить 3D QR-код на сайт (например, на Tilda)?",
    a: "В Tilda добавьте стандартный блок T123 («HTML-код») и вставьте скопированный код. В WordPress используйте блок «Произвольный HTML», в Webflow — компонент «Embed». Код полностью автономен и не требует настройки серверов.",
  },
  {
    q: "Не замедлит ли 3D-сцена загрузку страницы?",
    a: "Нет. Скрипт компактный, Three.js загружается с быстрого CDN (около 150 КБ в сжатом виде), а трёхмерный рендеринг засыпает, когда блок находится вне экрана пользователя, не расходуя батарею и ресурсы процессора.",
  },
  {
    q: "Можно ли изменить ссылку после покупки?",
    a: "Да. Сама ссылка лежит в коде обычным текстом в кавычках — вы можете заменить её в любой момент в обычном блокноте через Ctrl+F.",
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Главная',
        item: 'https://gridika.ru/',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: '3D QR-код',
        item: canonicalUrl,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Интерактивный 3D QR-код Gridika',
    description: pageDesc,
    image: 'https://gridika.ru/web-app-manifest-512x512.png',
    offers: {
      '@type': 'Offer',
      price: '1490',
      priceCurrency: 'RUB',
      availability: 'https://schema.org/InStock',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a,
      },
    })),
  },
];
---

<Layout
  title={pageTitle}
  description={pageDesc}
  canonicalUrl={canonicalUrl}
  structuredData={structuredData}
>
  <Navbar />

  <main class="flex-1 pb-20 relative overflow-hidden">
    {/* HERO HEADER */}
    <section class="pt-6 pb-6 sm:pt-8 md:pt-10 md:pb-8 max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#DFF8EB] text-[#0f5c3c] text-[12px] font-extrabold mb-3 shadow-xs">
        <span>Интерактивный 3D-эффект #01</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-[#132A22] tracking-tight leading-[1.1]">
        Интерактивный 3D QR-код для любого сайта
      </h1>
      <p class="mt-3.5 text-base sm:text-lg text-[#6b645c] font-semibold max-w-2xl mx-auto leading-relaxed">
        Превратите обычный плоский QR-код в живую трёхмерную воксельную сцену. 100% считываемость камерой, вращение за курсором и установка за 1 минуту без программиста.
      </p>
    </section>

    {/* INTERACTIVE STUDIO */}
    <section id="studio" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-12 scroll-mt-24">
      <QrConfigurator client:load initialProduct="qr-morph" />
    </section>

    {/* INSTALLATION STEPS */}
    <InstallSteps />

    {/* FAQ SECTION */}
    <section class="py-14 max-w-4xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-8">
        <h2 class="text-2xl sm:text-3xl font-black text-[#132A22]">
          Частые вопросы о 3D QR-коде
        </h2>
      </div>
      <div class="space-y-3.5">
        {faqItems.map((item) => (
          <details class="group bg-white rounded-2xl border border-[#ece6da] p-5 shadow-xs transition-all [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between font-extrabold text-[#132A22] text-base cursor-pointer list-none">
              <span>{item.q}</span>
              <span class="w-7 h-7 rounded-full bg-[#f6f3ee] flex items-center justify-center text-sm group-open:rotate-180 transition-transform">
                ↓
              </span>
            </summary>
            <p class="mt-3 text-sm text-[#6b645c] font-semibold leading-relaxed">
              {item.a}
            </p>
          </details>
        ))}
      </div>
    </section>

    {/* CROSS LINKS */}
    <WidgetCrossLinks currentPath={canonicalUrl} />
  </main>

  <Footer />
</Layout>
