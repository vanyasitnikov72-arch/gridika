---
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  noindex?: boolean;
  canonicalUrl?: string;
  ogType?: 'website' | 'article' | 'product';
  ogImage?: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const { 
  title, 
  description = "Готовые интерактивные 3D-эффекты и виджеты для Tilda, WordPress, Webflow, Wix и любого сайта. 3D QR-код, визитка, подарок с промокодом, воксели. Установка за минуту без программиста.",
  keywords = "3d эффекты для сайта, 3d qr код, виджеты для тильды, интерактивные виджеты, 3d для tilda, 3d для wordpress, webflow 3d, voxel logo, qr визитка 3d, 3d виджеты",
  noindex = false,
  canonicalUrl,
  ogType = 'website',
  ogImage = 'https://gridika.ru/gridika-avatar.png',
  structuredData
} = Astro.props;

const siteUrl = 'https://gridika.ru';
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const computedCanonical = canonicalUrl || (currentPath === '/' ? siteUrl : `${siteUrl}${currentPath}`);
---

<!doctype html>
<html lang="ru" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Gridika" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="canonical" href={computedCanonical} />

    {/* Search Engine Robots Directives */}
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <>
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
        <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
        <meta name="yandex" content="index, follow" />
      </>
    )}

    {/* Regional & Language Meta */}
    <meta name="geo.region" content="RU" />
    <meta name="geo.placename" content="Россия" />
    <meta name="theme-color" content="#F0EBE9" />

    {/* Favicon & Web App Icons */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/png" href="/gridika-avatar.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* Open Graph / Telegram / VK / Facebook */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Gridika" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={computedCanonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content="Gridika — 3D-эффекты для любого сайта" />
    <meta property="og:locale" content="ru_RU" />

    {/* Twitter / X Cards */}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Fonts */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    {/* Schema.org Structured Data (JSON-LD) */}
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
  </head>
  <body class="bg-[#F0EBE9] text-[#132A22] font-sans antialiased selection:bg-[var(--vx-accent)] selection:text-white min-h-screen flex flex-col relative overflow-x-hidden">
    {/* WARM CREAMY AMBIENT DEPTH (Reference: Sofa Cake warm aesthetic) */}
    <div class="fixed inset-0 pointer-events-none overflow-hidden -z-10">
      {/* Top Left: Soft Mint Foam tint */}
      <div class="absolute -top-32 -left-32 w-[600px] h-[600px] rounded-full bg-[#DFF8EB]/60 blur-[130px] transform-gpu"></div>
      
      {/* Top Right: Warm Peach/Caramel tint */}
      <div class="absolute top-10 right-0 w-[550px] h-[550px] rounded-full bg-orange-100/35 blur-[140px] transform-gpu"></div>
      
      {/* Mid Page: Soft Buttercream warm orb */}
      <div class="absolute top-[40%] left-1/3 w-[700px] h-[600px] rounded-full bg-amber-50/50 blur-[160px] transform-gpu"></div>

      {/* Subtle tactile grid */}
      <div class="absolute inset-0 bg-[radial-gradient(#e5dfd2_1px,transparent_1px)] [background-size:28px_28px] opacity-40"></div>
    </div>

    <slot />
    <CookieBanner />
  </body>
</html>

<style is:global>
  /* Product accent: set by the studio (applyProductTheme), animated page-wide */
  @property --vx-accent { syntax: '<color>'; inherits: true; initial-value: #19C37D; }
  @property --vx-deep { syntax: '<color>'; inherits: true; initial-value: #132A22; }
  @property --vx-on { syntax: '<color>'; inherits: true; initial-value: #132A22; }
  @property --vx-soft { syntax: '<color>'; inherits: true; initial-value: #DFF8EB; }
  :root {
    --vx-accent: #19C37D;
    --vx-deep: #132A22;
    --vx-on: #132A22;
    --vx-soft: #DFF8EB;
    transition: --vx-accent 0.4s ease, --vx-deep 0.4s ease, --vx-on 0.4s ease, --vx-soft 0.4s ease;
  }

  body {
    font-family: 'Nunito', system-ui, -apple-system, sans-serif;
    letter-spacing: -0.015em;
  }

  /* SOFT 3D TACTILE STYLES (Sofa Cake Reference) */
  .soft-3d-card {
    background-color: #ffffff;
    border-radius: 2.25rem;
    box-shadow: 
      0 20px 48px -12px rgba(85, 70, 50, 0.07),
      0 4px 12px -2px rgba(85, 70, 50, 0.03),
      inset 0 1px 1px 0 rgba(255, 255, 255, 1);
    border: 1px solid rgba(228, 222, 208, 0.85);
  }

  .soft-3d-card-cream {
    background-color: #eee9de;
    border-radius: 2.25rem;
    box-shadow: 
      0 16px 36px -8px rgba(85, 70, 50, 0.06),
      inset 0 1px 2px 0 rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(220, 212, 196, 0.9);
  }

  .soft-3d-card-emerald {
    background: linear-gradient(145deg, #19C37D 0%, #132A22 100%);
    color: #F0EBE9;
    border-radius: 2.25rem;
    box-shadow: 
      0 20px 48px -10px rgba(19, 42, 34, 0.35),
      inset 0 1px 1px 0 rgba(255, 255, 255, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .soft-3d-card-mint {
    background-color: #19C37D;
    color: #132A22;
    border-radius: 2.25rem;
    box-shadow: 
      0 20px 48px -10px rgba(25, 195, 125, 0.28),
      inset 0 1px 1px 0 rgba(255, 255, 255, 0.4);
    border: 1px solid rgba(25, 195, 125, 0.3);
  }

  .soft-3d-card-pine {
    background-color: var(--vx-deep);
    color: #F0EBE9;
    border-radius: 2.25rem;
    box-shadow: 
      0 20px 48px -10px rgba(19, 42, 34, 0.45),
      inset 0 1px 1px 0 rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  /* Tactile Soft 3D Pill Elements */
  .soft-3d-pill {
    background-color: #ffffff;
    border-radius: 9999px;
    box-shadow: 
      0 4px 14px rgba(85, 70, 50, 0.06),
      0 1px 2px rgba(85, 70, 50, 0.04),
      inset 0 -2px 0 rgba(0, 0, 0, 0.03);
    border: 1px solid rgba(228, 222, 208, 0.9);
  }

  .soft-3d-dock {
    background-color: #ffffff;
    border-radius: 9999px;
    box-shadow: 
      0 12px 30px -4px rgba(85, 70, 50, 0.1),
      0 4px 8px -2px rgba(85, 70, 50, 0.05),
      inset 0 1px 1px 0 rgba(255, 255, 255, 1);
    border: 1px solid rgba(225, 218, 202, 0.9);
  }

  /* Butter-smooth Studio & Catalog transitions */
  @keyframes fxFadeScaleIn {
    0% {
      opacity: 0;
      transform: scale(0.97) translateY(6px);
    }
    100% {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  @keyframes fxCardPopIn {
    0% {
      opacity: 0;
      transform: translateY(10px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .fx-fade-in {
    animation: fxFadeScaleIn 0.32s cubic-bezier(0.16, 1, 0.3, 1) both;
    will-change: transform, opacity;
  }

  .fx-card-pop {
    animation: fxCardPopIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) both;
    will-change: transform, opacity;
  }

  /* Hide scrollbar utility */
  .no-scrollbar::-webkit-scrollbar {
    display: none !important;
    width: 0 !important;
    height: 0 !important;
  }
  .no-scrollbar {
    -ms-overflow-style: none !important;
    scrollbar-width: none !important;
  }

  /* Scrollbar */
  ::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  ::-webkit-scrollbar-track {
    background: #F0EBE9;
  }
  ::-webkit-scrollbar-thumb {
    background: #d8d1c2;
    border-radius: 9999px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #b8b09f;
  }
</style>
