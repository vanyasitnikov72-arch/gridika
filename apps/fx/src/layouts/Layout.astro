---
interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "Витрина готовых интерактивных 3D эффектов для Tilda и веб-сайтов. Установка за 1 минуту без кода." 
} = Astro.props;
---

<!doctype html>
<html lang="ru" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32' fill='%2319C37D'><rect width='32' height='32' rx='8' fill='%2319C37D'/><circle cx='16' cy='16' r='6' fill='white'/></svg>" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F0EBE9" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#F0EBE9] text-[#132A22] font-sans antialiased selection:bg-[#19C37D] selection:text-white min-h-screen flex flex-col relative overflow-x-hidden">
    {/* WARM CREAMY AMBIENT DEPTH (Reference: Sofa Cake warm aesthetic) */}
    <div class="fixed inset-0 pointer-events-none overflow-hidden -z-10">
      {/* Top Left: Soft Mint Foam tint */}
      <div class="absolute -top-32 -left-32 w-[600px] h-[600px] rounded-full bg-[#DFF8EB]/60 blur-[130px] transform-gpu"></div>
      
      {/* Top Right: Warm Peach/Caramel tint */}
      <div class="absolute top-10 right-0 w-[550px] h-[550px] rounded-full bg-orange-100/35 blur-[140px] transform-gpu"></div>
      
      {/* Mid Page: Soft Buttercream warm orb */}
      <div class="absolute top-[40%] left-1/3 w-[700px] h-[600px] rounded-full bg-amber-50/50 blur-[160px] transform-gpu"></div>

      {/* Subtle tactile grid */}
      <div class="absolute inset-0 bg-[radial-gradient(#e5dfd2_1px,transparent_1px)] [background-size:28px_28px] opacity-40"></div>
    </div>

    <slot />
  </body>
</html>

<style is:global>
  body {
    font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    letter-spacing: -0.015em;
  }

  /* SOFT 3D TACTILE STYLES (Sofa Cake Reference) */
  .soft-3d-card {
    background-color: #ffffff;
    border-radius: 2.25rem;
    box-shadow: 
      0 20px 48px -12px rgba(85, 70, 50, 0.07),
      0 4px 12px -2px rgba(85, 70, 50, 0.03),
      inset 0 1px 1px 0 rgba(255, 255, 255, 1);
    border: 1px solid rgba(228, 222, 208, 0.85);
  }

  .soft-3d-card-cream {
    background-color: #eee9de;
    border-radius: 2.25rem;
    box-shadow: 
      0 16px 36px -8px rgba(85, 70, 50, 0.06),
      inset 0 1px 2px 0 rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(220, 212, 196, 0.9);
  }

  .soft-3d-card-emerald {
    background: linear-gradient(145deg, #19C37D 0%, #132A22 100%);
    color: #F0EBE9;
    border-radius: 2.25rem;
    box-shadow: 
      0 20px 48px -10px rgba(19, 42, 34, 0.35),
      inset 0 1px 1px 0 rgba(255, 255, 255, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .soft-3d-card-mint {
    background-color: #19C37D;
    color: #132A22;
    border-radius: 2.25rem;
    box-shadow: 
      0 20px 48px -10px rgba(25, 195, 125, 0.28),
      inset 0 1px 1px 0 rgba(255, 255, 255, 0.4);
    border: 1px solid rgba(25, 195, 125, 0.3);
  }

  .soft-3d-card-pine {
    background-color: #132A22;
    color: #F0EBE9;
    border-radius: 2.25rem;
    box-shadow: 
      0 20px 48px -10px rgba(19, 42, 34, 0.45),
      inset 0 1px 1px 0 rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  /* Tactile Soft 3D Pill Elements */
  .soft-3d-pill {
    background-color: #ffffff;
    border-radius: 9999px;
    box-shadow: 
      0 4px 14px rgba(85, 70, 50, 0.06),
      0 1px 2px rgba(85, 70, 50, 0.04),
      inset 0 -2px 0 rgba(0, 0, 0, 0.03);
    border: 1px solid rgba(228, 222, 208, 0.9);
  }

  .soft-3d-dock {
    background-color: #ffffff;
    border-radius: 9999px;
    box-shadow: 
      0 12px 30px -4px rgba(85, 70, 50, 0.1),
      0 4px 8px -2px rgba(85, 70, 50, 0.05),
      inset 0 1px 1px 0 rgba(255, 255, 255, 1);
    border: 1px solid rgba(225, 218, 202, 0.9);
  }

  /* Butter-smooth Studio & Catalog transitions */
  @keyframes fxFadeScaleIn {
    0% {
      opacity: 0;
      transform: scale(0.97) translateY(6px);
    }
    100% {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  @keyframes fxCardPopIn {
    0% {
      opacity: 0;
      transform: translateY(10px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .fx-fade-in {
    animation: fxFadeScaleIn 0.32s cubic-bezier(0.16, 1, 0.3, 1) both;
    will-change: transform, opacity;
  }

  .fx-card-pop {
    animation: fxCardPopIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) both;
    will-change: transform, opacity;
  }

  /* Scrollbar */
  ::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  ::-webkit-scrollbar-track {
    background: #F0EBE9;
  }
  ::-webkit-scrollbar-thumb {
    background: #d8d1c2;
    border-radius: 9999px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #b8b09f;
  }
</style>
